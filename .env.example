PORT=3000
NODE_ENV=production
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=seu_usuario_hostinger
DB_PASSWORD=sua_senha_hostinger
DB_NAME=seu_banco_hostinger
SESSION_SECRET=coloque_uma_chave_segura_aqui

# --- Operacao / negocio ---
# E-mails (separados por virgula) que viram administradores ao iniciar. Recebem aviso de pedidos de plano.
ADMIN_EMAILS=seu@email.com
APP_NAME=MyFinance
SUPPORT_EMAIL=suporte@seudominio.com
# SMTP (necessario para e-mails de verificacao e recuperacao de senha; sem isso so aparecem no log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MyFinance <noreply@seudominio.com>"

# --- Chat IA (Claude) ---
# Chave da API da Anthropic (console.anthropic.com). Sem ela o Chat IA mostra que nao esta configurado.
ANTHROPIC_API_KEY=
# Opcionais: modelo (padrao claude-sonnet-5-5) e limite de mensagens por usuario por mes (padrao 300)
IA_MODELO=claude-sonnet-5-5
IA_LIMITE_MENSAGENS_MES=300
