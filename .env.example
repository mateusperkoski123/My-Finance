PORT=3000
NODE_ENV=production
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=seu_usuario_hostinger
DB_PASSWORD=sua_senha_hostinger
DB_NAME=seu_banco_hostinger
SESSION_SECRET=coloque_uma_chave_segura_aqui

# --- Operacao / negocio ---
# E-mails (separados por virgula) que viram administradores ao iniciar. Recebem aviso de pedidos de plano.
ADMIN_EMAILS=seu@email.com
APP_NAME=MyFinance
SUPPORT_EMAIL=suporte@seudominio.com
# SMTP (necessario para e-mails de verificacao e recuperacao de senha; sem isso so aparecem no log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MyFinance <noreply@seudominio.com>"

# --- Chat IA (Claude) ---
# Chave da API da Anthropic (console.anthropic.com). Sem ela o Chat IA mostra que nao esta configurado.
ANTHROPIC_API_KEY=
# Opcionais: modelo (padrao claude-sonnet-5-5) e limite de mensagens por usuario por mes (padrao 300)
IA_MODELO=claude-sonnet-5-5
IA_LIMITE_MENSAGENS_MES=300

# --- Chat IA: audio (transcricao) ---
# A API da Claude nao recebe audio. A transcricao usa o Gemini (recomendado: camada gratuita, chave em aistudio.google.com/apikey) ou a OpenAI.
# Sem nenhuma das chaves, o botao de audio avisa que nao esta configurado. STT_PROVIDER=gemini|openai forca um provedor (padrao: o que tiver chave, Gemini primeiro).
GEMINI_API_KEY=
GEMINI_STT_MODELO=gemini-3.8-flash
# STT_PROVIDER=gemini
OPENAI_API_KEY=
# Opcionais: modelo de transcricao (padrao gpt-4o-mini-transcribe), preco por minuto para estimar custo, e fuso do "dia de uso"
STT_MODELO=gpt-4o-mini-transcribe
# STT_PRECO_MINUTO=0.003
# IA_TIMEZONE=America/Asuncion

# --- Lembretes de vencimento (Web Push) ---
# Gere o par de chaves UMA vez com: npx web-push generate-vapid-keys  (nao troque depois: invalida as inscricoes)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@seudominio.com
# Financeiro (cobrancas por inatividade): vazio = liberado para todos, novos aparelhos entram ligados; admins = so admins (teste).
FINANCEIRO_LIBERADO=
# Segredo do cron externo que chama /cron/lembretes a cada 30 minutos (header x-cron-token ou ?token=)
CRON_TOKEN=

# --- Pagamento de planos (Pagopar) ---
# Chaves em pagopar.com > Desenvolvedor. Vazio = desligado (a contratacao segue pelo pedido manual).
# No painel do Pagopar configure: URL de redirecionamento = https://SEU_DOMINIO/assinatura/pagopar/retorno/($hash)
#                                 URL de resposta         = https://SEU_DOMINIO/pagopar/resposta
PAGOPAR_PUBLIC_KEY=
PAGOPAR_PRIVATE_KEY=
