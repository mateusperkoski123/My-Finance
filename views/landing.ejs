        // Idioma Engine
        const langSelect = document.getElementById('lang-toggle');
        // Sem escolha anterior, abre no idioma do navegador (es -> espanhol, en -> ingles, o resto -> portugues).
        function idiomaDoNavegador() {
            const prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
            for (const l of prefs) {
                const c = String(l).toLowerCase();
                if (c.startsWith('es')) return 'es-PY';
                if (c.startsWith('pt')) return 'pt-BR';
                if (c.startsWith('en')) return 'en-US';
            }
            return 'pt-BR';
        }
        const chaveIdioma = (l) => (String(l).toLowerCase().startsWith('es') ? 'es' : (String(l).toLowerCase().startsWith('en') ? 'en' : 'pt'));
        const PRERENDER = document.documentElement.hasAttribute('data-prerender');
        let idiomaSalvo = null;
        try { idiomaSalvo = localStorage.getItem('gf_idioma'); } catch (e) {}

        if (PRERENDER) {
            // Pagina estatica: o HTML ja vem traduzido (bom para buscadores). O seletor leva para a URL do idioma.
            const paginaLang = document.documentElement.lang;
            const valorPagina = { pt: 'pt-BR', es: 'es-PY', en: 'en-US' }[chaveIdioma(paginaLang)];
            langSelect.value = valorPagina;
            langSelect.addEventListener('change', (e) => {
                try { localStorage.setItem('gf_idioma', e.target.value); } catch (err) {}
                location.href = e.target.selectedOptions[0].getAttribute('data-href');
            });
            // Somente a pagina raiz (x-default) escolhe sozinha o idioma; buscadores nunca sao redirecionados.
            const robo = /bot|crawl|spider|slurp|bing|duckduck|facebookexternalhit|whatsapp|telegram|linkedin|twitter/i.test(navigator.userAgent);
            if (document.documentElement.hasAttribute('data-raiz') && !robo) {
                const alvo = TRANSLATIONS[idiomaSalvo] || idiomaSalvo === 'pt-BR' || idiomaSalvo === 'es-PY' || idiomaSalvo === 'en-US' ? idiomaSalvo : idiomaDoNavegador();
                const opt = Array.prototype.find.call(langSelect.options, (o) => o.value === alvo);
                if (opt && opt.value !== valorPagina && opt.getAttribute('data-href')) location.replace(opt.getAttribute('data-href'));
            }
            atualizarCobrancas(paginaLang);
        } else {
            if (!TRANSLATIONS[idiomaSalvo]) idiomaSalvo = idiomaDoNavegador();
            langSelect.value = idiomaSalvo;
            aplicarIdioma(idiomaSalvo);

            langSelect.addEventListener('change', (e) => {
                const lang = e.target.value;
                try { localStorage.setItem('gf_idioma', lang); } catch (err) {}
                aplicarIdioma(lang);
            });
        }

        function aplicarIdioma(lang) {
            const dict = TRANSLATIONS[lang] || TRANSLATIONS['pt-BR'];
            document.documentElement.lang = lang;
            
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (dict[key]) {
                    el.innerHTML = dict[key];
                }
            });

            // Atualiza cobranca
            atualizarCobrancas(lang);
        }

        function atualizarCobrancas(lang) {
            const cicloBtn = document.querySelector('.planos-ciclo button.is-ativo');
            const ciclo = cicloBtn ? cicloBtn.getAttribute('data-ciclo') : 'mensal';
            const langKey = chaveIdioma(lang);

            document.querySelectorAll('.plano-cobranca').forEach(el => {
                const texto = el.getAttribute('data-cobranca-' + ciclo + '-' + langKey);
                if (texto) el.textContent = texto;
            });
        }

        // Tema Toggle (Claro / Escuro)
        const temaBtn = document.getElementById('tema-toggle');
        const html = document.documentElement;
        
        const temaSalvo = html.getAttribute('data-tema') || 'claro';
        atualizarIconeTema(temaSalvo);

        temaBtn.addEventListener('click', () => {
            const temaAtual = html.getAttribute('data-tema');
            const novoTema = temaAtual === 'claro' ? 'escuro' : 'claro';
            html.setAttribute('data-tema', novoTema);
            try { localStorage.setItem('gf_tema', novoTema); } catch (err) {}
            atualizarIconeTema(novoTema);
        });

        function atualizarIconeTema(tema) {
            temaBtn.innerHTML = tema === 'claro' ? '<i class="ph ph-moon"></i>' : '<i class="ph ph-sun"></i>';
        }

        // Alternância Ciclo de Preços (Mensal / Anual)
        document.querySelectorAll('.planos-ciclo button').forEach(btn => {
            btn.addEventListener('click', () => {
                const ciclo = btn.getAttribute('data-ciclo');
                document.querySelectorAll('.planos-ciclo button').forEach(b => b.classList.toggle('is-ativo', b === btn));
                
                // Preços
                document.querySelectorAll('.preco-val').forEach(el => {
                    el.textContent = el.getAttribute('data-' + ciclo);
                });

                // Cobranças no idioma atual
                const curLang = langSelect.value || 'pt-BR';
                atualizarCobrancas(curLang);
            });
        });

        // FAQ Accordion
        document.querySelectorAll('.faq-question').forEach(q => {
            q.addEventListener('click', () => {
                const item = q.parentElement;
                q.setAttribute('aria-expanded', item.classList.toggle('is-open') ? 'true' : 'false');
            });
        });
    </script>

