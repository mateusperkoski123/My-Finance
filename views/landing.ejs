<!DOCTYPE html>
<html lang="pt-BR" data-tema="claro" class="scroll-smooth">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <script>
        /* Tema antes da pintura (evita piscar): escolha salva ou preferencia do sistema. */
        try { var t = localStorage.getItem('gf_tema') || (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'escuro' : 'claro'); document.documentElement.setAttribute('data-tema', t); } catch (e) {}
    </script>
    <title id="meta-title">MyFinance: controle financeiro com IA para contas e parcelas</title>
    <meta name="description" content="Organize contas, parcelas e gastos num só lugar. A IA registra por texto, foto ou voz. Teste grátis por 3 dias, sem cartão. Para Gs., R$, US$ e €.">
    <link rel="canonical" href="https://myfinance.systempy.com/">
    <meta name="robots" content="index, follow, max-image-preview:large">
    <meta name="theme-color" content="#4338ca">
    <link rel="icon" type="image/png" href="/assets/icons/icon-192.png">
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    
    <style>
        :root[data-tema="claro"] {
            --bg: #f5f6f8;
            --card: #ffffff;
            --text: #16181d;
            --muted: #5b6370;
            --border: #e5e7eb;
            --nav-bg: #0b0d12;
            --nav-text: #e8eaed;
            --nav-text-muted: #9aa0aa;
            --primary: #111827;
            --primary-text: #ffffff;
            --accent: #4338ca;
            --accent-solid: #4338ca;
            --accent-bg: #eef2ff;
            --red: #c81e1e;
            --red-bg: #fdecec;
            --blue: #2563eb;
            --blue-bg: #eff6ff;
            --ouro: #d97706;
            --ouro-bg: #fef3c7;
            --shadow: 0 1px 2px rgba(16, 24, 40, .04), 0 8px 20px rgba(16, 24, 40, .07);
            --shadow-lg: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 20px 25px -5px rgba(0, 0, 0, 0.08);
            color-scheme: light;
        }

        :root[data-tema="escuro"] {
            --bg: #0e1015;
            --card: #171a21;
            --text: #e7e9ee;
            --muted: #9aa0aa;
            --border: #2a2e37;
            --nav-bg: #000000;
            --nav-text: #e7e9ee;
            --nav-text-muted: #8b909b;
            --primary: #e7e9ee;
            --primary-text: #14161b;
            --accent: #a5b4fc;
            --accent-solid: #6366f1;
            --accent-bg: #1f2147;
            --red: #f87171;
            --red-bg: #3a1618;
            --blue: #60a5fa;
            --blue-bg: #1e293b;
            --ouro: #fbbf24;
            --ouro-bg: #451a03;
            --shadow: 0 1px 2px rgba(0, 0, 0, .35), 0 10px 24px rgba(0, 0, 0, .4);
            --shadow-lg: 0 10px 30px rgba(0, 0, 0, 0.6);
            color-scheme: dark;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        i[class*="ph"] { font-style: normal; display: inline-flex; vertical-align: -0.125em; }
        i[class*="ph"] > svg { width: 1em; height: 1em; fill: currentColor; display: block; }
        body {
            background: var(--bg);
            color: var(--text);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            font-size: 14.5px;
            line-height: 1.5;
            overflow-x: hidden;
            transition: background 0.2s ease, color 0.2s ease;
        }

        a { color: inherit; text-decoration: none; }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Navbar */
        .navbar {
            background: var(--nav-bg);
            color: var(--nav-text);
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .navbar__inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
        }
        .navbar__brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 18px;
            font-weight: 700;
            color: var(--nav-text);
        }
        .navbar__logo {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: var(--accent-solid);
            color: #ffffff;
            font-size: 20px;
        }
        .navbar__links {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        .navbar__link {
            font-size: 14px;
            font-weight: 500;
            color: var(--nav-text-muted);
            transition: color 0.15s;
        }
        .navbar__link:hover { color: #ffffff; }

        /* Idioma Switcher */
        .lang-select {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            color: #ffffff;
            padding: 5px 8px;
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 600;
            cursor: pointer;
            outline: none;
        }
        .lang-select option {
            background: #111827;
            color: #ffffff;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 9px 18px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid transparent;
            transition: all 0.15s ease;
        }
        .btn-primary {
            background: var(--primary);
            color: var(--primary-text);
        }
        .btn-primary:hover {
            opacity: 0.92;
            transform: translateY(-1px);
        }
        .btn-outline {
            background: var(--card);
            color: var(--text);
            border-color: var(--border);
        }
        .btn-outline:hover {
            background: var(--bg);
            border-color: var(--muted);
        }
        .btn-accent {
            background: var(--accent-solid);
            color: #ffffff;
        }
        .btn-accent:hover {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
        }
        .btn-pro {
            background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
            color: #ffffff;
        }
        .btn-pro:hover {
            opacity: 0.95;
            transform: translateY(-1px);
        }
        .btn-sm { padding: 6px 12px; font-size: 13px; border-radius: 8px; }
        .btn-lg { padding: 13px 26px; font-size: 16px; border-radius: 12px; }

        /* Cards */
        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            box-shadow: var(--shadow);
        }

        /* Badges */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        .badge-accent { background: var(--accent-bg); color: var(--accent); border: 1px solid rgba(99, 102, 241, 0.25); }
        .badge-blue { background: var(--blue-bg); color: var(--blue); border: 1px solid rgba(37, 99, 235, 0.2); }
        .badge-ouro { background: var(--ouro-bg); color: var(--ouro); border: 1px solid rgba(217, 119, 6, 0.2); }

        /* Hero */
        .hero {
            padding: 64px 0 84px;
            background:
                radial-gradient(760px 380px at 88% -8%, var(--accent-bg), transparent 62%),
                radial-gradient(620px 320px at -6% 108%, var(--ouro-bg), transparent 66%);
        }
        .hero-chips { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13.5px; color: var(--muted); }
        .hero-chips span { display: inline-flex; align-items: center; gap: 6px; }
        .hero-chips i { color: var(--accent); font-size: 16px; }
        .hero h1 em { font-style: normal; color: var(--accent); }
        .hero-grid {
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            gap: 48px;
            align-items: center;
        }
        .hero h1 {
            font-size: 44px;
            line-height: 1.15;
            font-weight: 800;
            letter-spacing: -0.02em;
            margin: 18px 0;
            color: var(--text);
        }
        .hero p {
            font-size: 16.5px;
            color: var(--muted);
            line-height: 1.6;
            margin-bottom: 28px;
        }
        .hero-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 28px;
        }
        .stars { color: #f59e0b; font-size: 16px; display: flex; gap: 2px; }

        /* Mockup */
        .mockup-card {
            border-radius: 20px;
            padding: 22px;
            background: var(--card);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-lg);
        }
        .mockup-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }
        .mockup-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 600;
            color: var(--muted);
            background: var(--bg);
            padding: 3px 10px;
            border-radius: 12px;
            border: 1px solid var(--border);
        }
        .saldo-display {
            font-size: 34px;
            font-weight: 800;
            color: var(--accent);
            letter-spacing: -0.02em;
            margin-top: 4px;
        }
        .resumo-duplo {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 16px;
        }
        .resumo-box {
            padding: 12px 14px;
            border-radius: 12px;
            background: var(--bg);
            border: 1px solid var(--border);
        }
        .resumo-box small { font-size: 11px; color: var(--muted); display: block; }
        .resumo-box strong { font-size: 16px; font-weight: 700; margin-top: 2px; display: block; }
        .val-receita { color: var(--accent); }
        .val-despesa { color: var(--red); }

        .transacao-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid var(--border);
            font-size: 13.5px;
        }
        .transacao-item:last-child { border-bottom: none; }
        .transacao-icone {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        /* Seções */
        .section {
            padding: 70px 0;
        }
        .section-header {
            text-align: center;
            max-width: 680px;
            margin: 0 auto 50px;
        }
        .section-header h2 {
            font-size: 34px;
            font-weight: 800;
            letter-spacing: -0.01em;
            margin-top: 10px;
            color: var(--text);
        }
        .section-header p {
            color: var(--muted);
            font-size: 16px;
        }

        /* Features Grid */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
        }
        .feature-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 26px;
            box-shadow: var(--shadow);
            transition: transform 0.2s ease, border-color 0.2s ease;
        }
        .feature-card:hover {
            transform: translateY(-3px);
            border-color: var(--accent);
        }
        .feature-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 16px;
        }
        .feature-card h3 {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--text);
        }
        .feature-card p {
            font-size: 14px;
            color: var(--muted);
            line-height: 1.55;
        }

        /* Pricing Section (Exata Estrutura de Colunas do Sistema) */
        .planos-topo {
            text-align: center;
            margin-bottom: 36px;
        }
        .planos-ciclo {
            display: inline-flex;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 24px;
            padding: 4px;
            gap: 4px;
            margin-top: 18px;
            box-shadow: var(--shadow);
        }
        .planos-ciclo button {
            border: none;
            background: none;
            padding: 8px 18px;
            border-radius: 20px;
            font-size: 13.5px;
            font-weight: 600;
            color: var(--muted);
            cursor: pointer;
            transition: all 0.15s;
        }
        .planos-ciclo button.is-ativo {
            background: var(--primary);
            color: var(--primary-text);
        }
        .planos-ciclo button small {
            color: var(--accent);
            font-weight: 700;
            margin-left: 4px;
        }

        .planos-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            align-items: stretch;
        }
        .plano-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 30px 24px;
            box-shadow: var(--shadow);
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }
        .plano-card:hover {
            transform: translateY(-4px);
        }
        .plano-card--destaque {
            border: 2px solid var(--accent);
            box-shadow: 0 8px 26px rgba(79, 70, 229, 0.18);
        }
        .plano-card--pro {
            border: 2px solid var(--ouro);
            box-shadow: 0 8px 26px rgba(217, 119, 6, 0.15);
        }
        .plano-faixa {
            position: absolute;
            top: -12px;
            left: 50%;
            transform: translateX(-50%);
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            white-space: nowrap;
        }
        .plano-faixa--accent { background: var(--accent-solid); color: #ffffff; }
        .plano-faixa--ouro { background: var(--ouro); color: #ffffff; }

        .plano-card h3 { font-size: 22px; font-weight: 800; }
        .plano-sub { font-size: 13px; color: var(--muted); min-height: 38px; margin-top: 4px; }
        .plano-preco {
            font-size: 32px;
            font-weight: 800;
            color: var(--text);
            margin: 16px 0 4px;
        }
        .plano-preco small { font-size: 14px; font-weight: 500; color: var(--muted); }
        .plano-cobranca { font-size: 12px; color: var(--muted); margin-bottom: 20px; }

        /* Grupos de recursos detalhados das colunas */
        .plano-grupo-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: var(--muted);
            margin-top: 20px;
            margin-bottom: 10px;
            border-top: 1px solid var(--border);
            padding-top: 14px;
        }
        .plano-grupo-header:first-of-type {
            margin-top: 16px;
        }

        .plano-recursos {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
            font-size: 13px;
        }
        .plano-recursos li {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            line-height: 1.45;
        }
        .plano-recursos li i { font-size: 16px; margin-top: 2px; flex-shrink: 0; }
        .plano-recursos li.is-on i { color: var(--accent); }
        .plano-recursos li.is-off { color: var(--muted); opacity: 0.55; }
        .plano-recursos li.is-off i { color: var(--muted); }

        /* Trial Banner */
        .trial-banner {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 22px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-top: 36px;
            flex-wrap: wrap;
        }

        /* FAQ */
        .faq-list {
            max-width: 760px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .faq-item {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
        }
        .faq-question {
            width: 100%;
            background: none;
            border: none;
            padding: 18px 22px;
            text-align: left;
            font-size: 15px;
            font-weight: 700;
            color: var(--text);
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
        }
        .faq-answer {
            display: none;
            padding: 0 22px 18px;
            font-size: 14px;
            color: var(--muted);
            line-height: 1.6;
        }
        .faq-item.is-open .faq-answer { display: block; }
        .faq-item.is-open .faq-question i { transform: rotate(180deg); }

        /* Footer */
        .footer {
            background: var(--nav-bg);
            color: var(--nav-text-muted);
            padding: 40px 0 30px;
            border-top: 1px solid rgba(255,255,255,0.08);
            font-size: 13.5px;
        }
        .footer-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }
        .footer-links {
            display: flex;
            gap: 20px;
        }
        .footer-links a:hover { color: #ffffff; }

        /* Dores (problema) */
        .dores-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
        .dor-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-left: 4px solid var(--red);
            border-radius: 14px;
            padding: 22px 22px 20px;
            box-shadow: var(--shadow);
        }
        .dor-card i { font-size: 26px; color: var(--red); display: block; margin-bottom: 10px; }
        .dor-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 6px; }
        .dor-card p { font-size: 14px; color: var(--muted); line-height: 1.55; }
        .dores-fecho {
            text-align: center;
            margin: 34px auto 0;
            max-width: 640px;
            font-size: 17px;
            font-weight: 600;
        }
        .dores-fecho em { font-style: normal; color: var(--accent); }

        /* Casos de uso */
        .casos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
        .caso-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 24px;
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            gap: 14px;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }
        .caso-card:hover { transform: translateY(-3px); border-color: var(--accent); }
        .caso-topo { display: flex; align-items: center; gap: 12px; }
        .caso-icone {
            width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center; font-size: 23px;
            background: var(--accent-bg); color: var(--accent);
        }
        .caso-quem { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
        .caso-card h3 { font-size: 18px; font-weight: 800; line-height: 1.25; }
        .caso-bloco { font-size: 13.5px; line-height: 1.55; color: var(--muted); }
        .caso-bloco b { display: block; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 2px; color: var(--text); }
        .caso-bloco--solucao { color: var(--text); }
        .caso-bloco--solucao b { color: var(--accent); }
        .caso-plano {
            margin-top: auto; padding-top: 14px; border-top: 1px dashed var(--border);
            display: flex; align-items: center; justify-content: space-between; gap: 10px;
            font-size: 12.5px; color: var(--muted);
        }
        .caso-plano a { font-weight: 700; color: var(--accent); white-space: nowrap; }
        .caso-plano a:hover { text-decoration: underline; }

        /* Como funciona */
        .passos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; counter-reset: passo; }
        .passo {
            position: relative;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 30px 24px 24px;
            box-shadow: var(--shadow);
        }
        .passo::before {
            counter-increment: passo;
            content: counter(passo);
            position: absolute; top: -16px; left: 22px;
            width: 34px; height: 34px; border-radius: 50%;
            background: var(--accent-solid); color: #ffffff;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; font-size: 16px;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
        }
        .passo h3 { font-size: 18px; font-weight: 700; margin-bottom: 6px; }
        .passo p { font-size: 14px; color: var(--muted); line-height: 1.55; }

        /* CTA final */
        .cta-final {
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 55%, #4338ca 100%);
            color: #ffffff;
            border-radius: 24px;
            padding: 52px 32px;
            text-align: center;
            box-shadow: var(--shadow-lg);
        }
        .cta-final h2 { font-size: 34px; font-weight: 800; letter-spacing: -0.01em; max-width: 700px; margin: 0 auto 12px; line-height: 1.2; }
        .cta-final p { font-size: 16.5px; color: rgba(255,255,255,0.8); max-width: 620px; margin: 0 auto 26px; }
        .cta-final .btn-cta { background: #ffffff; color: #312e81; font-weight: 800; }
        .cta-final .btn-cta:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(0,0,0,0.25); }
        .cta-final small { display: block; margin-top: 14px; font-size: 13px; color: rgba(255,255,255,0.7); }

        /* Responsive */
