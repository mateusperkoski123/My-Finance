<!DOCTYPE html>
<html lang="pt-BR" data-tema="claro" class="scroll-smooth">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title id="meta-title">MyFinance - Gestão Financeira Inteligente</title>
    <meta name="description" content="Controle financeiro completo: contas bancárias, lançamentos parcelados, relatórios DRE, inteligência artificial por texto, foto e áudio, e aplicativo offline.">
    <link rel="icon" type="image/png" href="/assets/icons/icon-192.png">
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    
    <style>
        :root[data-tema="claro"] {
            --bg: #f5f6f8;
            --card: #ffffff;
            --text: #16181d;
            --muted: #5b6370;
            --border: #e5e7eb;
            --nav-bg: #0b0d12;
            --nav-text: #e8eaed;
            --nav-text-muted: #9aa0aa;
            --primary: #111827;
            --primary-text: #ffffff;
            --green: #15803d;
            --green-bg: #e7f7ee;
            --red: #c81e1e;
            --red-bg: #fdecec;
            --blue: #2563eb;
            --blue-bg: #eff6ff;
            --ouro: #d97706;
            --ouro-bg: #fef3c7;
            --shadow: 0 1px 2px rgba(16, 24, 40, .04), 0 8px 20px rgba(16, 24, 40, .07);
            --shadow-lg: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 20px 25px -5px rgba(0, 0, 0, 0.08);
            color-scheme: light;
        }

        :root[data-tema="escuro"] {
            --bg: #0e1015;
            --card: #171a21;
            --text: #e7e9ee;
            --muted: #9aa0aa;
            --border: #2a2e37;
            --nav-bg: #000000;
            --nav-text: #e7e9ee;
            --nav-text-muted: #8b909b;
            --primary: #e7e9ee;
            --primary-text: #14161b;
            --green: #34d399;
            --green-bg: #113127;
            --red: #f87171;
            --red-bg: #3a1618;
            --blue: #60a5fa;
            --blue-bg: #1e293b;
            --ouro: #fbbf24;
            --ouro-bg: #451a03;
            --shadow: 0 1px 2px rgba(0, 0, 0, .35), 0 10px 24px rgba(0, 0, 0, .4);
            --shadow-lg: 0 10px 30px rgba(0, 0, 0, 0.6);
            color-scheme: dark;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background: var(--bg);
            color: var(--text);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            font-size: 14.5px;
            line-height: 1.5;
            overflow-x: hidden;
            transition: background 0.2s ease, color 0.2s ease;
        }

        a { color: inherit; text-decoration: none; }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Navbar */
        .navbar {
            background: var(--nav-bg);
            color: var(--nav-text);
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .navbar__inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
        }
        .navbar__brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 18px;
            font-weight: 700;
            color: var(--nav-text);
        }
        .navbar__logo {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: var(--green);
            color: #ffffff;
            font-size: 20px;
        }
        .navbar__links {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        .navbar__link {
            font-size: 14px;
            font-weight: 500;
            color: var(--nav-text-muted);
            transition: color 0.15s;
        }
        .navbar__link:hover { color: #ffffff; }

        /* Idioma Switcher */
        .lang-select {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            color: #ffffff;
            padding: 5px 8px;
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 600;
            cursor: pointer;
            outline: none;
        }
        .lang-select option {
            background: #111827;
            color: #ffffff;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 9px 18px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid transparent;
            transition: all 0.15s ease;
        }
        .btn-primary {
            background: var(--primary);
            color: var(--primary-text);
        }
        .btn-primary:hover {
            opacity: 0.92;
            transform: translateY(-1px);
        }
        .btn-outline {
            background: var(--card);
            color: var(--text);
            border-color: var(--border);
        }
        .btn-outline:hover {
            background: var(--bg);
            border-color: var(--muted);
        }
        .btn-green {
            background: var(--green);
            color: #ffffff;
        }
        .btn-green:hover {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(21, 128, 61, 0.25);
        }
        .btn-pro {
            background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
            color: #ffffff;
        }
        .btn-pro:hover {
            opacity: 0.95;
            transform: translateY(-1px);
        }
        .btn-sm { padding: 6px 12px; font-size: 13px; border-radius: 8px; }
        .btn-lg { padding: 13px 26px; font-size: 16px; border-radius: 12px; }

        /* Cards */
        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            box-shadow: var(--shadow);
        }

        /* Badges */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        .badge-green { background: var(--green-bg); color: var(--green); border: 1px solid rgba(21, 128, 61, 0.2); }
        .badge-blue { background: var(--blue-bg); color: var(--blue); border: 1px solid rgba(37, 99, 235, 0.2); }
        .badge-ouro { background: var(--ouro-bg); color: var(--ouro); border: 1px solid rgba(217, 119, 6, 0.2); }

        /* Hero */
        .hero {
            padding: 60px 0 80px;
        }
        .hero-grid {
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            gap: 48px;
            align-items: center;
        }
        .hero h1 {
            font-size: 44px;
            line-height: 1.15;
            font-weight: 800;
            letter-spacing: -0.02em;
            margin: 18px 0;
            color: var(--text);
        }
        .hero p {
            font-size: 16.5px;
            color: var(--muted);
            line-height: 1.6;
            margin-bottom: 28px;
        }
        .hero-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 28px;
        }
        .stars { color: #f59e0b; font-size: 16px; display: flex; gap: 2px; }

        /* Mockup */
        .mockup-card {
            border-radius: 20px;
            padding: 22px;
            background: var(--card);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-lg);
        }
        .mockup-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }
        .mockup-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 600;
            color: var(--muted);
            background: var(--bg);
            padding: 3px 10px;
            border-radius: 12px;
            border: 1px solid var(--border);
        }
        .saldo-display {
            font-size: 34px;
            font-weight: 800;
            color: var(--green);
            letter-spacing: -0.02em;
            margin-top: 4px;
        }
        .resumo-duplo {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 16px;
        }
        .resumo-box {
            padding: 12px 14px;
            border-radius: 12px;
            background: var(--bg);
            border: 1px solid var(--border);
        }
        .resumo-box small { font-size: 11px; color: var(--muted); display: block; }
        .resumo-box strong { font-size: 16px; font-weight: 700; margin-top: 2px; display: block; }
        .val-receita { color: var(--green); }
        .val-despesa { color: var(--red); }

        .transacao-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid var(--border);
            font-size: 13.5px;
        }
        .transacao-item:last-child { border-bottom: none; }
        .transacao-icone {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        /* Seções */
        .section {
            padding: 70px 0;
        }
        .section-header {
            text-align: center;
            max-width: 680px;
            margin: 0 auto 50px;
        }
        .section-header h2 {
            font-size: 34px;
            font-weight: 800;
            letter-spacing: -0.01em;
            margin-top: 10px;
            color: var(--text);
        }
        .section-header p {
            color: var(--muted);
            font-size: 16px;
        }

        /* Features Grid */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
        }
        .feature-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 26px;
            box-shadow: var(--shadow);
            transition: transform 0.2s ease, border-color 0.2s ease;
        }
        .feature-card:hover {
            transform: translateY(-3px);
            border-color: var(--green);
        }
        .feature-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 16px;
        }
        .feature-card h3 {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--text);
        }
        .feature-card p {
            font-size: 14px;
            color: var(--muted);
            line-height: 1.55;
        }

        /* Pricing Section (Exata Estrutura de Colunas do Sistema) */
        .planos-topo {
            text-align: center;
            margin-bottom: 36px;
        }
        .planos-ciclo {
            display: inline-flex;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 24px;
            padding: 4px;
            gap: 4px;
            margin-top: 18px;
            box-shadow: var(--shadow);
        }
        .planos-ciclo button {
            border: none;
            background: none;
            padding: 8px 18px;
            border-radius: 20px;
            font-size: 13.5px;
            font-weight: 600;
            color: var(--muted);
            cursor: pointer;
            transition: all 0.15s;
        }
        .planos-ciclo button.is-ativo {
            background: var(--primary);
            color: var(--primary-text);
        }
        .planos-ciclo button small {
            color: var(--green);
            font-weight: 700;
            margin-left: 4px;
        }

        .planos-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            align-items: stretch;
        }
        .plano-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 30px 24px;
            box-shadow: var(--shadow);
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }
        .plano-card:hover {
            transform: translateY(-4px);
        }
        .plano-card--destaque {
            border: 2px solid var(--green);
            box-shadow: 0 8px 26px rgba(21, 128, 61, 0.15);
        }
        .plano-card--pro {
            border: 2px solid var(--ouro);
            box-shadow: 0 8px 26px rgba(217, 119, 6, 0.15);
        }
        .plano-faixa {
            position: absolute;
            top: -12px;
            left: 50%;
            transform: translateX(-50%);
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            white-space: nowrap;
        }
        .plano-faixa--green { background: var(--green); color: #ffffff; }
        .plano-faixa--ouro { background: var(--ouro); color: #ffffff; }

        .plano-card h3 { font-size: 22px; font-weight: 800; }
        .plano-sub { font-size: 13px; color: var(--muted); min-height: 38px; margin-top: 4px; }
        .plano-preco {
            font-size: 32px;
            font-weight: 800;
            color: var(--text);
            margin: 16px 0 4px;
        }
        .plano-preco small { font-size: 14px; font-weight: 500; color: var(--muted); }
        .plano-cobranca { font-size: 12px; color: var(--muted); margin-bottom: 20px; }

        /* Grupos de recursos detalhados das colunas */
        .plano-grupo-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: var(--muted);
            margin-top: 20px;
            margin-bottom: 10px;
            border-top: 1px solid var(--border);
            padding-top: 14px;
        }
        .plano-grupo-header:first-of-type {
            margin-top: 16px;
        }

        .plano-recursos {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
            font-size: 13px;
        }
        .plano-recursos li {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            line-height: 1.45;
        }
        .plano-recursos li i { font-size: 16px; margin-top: 2px; flex-shrink: 0; }
        .plano-recursos li.is-on i { color: var(--green); }
        .plano-recursos li.is-off { color: var(--muted); opacity: 0.55; }
        .plano-recursos li.is-off i { color: var(--muted); }

        /* Trial Banner */
        .trial-banner {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 22px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-top: 36px;
            flex-wrap: wrap;
        }

        /* FAQ */
        .faq-list {
            max-width: 760px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .faq-item {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
        }
        .faq-question {
            width: 100%;
            background: none;
            border: none;
            padding: 18px 22px;
            text-align: left;
            font-size: 15px;
            font-weight: 700;
            color: var(--text);
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
        }
        .faq-answer {
            display: none;
            padding: 0 22px 18px;
            font-size: 14px;
            color: var(--muted);
            line-height: 1.6;
        }
        .faq-item.is-open .faq-answer { display: block; }
        .faq-item.is-open .faq-question i { transform: rotate(180deg); }

        /* Footer */
        .footer {
            background: var(--nav-bg);
            color: var(--nav-text-muted);
            padding: 40px 0 30px;
            border-top: 1px solid rgba(255,255,255,0.08);
            font-size: 13.5px;
        }
        .footer-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }
        .footer-links {
            display: flex;
            gap: 20px;
        }
        .footer-links a:hover { color: #ffffff; }

        /* Responsive */
        @media (max-width: 960px) {
            .hero-grid { grid-template-columns: 1fr; gap: 36px; }
            .hero h1 { font-size: 34px; }
            .features-grid { grid-template-columns: 1fr; }
            .planos-grid { grid-template-columns: 1fr; }
            .navbar__links { display: none; }
        }
        /* Celular: a barra do topo cabe na tela (o botao de teste gratis ja esta logo abaixo, no destaque)
           e nenhum bloco passa da largura da tela. */
        @media (max-width: 600px) {
            .navbar__brand > span:not(.navbar__logo) { display: none; }
            .navbar__inner > div:last-child { gap: 6px !important; }
            .navbar__inner a[href="/cadastro"] { display: none; }
            .ia-grid { grid-template-columns: 1fr !important; gap: 24px !important; }
            .ia-grid > * { min-width: 0; }
            #ia .card { padding: 22px 16px !important; }
            #ia h2 { font-size: 24px !important; }
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header class="navbar">
        <div class="container navbar__inner">
            <a href="/" class="navbar__brand">
                <span class="navbar__logo"><i class="ph-fill ph-hands-clapping"></i></span>
                <span>MyFinance</span>
            </a>

            <nav class="navbar__links">
                <a href="#recursos" class="navbar__link" data-i18n="nav_recursos">Recursos</a>
                <a href="#ia" class="navbar__link" data-i18n="nav_ia">Assistente IA</a>
                <a href="#planos" class="navbar__link" data-i18n="nav_planos">Planos</a>
                <a href="#faq" class="navbar__link" data-i18n="nav_faq">Perguntas Frequentes</a>
            </nav>

            <div style="display: flex; align-items: center; gap: 10px;">
                <!-- Seletor de Idioma PT / ES -->
                <select id="lang-toggle" class="lang-select" aria-label="Idioma">
                    <option value="pt-BR">🇧🇷 PT</option>
                    <option value="es-PY">🇵🇾 ES</option>
                </select>

                <!-- Botao Tema Claro/Escuro -->
                <button type="button" id="tema-toggle" class="btn btn-outline btn-sm" aria-label="Alternar tema" style="background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15); color: #ffffff;">
                    <i class="ph ph-moon"></i>
                </button>
                <a href="/login" class="btn btn-outline btn-sm" style="background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15); color: #ffffff;" data-i18n="nav_entrar">
                    <i class="ph ph-sign-in"></i> Entrar
                </a>
                <a href="/cadastro" class="btn btn-green btn-sm" data-i18n="nav_cadastro">
                    <i class="ph ph-sparkle"></i> Teste Grátis
                </a>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-grid">
                
                <!-- Left: Headline -->
                <div>
                    <span class="badge badge-green">
                        <i class="ph-fill ph-check-circle"></i> <span data-i18n="hero_badge">3 dias de teste grátis no plano que você escolher, sem cartão</span>
                    </span>

                    <h1 data-i18n="hero_titulo">Gestão financeira simples, inteligente e completa.</h1>

                    <p data-i18n="hero_sub">
                        Controle suas contas bancárias, lançamentos parcelados, relatórios DRE e automatize sua rotina com a Inteligência Artificial integrada por texto, foto e voz.
                    </p>

                    <div class="hero-actions">
                        <a href="/cadastro" class="btn btn-green btn-lg">
                            <span data-i18n="hero_cta">Começar Teste Grátis (3 Dias)</span>
                            <i class="ph-bold ph-arrow-right"></i>
                        </a>
                        <a href="#planos" class="btn btn-outline btn-lg">
                            <span data-i18n="hero_ver_planos">Ver Planos</span>
                        </a>
                    </div>

                    <div class="stars">
                        <i class="ph-fill ph-star"></i>
                        <i class="ph-fill ph-star"></i>
                        <i class="ph-fill ph-star"></i>
                        <i class="ph-fill ph-star"></i>
                        <i class="ph-fill ph-star"></i>
                        <span style="margin-left: 8px; font-size: 13.5px; color: var(--muted);">
                            <b>4.9 / 5</b> · <span data-i18n="hero_satisfacao">Plataforma multi-moeda e multi-idioma (Gs., R$, $)</span>
                        </span>
                    </div>
                </div>

                <!-- Right: Realistic MyFinance UI Mockup -->
                <div>
                    <div class="mockup-card">
                        <div class="mockup-header">
                            <span class="mockup-tag"><i class="ph ph-wallet"></i> <span data-i18n="mock_saldo_disp">Saldo Disponível</span></span>
                            <span style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase;">Outubro 2026</span>
                        </div>

                        <div style="font-size: 13px; color: var(--muted);" data-i18n="mock_total_cons">Total Consolidado</div>
                        <div class="saldo-display">Gs. 14.850.000</div>

                        <div class="resumo-duplo">
                            <div class="resumo-box">
                                <small><i class="ph-bold ph-arrow-down-left" style="color: var(--green);"></i> <span data-i18n="mock_receitas">Receitas</span></small>
                                <strong class="val-receita">+ Gs. 18.200.000</strong>
                            </div>
                            <div class="resumo-box">
                                <small><i class="ph-bold ph-arrow-up-right" style="color: var(--red);"></i> <span data-i18n="mock_despesas">Despesas</span></small>
                                <strong class="val-despesa">- Gs. 3.350.000</strong>
                            </div>
                        </div>

                        <!-- Mini Transactions -->
                        <div style="margin-top: 18px;">
                            <div style="font-size: 11.5px; font-weight: 700; text-transform: uppercase; color: var(--muted); margin-bottom: 8px;" data-i18n="mock_lanc_recentes">
                                Lançamentos Recentes
                            </div>

