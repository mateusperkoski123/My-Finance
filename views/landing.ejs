                trial_banner_btn: 'Crear Cuenta Gratuita',
                faq_badge: 'Preguntas Frecuentes',
                faq_titulo: 'Preguntas Frecuentes',
                faq_q1: '¿Cómo funciona la prueba gratis de 3 días?',
                faq_a1: 'Al crear su cuenta usted elige el plan que quiere probar (Básico, Premium o Pro) y lo usa gratis por 3 días, sin tarjeta de crédito. Durante la prueba puede cambiar de plan, sin reiniciar el plazo. La prueba vale una vez por cuenta: después, para continuar hay que contratar un plan, y sus datos quedan guardados.',
                faq_q2: '¿Cómo funciona la Inteligencia Artificial en el sistema?',
                faq_a2: 'Puede chatear con la IA para registrar gastos por texto ("Gasté 50 mil en súper"), enviar foto del ticket o nota de voz. La IA reconoce el monto, fecha y categoría y lo registra al instante con 10 segundos para deshacer.',
                faq_q3: '¿Cómo funciona el modo sin conexión?',
                faq_a3: 'Al instalar MyFinance como App en su celular (iOS/Android), puede registrar movimientos incluso sin internet. Cuando su teléfono recupere la conexión, todo se sincroniza automáticamente.',
                faq_q4: '¿Qué monedas son compatibles?',
                faq_a4: 'MyFinance es compatible con Guaraníes (Gs. PYG), Real (R$ BRL), Dólar ($ USD) y Euro (€ EUR), además de soporte nativo en Español y Portugués.',
                faq_q5: '¿Mis datos están seguros?',
                faq_a5: 'Sí. Utilizamos aislamiento multi-usuario por cuenta, cifrado SSL y protección CSRF nativa. Además, puede descargar una copia de seguridad JSON de sus cuentas y transacciones cuando lo desee.',
                direitos: 'Todos los derechos reservados.',
                termos: 'Términos de Uso',
                privacidade: 'Privacidad'
            }
        };

        // Idioma Engine
        const langSelect = document.getElementById('lang-toggle');
        const idiomaSalvo = localStorage.getItem('gf_idioma') || 'pt-BR';
        langSelect.value = idiomaSalvo;
        aplicarIdioma(idiomaSalvo);

        langSelect.addEventListener('change', (e) => {
            const lang = e.target.value;
            localStorage.setItem('gf_idioma', lang);
            aplicarIdioma(lang);
        });

        function aplicarIdioma(lang) {
            const dict = TRANSLATIONS[lang] || TRANSLATIONS['pt-BR'];
            document.documentElement.lang = lang;
            
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (dict[key]) {
                    el.innerHTML = dict[key];
                }
            });

            // Atualiza cobranca
            atualizarCobrancas(lang);
        }

        function atualizarCobrancas(lang) {
            const cicloBtn = document.querySelector('.planos-ciclo button.is-ativo');
            const ciclo = cicloBtn ? cicloBtn.getAttribute('data-ciclo') : 'mensal';
            const langKey = lang === 'es-PY' ? 'es' : 'pt';

            document.querySelectorAll('.plano-cobranca').forEach(el => {
                const texto = el.getAttribute('data-cobranca-' + ciclo + '-' + langKey);
                if (texto) el.textContent = texto;
            });
        }

        // Tema Toggle (Claro / Escuro)
        const temaBtn = document.getElementById('tema-toggle');
        const html = document.documentElement;
        
        const temaSalvo = localStorage.getItem('gf_tema') || 'claro';
        html.setAttribute('data-tema', temaSalvo);
        atualizarIconeTema(temaSalvo);

        temaBtn.addEventListener('click', () => {
            const temaAtual = html.getAttribute('data-tema');
            const novoTema = temaAtual === 'claro' ? 'escuro' : 'claro';
            html.setAttribute('data-tema', novoTema);
            localStorage.setItem('gf_tema', novoTema);
            atualizarIconeTema(novoTema);
        });

        function atualizarIconeTema(tema) {
            temaBtn.innerHTML = tema === 'claro' ? '<i class="ph ph-moon"></i>' : '<i class="ph ph-sun"></i>';
        }

        // Alternância Ciclo de Preços (Mensal / Anual)
        document.querySelectorAll('.planos-ciclo button').forEach(btn => {
            btn.addEventListener('click', () => {
                const ciclo = btn.getAttribute('data-ciclo');
                document.querySelectorAll('.planos-ciclo button').forEach(b => b.classList.toggle('is-ativo', b === btn));
                
                // Preços
                document.querySelectorAll('.preco-val').forEach(el => {
                    el.textContent = el.getAttribute('data-' + ciclo);
                });

                // Cobranças no idioma atual
                const curLang = langSelect.value || 'pt-BR';
                atualizarCobrancas(curLang);
            });
        });

        // FAQ Accordion
        document.querySelectorAll('.faq-question').forEach(q => {
            q.addEventListener('click', () => {
                const item = q.parentElement;
                item.classList.toggle('is-open');
            });
        });
    </script>

</body>
</html>
