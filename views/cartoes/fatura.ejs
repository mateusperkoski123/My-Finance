<%
    const _rotulo = function (mes) { const p = mes.split('-'); var r = new Date(Number(p[0]), Number(p[1]) - 1, 1).toLocaleDateString(lang, { month: 'long', year: 'numeric' }); return r.charAt(0).toUpperCase() + r.slice(1); };
    const _paga = !!fatura.paga;
    const _m = cartao.conta_moeda;
    const _pctCartao = Number(cartao.reintegro_pct) || 0;
    const _txtPct = function (n) { return String(Number(n)).replace('.', lang === 'en-US' ? '.' : ','); };
%>
<div class="page-header page-header--acoes">
    <div>
        <p class="muted" style="margin: 0 0 4px;"><a href="/cartoes"><i class="ph ph-arrow-left"></i> <%= t('cartoes.voltar') %></a></p>
        <h1><i class="ph ph-credit-card"></i> <%= cartao.nome %></h1>
        <p class="muted">
            <%= cartao.bandeira ? cartao.bandeira + ' · ' : '' %><%= cartao.conta_nome %> ·
            <%= t('cartoes.fecha_dia', { dia: cartao.dia_fechamento }) %> · <%= t('cartoes.vence_dia', { dia: cartao.dia_vencimento }) %>
            <% if (_pctCartao > 0) { %> · <span class="badge badge-sucesso"><i class="ph ph-arrow-u-up-left"></i> <%= t('cartoes.reintegro_pct_cartao', { pct: _txtPct(_pctCartao) }) %></span><% } %>
        </p>
    </div>
    <div class="page-header__botoes">
        <button type="button" class="btn btn-outline" data-modal-open="modal-editar-cartao"><i class="ph ph-pencil-simple"></i> <%= t('cartoes.editar_botao') %></button>
        <% if (!_paga) { %><button type="button" class="btn btn-primary" data-modal-open="modal-nova-compra"><i class="ph ph-plus-circle"></i> <%= t('cartoes.nova_compra') %></button><% } %>
    </div>
</div>

<%# Limite no alto, divida (todas as faturas ainda nao pagas) embaixo e o que sobrou: vale para o cartao inteiro, nao so para o mes. %>
<%- include('_resumo_limite', { limite: cartao.limite_total, usado: usado, moedaCod: _m }) %>

<div class="cartao-meses">
    <a class="btn btn-outline btn-sm" href="/cartoes/<%= cartao.id %>?mes=<%= mesAnterior %>" title="<%= t('cartoes.mes_anterior') %>" aria-label="<%= t('cartoes.mes_anterior') %>"><i class="ph ph-caret-left"></i></a>
    <strong><%= t('cartoes.fatura_de', { mes: _rotulo(fatura.mes) }) %></strong>
    <a class="btn btn-outline btn-sm" href="/cartoes/<%= cartao.id %>?mes=<%= mesSeguinte %>" title="<%= t('cartoes.mes_seguinte') %>" aria-label="<%= t('cartoes.mes_seguinte') %>"><i class="ph ph-caret-right"></i></a>
</div>

<div class="card cartao-resumo">
    <div>
        <div class="muted" style="font-size: 13px;"><%= t('cartoes.total_fatura') %></div>
        <div class="cartao-card__valor num"><%= moeda(fatura.total, _m) %></div>
        <% if (fatura.reintegro > 0) { %>
        <div class="cartao-resumo__conta">
            <span><%= t('cartoes.fatura_compras') %>: <b class="num"><%= moeda(fatura.bruto, _m) %></b></span>
            <span class="is-reintegro">− <%= t('cartoes.fatura_reintegro') %>: <b class="num"><%= moeda(fatura.reintegro, _m) %></b></span>
        </div>
        <% } %>
        <div class="muted" style="font-size: 13px;"><%= t('cartoes.fecha_em', { data: formatDate(fatura.fechamento, 'DD/MM/YYYY') }) %> · <%= t('cartoes.vence_em', { data: formatDate(fatura.vencimento, 'DD/MM/YYYY') }) %></div>
    </div>
    <div class="cartao-resumo__lado">
        <% if (_paga) { %>
            <span class="badge badge-sucesso"><i class="ph ph-check-circle"></i> <%= t('cartoes.situacao_paga', { data: formatDate(fatura.paga.pago_em, 'DD/MM/YYYY') }) %></span>
            <form method="post" action="/cartoes/<%= cartao.id %>/desfazer" data-confirm="<%= t('cartoes.confirmar_pagamento_desfazer') %>">
                <%- csrfCampo %><input type="hidden" name="mes" value="<%= fatura.mes %>">
                <button type="submit" class="btn btn-outline btn-sm"><i class="ph ph-arrow-counter-clockwise"></i> <%= t('cartoes.desfazer_pagamento') %></button>
            </form>
        <% } else if (futura) { %>
            <span class="badge badge-neutro"><i class="ph ph-calendar-blank"></i> <%= t('cartoes.situacao_futura') %></span>
        <% } else { %>
            <%# Situacao pela data de hoje: depois do vencimento com compras = vencida; depois do fechamento = fechada (falta pagar). %>
            <% if (fatura.compras.length && hoje > fatura.vencimento) { %>
            <span class="badge badge-erro"><i class="ph ph-warning-circle"></i> <%= t('cartoes.situacao_vencida') %></span>
            <% } else if (hoje > fatura.fechamento) { %>
            <span class="badge badge-alerta"><%= t('cartoes.situacao_fechada') %></span>
            <% } else { %>
            <span class="badge badge-alerta"><%= t('cartoes.situacao_aberta') %></span>
            <% } %>
            <% if (fatura.compras.length) { %><button type="button" class="btn btn-primary" data-modal-open="modal-pagar"><i class="ph ph-check-circle"></i> <%= t('cartoes.pagar_fatura') %></button><% } %>
        <% } %>
    </div>
</div>
<% if (_paga) { %><p class="muted" style="font-size: 13px;"><%= t('cartoes.fatura_paga_aviso') %></p><% } %>
<% if (!_paga && futura) { %><p class="muted" style="font-size: 13px;"><%= t('cartoes.fatura_futura_aviso') %></p><% } %>

<div class="card cartao-compras">
<% if (!fatura.compras.length) { %>
    <p class="muted" style="padding: 16px; margin: 0;"><%= t('cartoes.sem_compras') %></p>
<% } else { fatura.compras.forEach(function (c) { %>
    <div class="cartao-compra">
        <div class="cartao-compra__info">
            <strong><%= c.descricao %>
                <% if (c.serie_id) { %><span class="badge badge-neutro" style="font-size: 11px; margin-left: 4px;"><i class="ph ph-repeat"></i> <%= c.recorrente ? t('cartoes.assinatura') : t('cartoes.parcela', { n: c.serie_pos, total: c.serie_total }) %></span><% } %>
                <% if (Number(c.reintegro_valor) > 0) { %><span class="badge badge-sucesso" style="font-size: 11px; margin-left: 4px;"><i class="ph ph-arrow-u-up-left"></i> <%= t('cartoes.reintegro_etiqueta', { pct: _txtPct(c.reintegro_pct) }) %></span><% } %>
            </strong>
            <span class="muted"><%= formatDate(c.data_compra, 'DD/MM/YYYY') %> · <%= c.categoria_nome || t('cartoes.sem_categoria') %></span>
        </div>
        <%# Com reintegro: o valor a pagar (compra menos o reintegro) em destaque e o valor da compra riscado embaixo. %>
        <div class="cartao-compra__valor">
            <b class="num"><%= moeda(c.liquido, _m) %></b>
            <% if (Number(c.reintegro_valor) > 0) { %><s class="num"><%= moeda(c.valor, _m) %></s><% } %>
        </div>
        <% if (!_paga) { %>
        <button type="button" class="btn btn-outline btn-sm" data-modal-open="modal-compra-<%= c.id %>" title="<%= t('cartoes.editar_compra') %>" aria-label="<%= t('cartoes.editar_compra') %>"><i class="ph ph-pencil-simple"></i></button>
        <% if (c.serie_id) { %>
        <button type="button" class="btn btn-outline btn-sm" data-modal-open="modal-excluir-compra-<%= c.id %>" title="<%= t('cartoes.excluir_compra') %>" aria-label="<%= t('cartoes.excluir_compra') %>"><i class="ph ph-trash"></i></button>
        <% } else { %>
        <form method="post" action="/cartoes/<%= cartao.id %>/compras/<%= c.id %>/excluir" data-confirm="<%= t('cartoes.confirmar_excluir_compra') %>">
            <%- csrfCampo %><input type="hidden" name="mes" value="<%= fatura.mes %>">
            <button type="submit" class="btn btn-outline btn-sm" title="<%= t('cartoes.excluir_compra') %>" aria-label="<%= t('cartoes.excluir_compra') %>"><i class="ph ph-trash"></i></button>
        </form>
        <% } %>
        <% } %>
    </div>
<% }); } %>
</div>

<% if (!_paga) { fatura.compras.forEach(function (c) { %>
<%- include('_modal_compra', { idModal: 'modal-compra-' + c.id, acao: '/cartoes/' + cartao.id + '/compras/' + c.id + '/editar', titulo: t('cartoes.editar_compra'), categorias: categorias, hoje: hoje, moedaCod: _m, cartao: cartao, compra: c, mes: fatura.mes }) %>
<% if (c.serie_id) { %>
<%# Compra que se repete (assinatura/parcelas): excluir so esta ou esta e as proximas ainda nao pagas. %>
<div class="modal-backdrop" id="modal-excluir-compra-<%= c.id %>" data-modal>
    <div class="modal card">
        <div class="modal__header">
            <h3><%= t('cartoes.excluir_compra') %></h3>
            <button type="button" class="modal__fechar" data-modal-close aria-label="<%= t('comum.fechar') %>"><i class="ph ph-x"></i></button>
        </div>
        <form method="post" action="/cartoes/<%= cartao.id %>/compras/<%= c.id %>/excluir" class="form">
            <%- csrfCampo %><input type="hidden" name="mes" value="<%= fatura.mes %>">
            <p style="margin: 0 0 6px;"><strong><%= c.descricao %></strong> · <span class="num"><%= moeda(c.valor, _m) %></span></p>
            <p class="muted" style="font-size: 13px; margin: 0 0 12px;"><%= t('cartoes.excluir_serie_ajuda') %></p>
            <label class="lanc-serie__opcao"><input type="radio" name="escopo_serie" value="apenas_esta" checked> <%= t('cartoes.serie_apenas_esta') %></label>
            <label class="lanc-serie__opcao"><input type="radio" name="escopo_serie" value="esta_e_proximas"> <%= t('cartoes.serie_proximas') %></label>
            <div class="modal__actions">
                <button type="button" class="btn btn-outline" data-modal-close><%= t('clientes.cancelar') %></button>
                <button type="submit" class="btn btn-primary" style="background: var(--red); border: none;"><i class="ph ph-trash"></i> <%= t('cartoes.excluir_compra') %></button>
            </div>
        </form>
    </div>
</div>
<% } %>
<% }); } %>

<%# Mesma arvore categoria > subcategorias que o Painel usa (app.js preenche a subcategoria a partir dela). %>
<script>
window.gfCategoriasArvore = <%- jsonScript(categoriasArvore || []) %>;
</script>
<%- include('_modal_compra', { idModal: 'modal-nova-compra', acao: '/cartoes/' + cartao.id + '/compras', titulo: t('cartoes.nova_compra'), categorias: categorias, hoje: hoje, moedaCod: _m, cartao: cartao }) %>

<% if (!_paga && fatura.compras.length) { %>
<div class="modal-backdrop" id="modal-pagar" data-modal>
    <div class="modal card">
        <div class="modal__header">
            <h3><%= t('cartoes.pagar_titulo') %></h3>
            <button type="button" class="modal__fechar" data-modal-close aria-label="<%= t('comum.fechar') %>"><i class="ph ph-x"></i></button>
        </div>
        <form method="post" action="/cartoes/<%= cartao.id %>/pagar" class="form">
            <%- csrfCampo %><input type="hidden" name="mes" value="<%= fatura.mes %>">
            <p style="margin: 0 0 8px;"><b class="num"><%= moeda(fatura.total, _m) %></b></p>
            <% if (fatura.reintegro > 0) { %><p class="muted" style="margin: 0 0 8px; font-size: 13px;"><i class="ph ph-arrow-u-up-left"></i> <%= t('cartoes.pagar_reintegro', { valor: moeda(fatura.reintegro, _m) }) %></p><% } %>
            <p class="muted" style="margin: 0 0 12px;"><%= t('cartoes.pagar_ajuda', { conta: cartao.conta_nome }) %></p>
            <div class="form-group">
                <label for="pagar-data"><%= t('cartoes.data_pagamento') %></label>
                <input class="input" type="date" id="pagar-data" name="data" value="<%= hoje %>">
            </div>
            <div class="modal__actions">
                <button type="button" class="btn btn-outline" data-modal-close><%= t('clientes.cancelar') %></button>
                <button type="submit" class="btn btn-primary"><i class="ph ph-check-circle"></i> <%= t('cartoes.confirmar_pagar') %></button>
            </div>
        </form>
    </div>
</div>
<% } %>

<%- include('_modal_cartao', { idModal: 'modal-editar-cartao', acao: '/cartoes/' + cartao.id + '/atualizar', titulo: t('cartoes.editar'), contas: contas, cartao: cartao, voltar: 'fatura' }) %>
