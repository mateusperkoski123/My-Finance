<%
    const _marcados = itens.filter(function (i) { return i.marcado; });
    const _restantes = itens.filter(function (i) { return !i.marcado; });
    const _totalSugerido = estimativa.somaMarcados > 0 ? Number(estimativa.somaMarcados).toFixed(2) : '';
%>
<div class="page-header">
    <p class="muted" style="margin: 0 0 4px;"><a href="/compras/<%= lista.id %>"><i class="ph ph-arrow-left"></i> <%= lista.nome %></a></p>
    <h1><i class="ph ph-receipt"></i> <%= t('compras.fechar_titulo') %></h1>
    <p class="muted"><%= t('compras.fechar_subtitulo') %></p>
</div>

<form method="post" action="/compras/<%= lista.id %>/fechar" class="compras-layout" id="compras-fechar">
    <%- csrfCampo %>
    <div class="compras-principal">
        <% if (nota.estado !== 'indisponivel') { %>
        <div class="card compras-nota" id="compras-nota" data-url="/compras/<%= lista.id %>/nota"
            data-t-lendo="<%= t('compras.nota_lendo') %>" data-t-erro="<%= t('ia.erro_generico') %>" data-t-preco="<%= t('compras.preco') %>"
            data-t-na-lista="<%= t('compras.nota_na_lista') %>" data-t-extra="<%= t('compras.nota_extra') %>"
            data-t-aplicado="<%= t('compras.nota_aplicado', { lista: '{lista}', extras: '{extras}' }) %>"
            data-t-conferir="<%= t('compras.nota_conferir') %>" data-t-total-somado="<%= t('compras.nota_total_somado') %>" data-t-nao-confere="<%= t('compras.nota_nao_confere') %>">
            <div class="compras-nota__topo">
                <strong><i class="ph ph-camera"></i> <%= t('compras.nota_titulo') %></strong>
                <% if (nota.estado === 'ok' && nota.cota && nota.cota.limite) { %><span class="muted compras-nota__cota"><%= t('compras.nota_cota', { usados: nota.cota.usados, limite: nota.cota.limite }) %></span><% } %>
            </div>
            <% if (nota.estado === 'ok') { %>
                <p class="muted" style="margin: 6px 0 12px;"><%= t('compras.nota_ajuda') %></p>
                <label class="btn btn-outline compras-nota__botao" for="compras-nota-arquivo"><i class="ph ph-camera"></i> <%= t('compras.nota_botao') %></label>
                <input type="file" id="compras-nota-arquivo" class="compras-nota__arquivo" accept="image/*" capture="environment">
                <div id="compras-nota-status" class="compras-nota__status muted" aria-live="polite"></div>
                <div id="compras-nota-linhas" class="compras-nota__linhas" hidden></div>
            <% } else if (nota.estado === 'esgotada') { %>
                <p class="muted" style="margin: 6px 0 0;"><%= t('compras.nota_esgotada') %></p>
            <% } else { %>
                <p class="muted" style="margin: 6px 0 12px;"><%= t('compras.nota_plano') %></p>
                <a class="btn btn-outline btn-sm" href="/assinatura"><i class="ph ph-crown-simple"></i> <%= t('compras.nota_ver_planos') %></a>
            <% } %>
        </div>
        <% } %>
        <div class="card" style="padding: 16px;">
            <div class="form-group form-group--valor">
                <label for="fechar-total"><%= t('compras.total_pago') %> *</label>
                <input class="input" type="text" id="fechar-total" name="total" inputmode="decimal" maxlength="20" required autocomplete="off" value="<%= _totalSugerido %>"
                    data-estimativa="<%= estimativa.nivel === 'nenhum' ? '' : estimativa.valor %>"
                    data-t-mais="<%= t('compras.diff_mais', { valor: '{valor}' }) %>" data-t-menos="<%= t('compras.diff_menos', { valor: '{valor}' }) %>" data-t-igual="<%= t('compras.diff_igual') %>">
                <div class="compras-diff muted" id="compras-diff" aria-live="polite"></div>
            </div>
            <div class="compras-fila">
                <div class="form-group">
                    <label for="fechar-data"><%= t('compras.data_compra') %></label>
                    <input class="input" type="date" id="fechar-data" name="data" value="<%= hoje %>" max="<%= hoje %>">
                </div>
                <div class="form-group">
                    <label for="fechar-conta"><%= t('compras.campo_conta') %> *</label>
                    <select class="input" id="fechar-conta" name="conta_id" required>
                        <% contas.forEach(function (c) { %><option value="<%= c.id %>" <%= c.id === contaSugerida ? 'selected' : '' %>><%= c.nome %></option><% }) %>
                    </select>
                </div>
            </div>
            <div class="form-group" style="margin-bottom: 0;">
                <label for="fechar-categoria"><%= t('compras.campo_categoria') %> *</label>
                <select class="input" id="fechar-categoria" name="categoria_id" required>
                    <option value=""><%= t('compras.escolher_categoria') %></option>
                    <% categorias.forEach(function (c) { %>
                        <% if (c.subcategorias.length) { %>
                        <optgroup label="<%= c.nome %>">
                            <option value="<%= c.id %>" <%= Number(lista.categoria_id) === c.id ? 'selected' : '' %>><%= c.nome %></option>
                            <% c.subcategorias.forEach(function (s) { %><option value="<%= s.id %>" <%= Number(lista.categoria_id) === s.id ? 'selected' : '' %>><%= c.nome %> › <%= s.nome %></option><% }) %>
                        </optgroup>
                        <% } else { %>
                        <option value="<%= c.id %>" <%= Number(lista.categoria_id) === c.id ? 'selected' : '' %>><%= c.nome %></option>
                        <% } %>
                    <% }) %>
                </select>
                <small class="muted"><%= t('compras.ajuda_categoria_fechar') %></small>
            </div>
        </div>

        <h3 class="compras-subtitulo"><%= t('compras.comprados') %> <span class="muted">(<%= _marcados.length %>)</span></h3>
        <div class="card compras-itens">
            <% if (!_marcados.length) { %>
                <p class="muted" style="padding: 16px; margin: 0;"><%= t('compras.nenhum_marcado') %></p>
            <% } else { %>
                <p class="muted" style="padding: 12px 16px 0; margin: 0; font-size: 13px;"><%= t('compras.precos_opcionais') %></p>
                <% _marcados.forEach(function (i) { %>
                <div class="compras-item">
                    <span class="compras-item__nome"><%= i.nome %></span>
                    <div class="compras-preco">
                        <input class="input" type="text" name="preco_<%= i.id %>" inputmode="decimal" maxlength="20" data-preco-item value="<%= i.preco !== null ? Number(i.preco).toFixed(2) : '' %>" placeholder="<%= t('compras.preco') %>" aria-label="<%= t('compras.preco_de', { nome: i.nome }) %>">
                    </div>
                </div>
                <% }) %>
            <% } %>
        </div>
    </div>

    <aside class="compras-lateral">
        <div class="card compras-estimativa"><%- include('_estimativa', { estimativa }) %></div>
        <% if (_restantes.length) { %>
        <div class="card" style="padding: 16px;">
            <strong><%= t('compras.nao_comprou', { n: _restantes.length }) %></strong>
            <ul class="compras-restantes muted"><% _restantes.forEach(function (i) { %><li data-restante="<%= i.id %>"><%= i.nome %></li><% }) %></ul>
            <label class="compras-radio"><input type="radio" name="restantes" value="manter" checked> <%= t('compras.manter_proxima') %></label>
            <label class="compras-radio"><input type="radio" name="restantes" value="descartar"> <%= t('compras.descartar') %></label>
        </div>
        <% } %>
        <button type="submit" class="btn btn-primary compras-fechar"><i class="ph ph-floppy-disk"></i> <%= t('compras.salvar_lancamento') %></button>
        <p class="muted" style="font-size: 13px; margin: 0;"><%= t('compras.salvar_ajuda') %></p>
    </aside>
</form>
<script src="/assets/js/compras.js?v=<%= assetVersion %>"></script>
