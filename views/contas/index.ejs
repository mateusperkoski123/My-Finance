<div class="page-header page-header--acoes">
    <div>
        <h1><i class="ph ph-bank"></i> <%= t('contas.titulo') %></h1>
        <p class="muted"><%= t('contas.subtitulo') %></p>
    </div>
    <div class="page-header__botoes">
        <button type="button" class="btn btn-outline" data-modal-open="modal-transferir" onclick="resetModalTransferir()"><i class="ph ph-arrows-left-right"></i> <%= t('contas.transferir') %></button>
        <button type="button" class="btn btn-outline" data-modal-open="modal-agendar-transferencia"><i class="ph ph-calendar-plus"></i> <%= t('contas.agendar') %></button>
        <button type="button" class="btn btn-primary" data-modal-open="modal-nova-conta"><%= t('contas.nova') %></button>
    </div>
</div>

<div class="contas-toolbar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div class="tabs">
        <a href="/contas" class="tabs__item <%= !abaArquivadas ? 'is-active' : '' %>"><%= t('contas.aba_ativas') %></a>
        <a href="/contas?aba=arquivadas" class="tabs__item <%= abaArquivadas ? 'is-active' : '' %>"><%= t('contas.aba_arquivadas') %></a>
    </div>
    <div class="contas-resumo-topo" style="display: flex; align-items: center; gap: 12px;">
        <span class="badge badge-neutro" style="font-size: 12px; font-weight: 600;"><%= t('contas.n_contas', { n: totalContas }) %></span>
        <span class="muted"><%= t('contas.saldo_total') %>:</span>
        <strong class="moeda-destaque" id="header-saldo-total" style="font-size: 18px; margin-left: 4px; color: var(--green);"><%= moeda(saldoTotal) %></strong>
    </div>
</div>

<% if (!contas || contas.length === 0) { %>
    <div class="card placeholder-card">
        <p class="muted"><%= abaArquivadas ? t('contas.nenhuma_arquivada') : t('contas.nenhuma_ativa') %></p>
    </div>
<% } else { %>
    <div class="contas-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
        <% contas.forEach(c => { %>
            <div class="card conta-card" data-conta-card-id="<%= c.id %>" data-raw-saldo="<%= c.saldo_atual %>" style="--conta-cor: <%= c.cor || '#3b82f6' %>; border-radius: 16px; padding: 20px;">
                <div class="conta-card__header" style="display: flex; justify-content: space-between; align-items: center;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span class="conta-card__dot" style="background: <%= c.cor %>; width: 12px; height: 12px; border-radius: 50%; display: inline-block;"></span>
                        <strong><%= c.nome %></strong>
                        <% if (c.conta_padrao) { %>
                            <span class="badge badge-padrao" style="font-size: 10px;"><%= t('contas.conta_padrao') %></span>
                        <% } %>
                    </div>
                    <% if (!abaArquivadas) { %>
                        <button type="button" class="btn-olho-toggle" data-conta-id="<%= c.id %>" onclick="toggleOlhoConta('<%= c.id %>')" title="<%= t('contas.ocultar_exibir') %>" style="background: none; border: none; cursor: pointer; padding: 4px;">
                            <span id="btn-olho-icon-<%= c.id %>"><i class="ph ph-eye" style="font-size: 18px; color: var(--muted);"></i></span>
                        </button>
                    <% } %>
                </div>
                <div class="conta-card__body" style="margin: 16px 0;">
                    <span class="muted" style="font-size: 12px;"><%= t('contas.saldo_atual') %></span>
                    <div class="conta-card__saldo val-saldo-display" id="saldo-display-<%= c.id %>" style="font-size: 22px; font-weight: 700; color: <%= c.saldo_atual >= 0 ? 'var(--green)' : 'var(--red)' %>;">
                        <%= moeda(c.saldo_atual) %>
                    </div>
                </div>
                <div class="conta-card__footer" style="display: flex; gap: 6px; flex-wrap: wrap; border-top: 1px solid var(--border); padding-top: 12px;">
                    <% if (!abaArquivadas) { %>
                        <a href="/contas/<%= c.id %>/extrato" class="btn btn-outline btn-sm"><%= t('contas.extrato') %></a>
                        <button type="button" class="btn btn-outline btn-sm" data-modal-open="modal-transferir" onclick="prepararTransferenciaOrigem('<%= c.id %>', '<%= c.nome %>')"><%= t('contas.transferir') %></button>
                        <button type="button" class="btn btn-outline btn-sm" data-modal-open="modal-ajustar-<%= c.id %>"><%= t('contas.ajustar_saldo') %></button>
                        <button type="button" class="btn btn-outline btn-sm" data-modal-open="modal-editar-<%= c.id %>"><%= t('contas.editar') %></button>
                        <form method="post" action="/contas/<%= c.id %>/arquivar" style="display:inline;">
                            <%- csrfCampo %>
                            <button type="submit" class="btn btn-outline btn-sm" title="<%= t('contas.arquivar') %>" aria-label="<%= t('contas.arquivar') %>"><i class="ph ph-archive"></i></button>
                        </form>
                        <button type="button" class="btn btn-outline btn-sm" style="color: var(--red);" data-modal-open="modal-excluir-<%= c.id %>" title="<%= t('contas.eliminar_titulo') %>" aria-label="<%= t('contas.eliminar_titulo') %>"><i class="ph ph-trash"></i></button>
                    <% } else { %>
                        <form method="post" action="/contas/<%= c.id %>/restaurar" style="display:inline;">
                            <%- csrfCampo %>
                            <button type="submit" class="btn btn-outline btn-sm"><%= t('contas.restaurar') %></button>
                        </form>
                        <button type="button" class="btn btn-outline btn-sm" style="color: var(--red);" data-modal-open="modal-excluir-<%= c.id %>" title="<%= t('contas.eliminar_titulo') %>" aria-label="<%= t('contas.eliminar_titulo') %>"><i class="ph ph-trash"></i></button>
                    <% } %>
                </div>
            </div>

            <!-- Modal Excluir Conta -->
            <div class="modal-backdrop" id="modal-excluir-<%= c.id %>">
                <div class="modal card">
                    <div class="modal__header">
                        <h3><%= t('contas.eliminar_titulo') %></h3>
                        <button type="button" class="modal__close" data-modal-close>&times;</button>
                    </div>
                    <div class="modal__body" style="padding: 16px 0;">
                        <p style="font-size: 15px; font-weight: 500;"><%= t('contas.eliminar_confirma', { nome: c.nome }) %></p>
                        <p class="muted" style="font-size: 13px; margin-top: 8px; color: var(--red);"><%= t('contas.eliminar_aviso') %></p>
                        <div class="aviso-exclusao">
                            <i class="ph ph-warning"></i>
                            <span><%- t('contas.aviso_exclusao', { n: parseInt(c.total_lancamentos, 10) || 0, saldo: moeda(c.saldo_atual) }) %></span>
                        </div>
                    </div>
                    <div class="modal__actions" style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px;">
                        <button type="button" class="btn btn-outline" data-modal-close><%= t('contas.cancelar') %></button>
                        <form method="post" action="/contas/<%= c.id %>/excluir" style="display:inline;">
                            <%- csrfCampo %>
                            <button type="submit" class="btn btn-danger" style="background: var(--red); color: var(--on-accent); border: none;"><%= t('contas.sim_eliminar') %></button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Modal Ajustar Saldo para esta conta -->
            <div class="modal-backdrop" id="modal-ajustar-<%= c.id %>">
                <div class="modal card">
                    <div class="modal__header">
                        <h3><%= t('contas.ajustar_titulo') %></h3>
                        <button type="button" class="modal__close" data-modal-close>&times;</button>
                    </div>
                    <form method="post" action="/contas/<%= c.id %>/ajustar" class="form">
                        <%- csrfCampo %>
                        <input type="hidden" name="tipo_ajuste" id="tipo-ajuste-input-<%= c.id %>" value="ingreso">

                        <p class="muted" style="font-size: 13px;"><%= t('contas.ajustar_sub', { nome: c.nome }) %></p>

                        <div style="background: var(--bg); padding: 14px; border-radius: 12px; margin-bottom: 16px;">
                            <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted);"><%= t('contas.origem') %></span>
                            <div style="font-weight: 600; font-size: 15px;"><%= c.nome %></div>
                            <div style="font-size: 13px; margin-top: 4px;"><%= t('contas.saldo') %>: <strong style="color: var(--green);"><%= moeda(c.saldo_atual) %></strong></div>
                        </div>

                        <div class="form-group">
                            <label><%= t('contas.inf_valor') %></label>
                            <div style="display: flex; gap: 8px; align-items: center;">
                                <button type="button" class="btn btn-outline" id="btn-toggle-tipo-<%= c.id %>"
                                        data-input="tipo-ajuste-input-<%= c.id %>"
                                        data-rotulo-add="<%= t('contas.adicionar_saldo') %>"
                                        data-rotulo-sub="<%= t('contas.subtrair_saldo') %>"
                                        onclick="gfAlternarAjuste(this)"
                                        style="white-space: nowrap; color: var(--green); font-weight: 600;">
                                    <i class="ph ph-plus"></i> <span><%= t('contas.adicionar_saldo') %></span>
                                </button>
                                <input class="input" type="text" name="valor_ajuste" data-money required placeholder="0,00" style="flex: 1;">
                            </div>
                        </div>

                        <div class="modal__actions">
                            <button type="button" class="btn btn-outline" data-modal-close><%= t('contas.cancelar') %></button>
                            <button type="submit" class="btn btn-primary"><%= t('contas.confirmar_ajuste') %></button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Modal Editar Conta -->
            <div class="modal-backdrop" id="modal-editar-<%= c.id %>">
                <div class="modal card">
                    <div class="modal__header">
                        <h3><%= t('contas.modal.editar_titulo') %></h3>
                        <button type="button" class="modal__close" data-modal-close>&times;</button>
                    </div>
                    <form method="post" action="/contas/<%= c.id %>/atualizar" class="form">
                        <%- csrfCampo %>

                        <div class="form-group">
                            <label><%= t('contas.nome_label') %></label>
                            <input class="input" type="text" name="nome" value="<%= c.nome %>" required>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label><%= t('contas.tipo_label') %></label>
                                <select class="input" name="tipo">
                                    <option value="corrente" <%= c.tipo === 'corrente' ? 'selected' : '' %>><%= t('contas.tipo.corrente') %></option>
                                    <option value="poupanca" <%= c.tipo === 'poupanca' ? 'selected' : '' %>><%= t('contas.tipo.poupanca') %></option>
                                    <option value="carteira" <%= c.tipo === 'carteira' ? 'selected' : '' %>><%= t('contas.tipo.carteira') %></option>
                                    <option value="investimento" <%= c.tipo === 'investimento' ? 'selected' : '' %>><%= t('contas.tipo.investimento') %></option>
                                    <option value="outra" <%= c.tipo === 'outra' ? 'selected' : '' %>><%= t('contas.tipo.outra') %></option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label><%= t('contas.cor_label') %></label>
                                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 4px;">
                                    <input class="input" type="color" id="cor-picker-<%= c.id %>" name="cor" value="<%= c.cor || '#3b82f6' %>" style="width: 44px; height: 38px; padding: 2px; cursor: pointer;">
                                    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                        <button type="button" style="background: #3b82f6; width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-<%= c.id %>').value='#3b82f6'"></button>
                                        <button type="button" style="background: #10b981; width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-<%= c.id %>').value='#10b981'"></button>
                                        <button type="button" style="background: #ef4444; width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-<%= c.id %>').value='#ef4444'"></button>
                                        <button type="button" style="background: #8b5cf6; width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-<%= c.id %>').value='#8b5cf6'"></button>
                                        <button type="button" style="background: #f59e0b; width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-<%= c.id %>').value='#f59e0b'"></button>
                                        <button type="button" style="background: #f97316; width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-<%= c.id %>').value='#f97316'"></button>
                                        <button type="button" style="background: #ec4899; width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-<%= c.id %>').value='#ec4899'"></button>
                                        <button type="button" style="background: #64748b; width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-<%= c.id %>').value='#64748b'"></button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="checkbox-linha">
                                <input type="checkbox" name="e_padrao" value="1" <%= c.conta_padrao ? 'checked' : '' %>>
                                <%= t('contas.definir_padrao') %>
                            </label>
                        </div>

                        <div class="modal__actions">
                            <button type="button" class="btn btn-outline" data-modal-close><%= t('contas.cancelar') %></button>
                            <button type="submit" class="btn btn-primary"><%= t('contas.salvar') %></button>
                        </div>
                    </form>
                </div>
            </div>
        <% }) %>
    </div>
<% } %>

<!-- Modal Nova Conta -->
<div class="modal-backdrop" id="modal-nova-conta">
    <div class="modal card">
        <div class="modal__header">
            <h3><%= t('contas.modal.nova_titulo') %></h3>
            <button type="button" class="modal__close" data-modal-close>&times;</button>
        </div>
        <form method="post" action="/contas/criar" class="form">
            <%- csrfCampo %>

            <div class="form-group">
                <label><%= t('contas.nome_label') %></label>
                <input class="input" type="text" name="nome" required placeholder="<%= t('contas.nome_placeholder') %>">
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label><%= t('contas.tipo_label') %></label>
                    <select class="input" name="tipo">
                        <option value="corrente"><%= t('contas.tipo.corrente') %></option>
                        <option value="poupanca"><%= t('contas.tipo.poupanca') %></option>
                        <option value="carteira"><%= t('contas.tipo.carteira') %></option>
                        <option value="investimento"><%= t('contas.tipo.investimento') %></option>
                        <option value="outra"><%= t('contas.tipo.outra') %></option>
                    </select>
                </div>
                <div class="form-group">
                    <label><%= t('contas.saldo_inicial_label') %></label>
                    <input class="input" type="text" name="saldo_inicial" data-money placeholder="0,00">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label><%= t('contas.cor_label') %></label>
                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 4px;">
                        <input class="input" type="color" id="cor-picker-nova" name="cor" value="#3b82f6" style="width: 44px; height: 38px; padding: 2px; cursor: pointer;">
                        <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                            <button type="button" style="background: #3b82f6; width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-nova').value='#3b82f6'"></button>
                            <button type="button" style="background: #10b981; width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-nova').value='#10b981'"></button>
                            <button type="button" style="background: #ef4444; width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-nova').value='#ef4444'"></button>
                            <button type="button" style="background: #8b5cf6; width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-nova').value='#8b5cf6'"></button>
                            <button type="button" style="background: #f59e0b; width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-nova').value='#f59e0b'"></button>
                            <button type="button" style="background: #f97316; width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-nova').value='#f97316'"></button>
                            <button type="button" style="background: #ec4899; width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-nova').value='#ec4899'"></button>
                            <button type="button" style="background: #64748b; width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px #ccc; cursor: pointer;" onclick="document.getElementById('cor-picker-nova').value='#64748b'"></button>
                        </div>
                    </div>
                </div>
                <div class="form-group" style="display: flex; align-items: flex-end;">
                    <label class="checkbox-linha">
                        <input type="checkbox" name="e_padrao" value="1">
                        <%= t('contas.definir_padrao') %>
                    </label>
                </div>
            </div>

            <div class="modal__actions">
                <button type="button" class="btn btn-outline" data-modal-close><%= t('contas.cancelar') %></button>
                <button type="submit" class="btn btn-primary"><%= t('contas.salvar') %></button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Transferir entre contas -->
<div class="modal-backdrop" id="modal-transferir">
    <div class="modal card">
        <div class="modal__header">
            <h3><%= t('contas.modal.transferir_titulo') %></h3>
            <button type="button" class="modal__close" data-modal-close>&times;</button>
        </div>
        <form method="post" action="/contas/transferir" class="form">
            <%- csrfCampo %>
            <input type="hidden" name="origem_id" id="transfer-origem-hidden" value="">

            <div class="form-row">
                <div class="form-group">
                    <label><%= t('contas.transferir.origem_label') %></label>
                    <select class="input" id="transfer-origem-select" name="origem_id" required onchange="
                        document.getElementById('transfer-origem-hidden').value = this.value;
                        atualizarOpcoesDestino(this.value);
                    ">
                        <% (contas || []).filter(c => c.status !== 'arquivada').forEach(c => { %>
                            <option value="<%= c.id %>"><%= c.nome %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group">
                    <label><%= t('contas.transferir.destino_label') %></label>
                    <select class="input" id="transfer-destino-select" name="destino_id" required>
                        <% (contas || []).filter(c => c.status !== 'arquivada').forEach(c => { %>
                            <option value="<%= c.id %>"><%= c.nome %></option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label><%= t('contas.transferir.valor_label') %></label>
                    <input class="input" type="text" name="valor" data-money required placeholder="0,00">
                </div>
                <div class="form-group">
                    <label><%= t('contas.transferir.data_label') %></label>
                    <input class="input" type="date" name="data" value="<%= formatDate(new Date()) %>" required>
                </div>
            </div>

            <div class="form-group">
                <label><%= t('contas.transferir.descricao_label') %></label>
                <input class="input" type="text" name="descricao" placeholder="<%= t('contas.descricao_placeholder') %>">
            </div>

            <div class="modal__actions">
                <button type="button" class="btn btn-outline" data-modal-close><%= t('contas.cancelar') %></button>
                <button type="submit" class="btn btn-primary"><%= t('contas.transferir') %></button>
            </div>
        </form>
    </div>
</div>

<div class="modal-backdrop" id="modal-agendar-transferencia">
    <div class="modal card">
        <div class="modal__header">
            <h3><%= t('contas.modal.agendar_titulo') %></h3>
            <button type="button" class="modal__close" data-modal-close>&times;</button>
        </div>
        <form method="post" action="/contas/agendar-transferencia" class="form">
            <%- csrfCampo %>
            <p class="muted" style="font-size: 12.5px; margin-top: 0;"><%= t('agendar.ajuda') %></p>

            <div class="form-row">
                <div class="form-group">
                    <label><%= t('contas.transferir.origem_label') %></label>
                    <select class="input" name="origem_id" required>
                        <% (contas || []).filter(c => c.status !== 'arquivada').forEach(c => { %>
                            <option value="<%= c.id %>"><%= c.nome %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group">
                    <label><%= t('contas.transferir.destino_label') %></label>
                    <select class="input" name="destino_id" required>
                        <% (contas || []).filter(c => c.status !== 'arquivada').forEach((c, i) => { %>
                            <option value="<%= c.id %>" <%= i === 1 ? 'selected' : '' %>><%= c.nome %></option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label><%= t('contas.transferir.valor_label') %></label>
                    <input class="input" type="text" name="valor" data-money required placeholder="0,00">
                </div>
                <div class="form-group">
                    <label><%= t('agendar.data') %></label>
                    <input class="input" type="date" name="data" value="<%= formatDate(new Date()) %>" required>
                </div>
            </div>

            <div class="form-group">
                <label><%= t('contas.transferir.descricao_label') %></label>
                <input class="input" type="text" name="descricao" maxlength="100" placeholder="<%= t('contas.descricao_placeholder') %>">
            </div>

            <div style="border: 1px solid var(--border); border-radius: 14px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; background: var(--bg); margin-bottom: 10px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <i class="ph ph-push-pin" style="font-size: 18px; color: var(--muted);"></i>
                    <strong style="font-size: 13px;"><%= t('agendar.fixa') %></strong>
                </div>
                <label class="toggle" style="margin: 0;">
                    <input type="checkbox" name="e_fixo" value="1">
                    <span class="toggle__track"><span class="toggle__thumb"></span></span>
                </label>
            </div>
            <div style="border: 1px solid var(--border); border-radius: 14px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; background: var(--bg); margin-bottom: 10px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <i class="ph ph-arrows-clockwise" style="font-size: 18px; color: var(--muted);"></i>
                    <strong style="font-size: 13px;"><%= t('modal.repetir') %></strong>
                </div>
                <label class="toggle" style="margin: 0;">
                    <input type="checkbox" name="repetir" value="1" data-gf-toggle-repetir>
                    <span class="toggle__track"><span class="toggle__thumb"></span></span>
                </label>
            </div>

            <div class="form-group" data-gf-repetir-alvo hidden style="padding: 10px 14px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg);">
                <label style="font-size: 12px; font-weight: 600;"><%= t('modal.qtd_repeticoes') %></label>
                <input class="input" type="number" name="quantidade_repeticoes" min="2" max="60" value="12">
            </div>

            <div class="modal__actions">
                <button type="button" class="btn btn-outline" data-modal-close><%= t('contas.cancelar') %></button>
                <button type="submit" class="btn btn-primary"><%= t('agendar.criar') %></button>
            </div>
        </form>
    </div>
</div>

<script>
const ocultasSet = new Set(JSON.parse(localStorage.getItem('gf_contas_ocultas') || '[]'));

// Alterna o ajuste entre "adicionar" e "subtrair" (sem HTML dentro de atributo inline).
function gfAlternarAjuste(btn) {
    var input = document.getElementById(btn.getAttribute('data-input'));
    var adicionando = input.value === 'ingreso';
    input.value = adicionando ? 'salida' : 'ingreso';
    btn.querySelector('i').className = 'ph ' + (adicionando ? 'ph-minus' : 'ph-plus');
    btn.querySelector('span').textContent = btn.getAttribute(adicionando ? 'data-rotulo-sub' : 'data-rotulo-add');
    btn.style.color = adicionando ? 'var(--red)' : 'var(--green)';
}

function toggleOlhoConta(contaId) {
    if (ocultasSet.has(contaId)) {
        ocultasSet.delete(contaId);
    } else {
        ocultasSet.add(contaId);
    }
    localStorage.setItem('gf_contas_ocultas', JSON.stringify(Array.from(ocultasSet)));
    aplicarEstadosOlho();
}

function aplicarEstadosOlho() {
    let saldoTotalVisivel = 0;

    document.querySelectorAll('.conta-card').forEach(card => {
        const contaId = card.getAttribute('data-conta-card-id');
        const rawSaldo = parseFloat(card.getAttribute('data-raw-saldo')) || 0;
        const iconSpan = document.getElementById('btn-olho-icon-' + contaId);
        const displayEl = card.querySelector('.val-saldo-display');

        if (ocultasSet.has(contaId)) {
            if (iconSpan) iconSpan.innerHTML = '<i class="ph ph-eye-slash" style="font-size: 18px; color: var(--muted);"></i>';
            if (displayEl) displayEl.innerHTML = '••••••••';
        } else {
            if (iconSpan) iconSpan.innerHTML = '<i class="ph ph-eye" style="font-size: 18px; color: var(--muted);"></i>';
            saldoTotalVisivel += rawSaldo;
            if (displayEl && typeof gfFormatarValorMoeda === 'function') {
                displayEl.innerHTML = window.gfFormatarValorMoeda(rawSaldo);
            }
        }
    });

    const headerTotalEl = document.getElementById('header-saldo-total');
    if (headerTotalEl && typeof gfFormatarValorMoeda === 'function') {
        headerTotalEl.innerHTML = window.gfFormatarValorMoeda(saldoTotalVisivel);
    }
}

function prepararTransferenciaOrigem(origemId, origemNome) {
    const origSelect = document.getElementById('transfer-origem-select');
    const origHidden = document.getElementById('transfer-origem-hidden');
    if (origSelect && origHidden) {
        origSelect.value = origemId;
        origSelect.disabled = true;
        origHidden.value = origemId;
    }
    atualizarOpcoesDestino(origemId);
}

function resetModalTransferir() {
    const origSelect = document.getElementById('transfer-origem-select');
    const origHidden = document.getElementById('transfer-origem-hidden');
    if (origSelect && origHidden) {
        origSelect.disabled = false;
        origHidden.value = origSelect.value;
    }
    atualizarOpcoesDestino(origSelect ? origSelect.value : null);
}

function atualizarOpcoesDestino(origemId) {
    const destSelect = document.getElementById('transfer-destino-select');
    if (!destSelect) return;
    Array.from(destSelect.options).forEach(opt => {
        opt.disabled = (opt.value === String(origemId));
    });
    if (destSelect.value === String(origemId)) {
        const firstValid = Array.from(destSelect.options).find(opt => !opt.disabled);
        if (firstValid) destSelect.value = firstValid.value;
    }
}

document.addEventListener('DOMContentLoaded', () => {
    aplicarEstadosOlho();
});
</script>
