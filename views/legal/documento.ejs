<div class="page-header">
    <h1><%= title %></h1>
    <p class="muted"><%= t('legal.versao', { versao: versao }) %></p>
</div>

<div class="card legal-doc">
    <div class="alert alert-aviso"><i class="ph ph-warning"></i> <%= aviso %></div>
    <% secoes.forEach(([titulo, texto]) => { %>
        <h3><%= titulo %></h3>
        <p><%= texto %></p>
    <% }) %>
    <p style="margin-top: 20px;"><a href="/termos"><%= t('legal.termos_titulo') %></a> · <a href="/privacidade"><%= t('legal.privacidade_titulo') %></a></p>
</div>
