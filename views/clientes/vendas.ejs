<%
    const _todos = periodo.mes === 'todos';
    const _mesNome = _todos ? t('clientes.todos_meses') : new Date(Date.UTC(periodo.ano, periodo.numero - 1, 1)).toLocaleDateString(lang, { month: 'long', year: 'numeric', timeZone: 'UTC' });
%>
<div class="page-header page-header--acoes">
    <div>
        <h1><i class="ph ph-users"></i> <%= t('clientes.titulo') %></h1>
        <p class="muted"><%= t('vendas.subtitulo') %></p>
    </div>
    <div class="page-header__botoes">
        <a class="btn btn-primary" href="/clientes/vendas/nova"><i class="ph ph-plus-circle"></i> <%= t('vendas.nova') %></a>
    </div>
</div>

<%- include('_abas') %>

<div class="clientes-periodo">
    <% if (!_todos) { %>
    <div class="periodo-nav" style="display: inline-flex; align-items: center; gap: 4px;">
        <a class="btn btn-outline btn-sm" href="<%= link({ mes: periodo.anterior, pagina: '' }) %>" aria-label="<%= t('clientes.mes_anterior') %>"><i class="ph ph-caret-left"></i></a>
        <strong class="clientes-periodo__mes"><%= _mesNome %></strong>
        <a class="btn btn-outline btn-sm" href="<%= link({ mes: periodo.proximo, pagina: '' }) %>" aria-label="<%= t('clientes.mes_seguinte') %>"><i class="ph ph-caret-right"></i></a>
    </div>
    <% if (periodo.mes !== periodo.atual) { %><a class="btn btn-outline btn-sm" href="<%= link({ mes: periodo.atual, pagina: '' }) %>"><%= t('clientes.este_mes') %></a><% } %>
    <a class="btn btn-outline btn-sm" href="<%= link({ mes: 'todos', pagina: '' }) %>"><%= t('clientes.todos_meses') %></a>
    <% } else { %>
    <strong class="clientes-periodo__mes"><%= _mesNome %></strong>
    <a class="btn btn-outline btn-sm" href="<%= link({ mes: periodo.atual, pagina: '' }) %>"><%= t('clientes.este_mes') %></a>
    <% } %>
</div>

<% if (estoque.sem || estoque.baixo) { %>
<div class="alert alert-aviso clientes-aviso">
    <i class="ph-bold ph-warning"></i>
    <span><%= t('produtos.alerta_estoque', { sem: estoque.sem, baixo: estoque.baixo }) %></span>
    <a class="btn btn-sm btn-outline" href="/clientes/produtos?estoque=baixo"><%= t('clientes.ver') %></a>
</div>
<% } %>

<% resumo.forEach(function (r) { %>
<section class="clientes-resumo">
    <% if (resumo.length > 1) { %><span class="badge badge-neutro"><%= r.moeda %></span><% } %>
    <div class="resumo-grid">
        <div class="card resumo-card">
            <span class="resumo-card__label"><%= t('vendas.card_faturamento') %></span>
            <span class="resumo-card__valor"><%= moeda(r.faturamento, r.moeda) %></span>
            <span class="resumo-card__sub muted"><%= t('vendas.vendas_unidades', { n: r.vendas, u: r.unidades }) %></span>
        </div>
        <div class="card resumo-card">
            <span class="resumo-card__label"><%= t('vendas.card_lucro') %></span>
            <span class="resumo-card__valor" style="color: <%= r.lucro < 0 ? 'var(--red)' : 'var(--green)' %>;"><%= moeda(r.lucro, r.moeda) %></span>
            <span class="resumo-card__sub muted">
                <% if (r.margem !== null) { %><%= t('vendas.margem', { pct: r.margem }) %><% } %>
                <% if (r.itensSemCusto) { %><%= r.margem !== null ? ' · ' : '' %><%= t('vendas.itens_sem_custo', { n: r.itensSemCusto }) %><% } %>
            </span>
        </div>
        <div class="card resumo-card">
            <span class="resumo-card__label"><%= t('vendas.card_recebido') %></span>
            <span class="resumo-card__valor" style="color: var(--green);"><%= moeda(r.recebido, r.moeda) %></span>
        </div>
        <div class="card resumo-card">
            <span class="resumo-card__label"><%= t('vendas.card_a_receber') %></span>
            <span class="resumo-card__valor" style="color: var(--pendente);"><%= moeda(r.aReceber, r.moeda) %></span>
            <% if (r.vencido > 0) { %><span class="resumo-card__sub" style="color: var(--red);"><%= t('vendas.vencido_valor', { valor: moeda(r.vencido, r.moeda) }) %></span><% } %>
        </div>
    </div>
</section>
<% }) %>

<% if (top.length) { %>
<section class="card venda-top">
    <h2 class="venda-secao__titulo"><i class="ph ph-trophy"></i> <%= t('vendas.mais_vendidos') %></h2>
    <ol class="venda-top__lista">
        <% top.forEach(function (p) { %>
        <li>
            <span class="venda-item__foto venda-item__foto--p"><% if (p.produto_id && p.foto_v) { %><img src="/clientes/produtos/<%= p.produto_id %>/foto?v=<%= p.foto_v %>" alt="" loading="lazy"><% } else { %><i class="ph ph-package"></i><% } %></span>
            <span class="venda-itens__nome"><%= p.nome %></span>
            <span class="muted"><%= t('vendas.unidades_n', { n: Number(p.unidades) }) %></span>
            <strong><%= moeda(p.faturamento, p.moeda) %></strong>
        </li>
        <% }) %>
    </ol>
</section>
<% } %>

<form method="get" action="/clientes/vendas" class="card clientes-filtros">
    <input type="hidden" name="mes" value="<%= periodo.mes %>">
    <input class="input" type="search" name="q" value="<%= filtro.q %>" placeholder="<%= t('vendas.buscar_ph') %>" aria-label="<%= t('clientes.buscar') %>">
    <select class="input" name="estado" aria-label="<%= t('clientes.filtro_estado') %>">
        <% ['todas', 'recebidas', 'a_receber', 'canceladas'].forEach(function (e) { %>
            <option value="<%= e === 'todas' ? '' : e %>" <%= filtro.estado === e ? 'selected' : '' %>><%= t('vendas.estado_' + e) %></option>
        <% }) %>
    </select>
    <button type="submit" class="btn btn-primary"><i class="ph ph-funnel"></i> <%= t('clientes.filtrar') %></button>
</form>

<div class="card tabela-wrapper clientes-tabela">
    <% if (!vendas.length) { %>
        <div style="padding: 20px;">
            <p class="muted" style="margin: 0 0 12px;"><%= filtro.q || filtro.estado !== 'todas' ? t('clientes.sem_resultados') : t('vendas.vazio_mes') %></p>
            <a class="btn btn-primary btn-sm" href="/clientes/vendas/nova"><i class="ph ph-plus-circle"></i> <%= t('vendas.nova') %></a>
        </div>
    <% } else { %>
    <table class="tabela">
        <thead>
            <tr>
                <th><%= t('vendas.col_venda') %></th>
                <th><%= t('clientes.col_cliente') %></th>
                <th><%= t('vendas.col_itens') %></th>
                <th class="tabela__num"><%= t('vendas.total') %></th>
                <th><%= t('vendas.col_pagamento') %></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        <% vendas.forEach(function (v) {
            const quitada = Number(v.lancadas) > 0 && Number(v.pagas) === Number(v.lancadas);
        %>
            <tr>
                <td><a href="/clientes/vendas/<%= v.id %>"><strong>#<%= v.numero %></strong></a><div class="muted" style="font-size: 12px;"><%= formatDate(v.data, 'DD/MM/YYYY') %></div></td>
                <td><a href="/clientes/<%= v.cliente_id %>"><strong><%= v.cliente_nome %></strong></a></td>
                <td class="venda-tabela__itens"><%= v.resumo %></td>
                <td class="tabela__num"><%= moeda(v.total, v.moeda) %></td>
                <td>
                    <% if (v.status !== 'ativa') { %><span class="badge badge-neutro"><%= t('vendas.st_cancelada') %></span>
                    <% } else if (quitada) { %><span class="badge badge-sucesso"><%= t('vendas.st_recebida') %></span>
                    <% } else if (Number(v.vencidas) > 0) { %><span class="badge badge-pendente"><%= t('vendas.st_vencidas', { n: v.vencidas }) %></span>
                    <% } else { %><span class="badge badge-alerta"><%= t('vendas.st_a_receber', { valor: moeda(v.a_receber, v.moeda) }) %></span><% } %>
                    <% if (v.status === 'ativa' && Number(v.parcelas) > 1) { %><div class="muted" style="font-size: 12px;"><%= t('clientes.pagaram_de', { pagas: v.pagas, total: v.lancadas }) %></div><% } %>
                </td>
                <td class="clientes-acoes"><a class="btn btn-outline btn-sm" href="/clientes/vendas/<%= v.id %>"><%= t('clientes.ver') %></a></td>
            </tr>
        <% }) %>
        </tbody>
    </table>
    <% } %>
</div>
<%- include('_paginacao', { pagina, paginas, hrefPagina: function (n) { return link({ pagina: n }); } }) %>
