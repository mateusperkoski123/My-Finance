<div class="page-header page-header--acoes">
    <div>
        <h1><i class="ph ph-users"></i> <%= t('clientes.titulo') %></h1>
        <p class="muted"><%= t('clientes.servicos_subtitulo') %></p>
    </div>
    <div class="page-header__botoes">
        <button type="button" class="btn btn-primary" data-modal-open="modal-novo-servico"><i class="ph ph-plus-circle"></i> <%= t('clientes.novo_servico') %></button>
    </div>
</div>

<%- include('_abas') %>

<div class="tabs" style="margin-bottom: 16px;">
    <a href="/clientes/servicos" class="tabs__item <%= !arquivados ? 'is-active' : '' %>"><%= t('clientes.servicos_ativos') %></a>
    <a href="/clientes/servicos?aba=arquivados" class="tabs__item <%= arquivados ? 'is-active' : '' %>"><%= t('clientes.servicos_arquivados') %></a>
</div>

<div class="card tabela-wrapper clientes-tabela">
    <% if (!servicos.length) { %>
        <p class="muted" style="padding: 20px; margin: 0;"><%= arquivados ? t('clientes.servicos_sem_arquivados') : t('clientes.servicos_vazio') %></p>
    <% } else { %>
    <table class="tabela">
        <thead>
            <tr>
                <th><%= t('clientes.campo_servico') %></th>
                <th class="tabela__num"><%= t('clientes.valor_padrao') %></th>
                <th><%= t('clientes.dia_padrao') %></th>
                <th class="tabela__num"><%= t('clientes.col_contratos') %></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        <% servicos.forEach(function (s) { %>
            <tr>
                <td><strong><%= s.nome %></strong></td>
                <td class="tabela__num"><%= Number(s.valor_padrao) > 0 ? moeda(s.valor_padrao) : '-' %></td>
                <td><%= s.dia_vencimento ? t('clientes.vence_dia', { dia: s.dia_vencimento }) : '-' %></td>
                <td class="tabela__num"><%= s.contratos_ativos %></td>
                <td class="clientes-acoes">
                    <% if (!arquivados) { %>
                    <button type="button" class="btn btn-outline btn-sm" data-modal-open="modal-servico-<%= s.id %>"><i class="ph ph-pencil-simple"></i> <%= t('clientes.editar') %></button>
                    <form method="post" action="/clientes/servicos/<%= s.id %>/arquivar" style="display: inline;" <% if (Number(s.contratos_ativos) > 0) { %>data-confirm="<%= t('clientes.confirmar_arquivar_servico') %>"<% } %>>
                        <%- csrfCampo %>
                        <button type="submit" class="btn btn-outline btn-sm"><i class="ph ph-archive"></i> <%= t('clientes.arquivar') %></button>
                    </form>
                    <% } else { %>
                    <form method="post" action="/clientes/servicos/<%= s.id %>/arquivar" style="display: inline;">
                        <%- csrfCampo %><input type="hidden" name="acao" value="restaurar">
                        <button type="submit" class="btn btn-outline btn-sm"><i class="ph ph-arrow-counter-clockwise"></i> <%= t('clientes.restaurar') %></button>
                    </form>
                    <% } %>
                </td>
            </tr>
        <% }) %>
        </tbody>
    </table>
    <% } %>
</div>
<p class="muted" style="font-size: 13px; margin-top: 12px;"><i class="ph ph-info"></i> <%= t('clientes.servicos_ajuda_categoria') %></p>

<%# Formulario de servico: novo (id 0) ou existente. %>
<% const _form = function (idModal, acao, titulo, s) { %>
<div class="modal-backdrop" id="<%= idModal %>" data-modal>
    <div class="modal card">
        <div class="modal__header">
            <h3><%= titulo %></h3>
            <button type="button" class="modal__fechar" data-modal-close aria-label="<%= t('comum.fechar') %>"><i class="ph ph-x"></i></button>
        </div>
        <form method="post" action="<%= acao %>" class="form">
            <%- csrfCampo %>
            <div class="form-group">
                <label><%= t('clientes.nome_servico') %> *</label>
                <input class="input" type="text" name="nome" maxlength="120" required value="<%= s ? s.nome : '' %>">
            </div>
            <div class="form-group">
                <label><%= t('clientes.valor_padrao') %></label>
                <input class="input" type="text" name="valor" data-money value="<%= s && Number(s.valor_padrao) > 0 ? Number(s.valor_padrao) : '' %>">
            </div>
            <div class="form-group">
                <label><%= t('clientes.dia_padrao') %></label>
                <input class="input" type="number" name="dia" min="1" max="31" value="<%= s && s.dia_vencimento ? s.dia_vencimento : '' %>">
            </div>
            <p class="muted" style="font-size: 13px;"><%= t('clientes.servico_ajuda') %></p>
            <div class="modal__actions">
                <button type="button" class="btn btn-outline" data-modal-close><%= t('clientes.cancelar') %></button>
                <button type="submit" class="btn btn-primary"><i class="ph ph-floppy-disk"></i> <%= t('clientes.salvar') %></button>
            </div>
        </form>
    </div>
</div>
<% }; %>
<% _form('modal-novo-servico', '/clientes/servicos/criar', t('clientes.novo_servico'), null); %>
<% if (!arquivados) { servicos.forEach(function (s) { _form('modal-servico-' + s.id, '/clientes/servicos/' + s.id + '/atualizar', t('clientes.editar') + ' · ' + s.nome, s); }); } %>
