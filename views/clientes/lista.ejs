<%
    const _href = function (extra) {
        const p = new URLSearchParams();
        const todo = Object.assign({ status: status === 'ativo' ? '' : status, q: q }, extra);
        Object.keys(todo).forEach(function (k) { if (todo[k] !== '' && todo[k] !== undefined) p.set(k, todo[k]); });
        const s = p.toString();
        return '/clientes/lista' + (s ? '?' + s : '');
    };
%>
<div class="page-header page-header--acoes">
    <div>
        <h1><i class="ph ph-users"></i> <%= t('clientes.titulo') %></h1>
        <p class="muted"><%= t('clientes.subtitulo') %></p>
    </div>
    <div class="page-header__botoes">
        <button type="button" class="btn btn-primary" data-modal-open="modal-novo-cliente"><i class="ph ph-user-plus"></i> <%= t('clientes.novo') %></button>
    </div>
</div>

<%- include('_abas') %>

<div class="clientes-barra">
    <div class="tabs">
        <a href="<%= _href({ status: '', pagina: '' }) %>" class="tabs__item <%= status === 'ativo' ? 'is-active' : '' %>"><%= t('clientes.ativos_n', { n: totais.ativos }) %></a>
        <a href="<%= _href({ status: 'inativo', pagina: '' }) %>" class="tabs__item <%= status === 'inativo' ? 'is-active' : '' %>"><%= t('clientes.inativos_n', { n: totais.inativos }) %></a>
    </div>
    <form method="get" action="/clientes/lista" class="clientes-busca">
        <% if (status !== 'ativo') { %><input type="hidden" name="status" value="<%= status %>"><% } %>
        <input class="input" type="search" name="q" value="<%= q %>" placeholder="<%= t('clientes.buscar_ph') %>" aria-label="<%= t('clientes.buscar') %>">
        <button type="submit" class="btn btn-outline"><i class="ph ph-magnifying-glass"></i> <%= t('clientes.buscar') %></button>
    </form>
</div>

<div class="card tabela-wrapper clientes-tabela">
    <% if (!clientes.length) { %>
        <p class="muted" style="padding: 20px; margin: 0;"><%= q ? t('clientes.sem_resultados') : t('clientes.lista_vazia') %></p>
    <% } else { %>
    <form method="post" action="/clientes/excluir-lote" id="form-lote" class="clientes-lote" hidden>
        <%- csrfCampo %>
        <input type="hidden" name="todos" id="lote-todos-campo" value="">
        <input type="hidden" name="q" value="<%= q %>">
        <input type="hidden" name="status" value="<%= status %>">
        <div class="clientes-lote__topo">
            <span class="muted" id="lote-contagem"></span>
            <button type="button" class="link-botao" id="lote-todas-paginas" hidden></button>
            <button type="button" class="link-botao" id="lote-limpar" hidden><%= t('clientes.lote_todos_limpar') %></button>
        </div>
        <label class="clientes-lote__pagas"><input type="checkbox" name="incluir_pagas" value="1" id="lote-pagas"> <span><%= t('clientes.lote_incluir_pagas') %></span></label>
        <button type="submit" class="btn btn-danger"><i class="ph ph-trash"></i> <%= t('clientes.lote_excluir') %></button>
    </form>
    <table class="tabela">
        <thead>
            <tr>
                <th style="width: 32px;"><input type="checkbox" id="lote-todos" aria-label="<%= t('clientes.selecionar_todos') %>"></th>
                <th><%= t('clientes.campo_nome') %></th>
                <th><%= t('clientes.campo_celular') %></th>
                <th><%= t('clientes.campo_cedula') %></th>
                <th class="tabela__num"><%= t('clientes.col_contratos') %></th>
                <th><%= t('clientes.col_situacao') %></th>
            </tr>
        </thead>
        <tbody>
        <% clientes.forEach(function (c) { %>
            <tr>
                <td><input type="checkbox" class="lote-item" name="ids" value="<%= c.id %>" form="form-lote" aria-label="<%= t('clientes.selecionar') %>"></td>
                <td><a href="/clientes/<%= c.id %>"><strong><%= c.nome %></strong></a><% if (c.email) { %><div class="muted" style="font-size: 12px;"><%= c.email %></div><% } %></td>
                <td><%= c.celular || '-' %></td>
                <td><%= c.cedula || c.ruc || '-' %></td>
                <td class="tabela__num"><%= c.contratos_ativos %></td>
                <td>
                    <% if (c.status === 'inativo') { %><span class="badge badge-neutro"><%= t('clientes.inativo') %></span>
                    <% } else if (Number(c.vencidas) > 0) { %><span class="badge badge-pendente"><%= t('clientes.vencidas_n', { n: c.vencidas }) %></span>
                    <% } else if (Number(c.contratos_ativos) > 0) { %><span class="badge badge-sucesso"><%= t('clientes.em_dia') %></span>
                    <% } else { %><span class="badge badge-neutro"><%= t('clientes.sem_contrato') %></span><% } %>
                </td>
            </tr>
        <% }) %>
        </tbody>
    </table>
    <% } %>
</div>

<% if (clientes.length) { %>
<script>
(function () {
    var form = document.getElementById('form-lote');
    var todos = document.getElementById('lote-todos');
    var itens = Array.prototype.slice.call(document.querySelectorAll('.lote-item'));
    var contagem = document.getElementById('lote-contagem');
    var campoTodos = document.getElementById('lote-todos-campo');
    var linkPaginas = document.getElementById('lote-todas-paginas');
    var limpar = document.getElementById('lote-limpar');
    var pagas = document.getElementById('lote-pagas');
    var TOTAL = <%= totalFiltrado %>;
    var T = {
        sel: <%- JSON.stringify(t('clientes.lote_selecionados', { n: '{n}' })) %>,
        pagina: <%- JSON.stringify(t('clientes.lote_todos_pagina', { n: '{n}' })) %>,
        link: <%- JSON.stringify(t('clientes.lote_todos_link', { total: '{total}' })) %>,
        ativo: <%- JSON.stringify(t('clientes.lote_todos_ativo', { total: '{total}' })) %>,
        confirmar: <%- JSON.stringify(t('clientes.lote_confirmar', { n: '{n}' })) %>,
        confirmarTudo: <%- JSON.stringify(t('clientes.lote_confirmar_tudo', { n: '{n}' })) %>
    };
    function marcados() { return itens.filter(function (i) { return i.checked; }).length; }
    function atualizar() {
        var todasPaginas = campoTodos.value === '1';
        var n = todasPaginas ? TOTAL : marcados();
        form.hidden = n === 0;
        contagem.textContent = todasPaginas ? T.ativo.replace('{total}', TOTAL) : T.sel.replace('{n}', n);
        // so oferece "todas as paginas" quando a pagina inteira esta marcada e existem mais clientes na busca
        linkPaginas.hidden = todasPaginas || !(marcados() === itens.length && TOTAL > itens.length);
        if (!linkPaginas.hidden) linkPaginas.textContent = T.link.replace('{total}', TOTAL);
        limpar.hidden = !todasPaginas;
        todos.checked = todasPaginas || (marcados() > 0 && marcados() === itens.length);
        todos.indeterminate = !todasPaginas && marcados() > 0 && marcados() < itens.length;
        form.setAttribute('data-confirm', (pagas.checked ? T.confirmarTudo : T.confirmar).replace('{n}', n));
    }
    todos.addEventListener('change', function () {
        campoTodos.value = '';
        itens.forEach(function (i) { i.checked = todos.checked; });
        atualizar();
    });
    itens.forEach(function (i) { i.addEventListener('change', function () { campoTodos.value = ''; atualizar(); }); });
    linkPaginas.addEventListener('click', function () { campoTodos.value = '1'; atualizar(); });
    limpar.addEventListener('click', function () { campoTodos.value = ''; itens.forEach(function (i) { i.checked = false; }); atualizar(); });
    pagas.addEventListener('change', atualizar);
    atualizar();
})();
</script>
<% } %>
<%- include('_paginacao', { pagina, paginas, hrefPagina: function (n) { return _href({ pagina: n }); } }) %>
<%- include('_modal_cliente', { idModal: 'modal-novo-cliente', acao: '/clientes/criar', titulo: t('clientes.novo'), cliente: null }) %>
