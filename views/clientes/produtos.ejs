<%
    const _fotoUrl = (p) => p.foto_v ? '/clientes/produtos/' + p.id + '/foto?v=' + p.foto_v : '';
    const _lucroUn = (p) => p.custo === null ? null : Number(p.preco) - Number(p.custo);
%>
<div class="page-header page-header--acoes">
    <div>
        <h1><i class="ph ph-users"></i> <%= t('clientes.titulo') %></h1>
        <p class="muted"><%= t('produtos.subtitulo') %></p>
    </div>
    <div class="page-header__botoes">
        <a class="btn btn-outline" href="/clientes/vendas/nova"><i class="ph ph-shopping-bag"></i> <%= t('vendas.nova') %></a>
        <button type="button" class="btn btn-primary" data-produto-novo><i class="ph ph-plus-circle"></i> <%= t('produtos.novo') %></button>
    </div>
</div>

<%- include('_abas') %>

<% if (!arquivados && (totais.sem || totais.baixo) && estoque !== 'baixo') { %>
<div class="alert alert-aviso clientes-aviso">
    <i class="ph-bold ph-warning"></i>
    <span><%= t('produtos.alerta_estoque', { sem: totais.sem, baixo: totais.baixo }) %></span>
    <a class="btn btn-sm btn-outline" href="/clientes/produtos?estoque=baixo"><%= t('clientes.ver') %></a>
</div>
<% } %>

<div class="clientes-barra">
    <div class="tabs">
        <a href="/clientes/produtos" class="tabs__item <%= !arquivados && estoque !== 'baixo' ? 'is-active' : '' %>"><%= t('produtos.ativos') %></a>
        <% if (estoque === 'baixo') { %><a href="/clientes/produtos?estoque=baixo" class="tabs__item is-active"><%= t('produtos.filtro_estoque_baixo') %></a><% } %>
        <a href="/clientes/produtos?aba=arquivados" class="tabs__item <%= arquivados ? 'is-active' : '' %>"><%= t('produtos.arquivados') %></a>
    </div>
    <form method="get" action="/clientes/produtos" class="clientes-busca produtos-busca">
        <% if (arquivados) { %><input type="hidden" name="aba" value="arquivados"><% } %>
        <% if (estoque) { %><input type="hidden" name="estoque" value="<%= estoque %>"><% } %>
        <input class="input" type="search" name="q" value="<%= q %>" placeholder="<%= t('produtos.buscar_ph') %>" aria-label="<%= t('clientes.buscar') %>">
        <button type="submit" class="btn btn-outline"><i class="ph ph-magnifying-glass"></i></button>
    </form>
</div>

<% if (!produtos.length) { %>
    <div class="card placeholder-card">
        <p class="muted" style="margin: 0 0 12px;"><%= q ? t('clientes.sem_resultados') : (arquivados ? t('produtos.sem_arquivados') : (estoque === 'baixo' ? t('produtos.sem_estoque_baixo') : t('produtos.vazio'))) %></p>
        <% if (!arquivados && !q && !estoque) { %><button type="button" class="btn btn-primary" data-produto-novo><i class="ph ph-plus-circle"></i> <%= t('produtos.novo') %></button><% } %>
    </div>
<% } else { %>
<div class="produtos-grid">
    <% produtos.forEach(function (p) {
        const sit = situacaoEstoque(p);
        const lucro = _lucroUn(p);
        const margem = lucro !== null && Number(p.preco) > 0 ? Math.round(lucro / Number(p.preco) * 100) : null;
    %>
    <article class="card produto-card">
        <div class="produto-card__foto">
            <% if (p.foto_v) { %><img src="<%= _fotoUrl(p) %>" alt="" loading="lazy"><% } else { %><i class="ph ph-package"></i><% } %>
            <% if (sit === 'sem') { %><span class="badge badge-pendente produto-card__selo"><%= t('produtos.sem_estoque') %></span>
            <% } else if (sit === 'baixo') { %><span class="badge badge-alerta produto-card__selo"><%= t('produtos.estoque_baixo') %></span><% } %>
        </div>
        <div class="produto-card__corpo">
            <strong class="produto-card__nome"><%= p.nome %></strong>
            <span class="produto-card__preco"><%= moeda(p.preco) %></span>
            <% if (lucro !== null) { %>
                <span class="muted produto-card__linha"><%= t('produtos.custo_lucro', { custo: moeda(p.custo), lucro: moeda(lucro) }) %><% if (margem !== null) { %> (<%= margem %>%)<% } %></span>
            <% } else { %>
                <span class="muted produto-card__linha"><%= t('produtos.sem_custo') %></span>
            <% } %>
            <span class="produto-card__linha">
                <% if (sit === null) { %><span class="muted"><%= t('produtos.sem_controle') %></span>
                <% } else { %><i class="ph ph-stack"></i> <%= t('produtos.em_estoque', { n: p.estoque }) %><% } %>
                <span class="muted"> · <%= t('produtos.vendidos_n', { n: Number(p.vendidos) }) %></span>
            </span>
        </div>
        <div class="produto-card__acoes">
            <% if (!arquivados) { %>
            <% if (sit !== 'sem') { %><a class="btn btn-primary btn-sm" href="/clientes/vendas/nova?produto=<%= p.id %>"><i class="ph ph-shopping-bag"></i> <%= t('produtos.vender') %></a><% } %>
            <button type="button" class="btn btn-outline btn-sm" aria-label="<%= t('clientes.editar') %>" title="<%= t('clientes.editar') %>" data-produto-editar="<%= JSON.stringify({ id: p.id, nome: p.nome, descricao: p.descricao || '', preco: Number(p.preco), custo: p.custo === null ? null : Number(p.custo), estoque: p.estoque, minimo: p.estoque_minimo, foto: _fotoUrl(p) }) %>"><i class="ph ph-pencil-simple"></i><% if (sit === 'sem') { %> <%= t('clientes.editar') %><% } %></button>
            <form method="post" action="/clientes/produtos/<%= p.id %>/arquivar" style="display: inline;" data-confirm="<%= t('produtos.confirmar_arquivar') %>">
                <%- csrfCampo %>
                <button type="submit" class="btn btn-outline btn-sm" aria-label="<%= t('clientes.arquivar') %>" title="<%= t('clientes.arquivar') %>"><i class="ph ph-archive"></i></button>
            </form>
            <% } else { %>
            <form method="post" action="/clientes/produtos/<%= p.id %>/arquivar" style="display: inline;">
                <%- csrfCampo %><input type="hidden" name="acao" value="restaurar">
                <button type="submit" class="btn btn-outline btn-sm"><i class="ph ph-arrow-counter-clockwise"></i> <%= t('clientes.restaurar') %></button>
            </form>
            <% } %>
        </div>
    </article>
    <% }) %>
</div>
<% } %>
<p class="muted" style="font-size: 13px; margin-top: 12px;"><i class="ph ph-info"></i> <%= t('produtos.ajuda_categoria') %></p>

<div class="modal-backdrop" id="modal-produto" data-modal>
    <div class="modal card">
        <div class="modal__header">
            <h3 id="produto-titulo"><%= t('produtos.novo') %></h3>
            <button type="button" class="modal__fechar" data-modal-close aria-label="<%= t('comum.fechar') %>"><i class="ph ph-x"></i></button>
        </div>
        <form method="post" action="/clientes/produtos/criar?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="form" id="form-produto">
            <div class="produto-foto-campo">
                <div class="produto-foto-campo__previa" id="produto-previa"><i class="ph ph-image"></i></div>
                <div class="produto-foto-campo__botoes">
                    <label class="btn btn-outline btn-sm" for="produto-arquivo"><i class="ph ph-camera"></i> <span id="produto-foto-rotulo"><%= t('produtos.foto_escolher') %></span></label>
                    <input type="file" id="produto-arquivo" name="foto" accept="image/jpeg,image/png,image/webp,image/*" hidden>
                    <label class="produto-foto-campo__remover" id="produto-remover-rotulo" hidden><input type="checkbox" name="remover_foto" value="1" id="produto-remover"> <%= t('produtos.foto_remover') %></label>
                    <span class="muted" style="font-size: 12px;"><%= t('produtos.foto_ajuda') %></span>
                    <span class="erro-campo" id="produto-foto-erro" hidden></span>
                </div>
            </div>
            <div class="form-group">
                <label for="produto-nome"><%= t('produtos.campo_nome') %> *</label>
                <input class="input" type="text" id="produto-nome" name="nome" maxlength="120" required>
            </div>
            <div class="form-group">
                <label for="produto-descricao"><%= t('produtos.campo_descricao') %></label>
                <textarea class="input" id="produto-descricao" name="descricao" maxlength="500" rows="2"></textarea>
            </div>
            <div class="clientes-fila">
                <div class="form-group">
                    <label for="produto-preco"><%= t('produtos.campo_preco') %> *</label>
                    <input class="input" type="text" id="produto-preco" name="preco" data-money required>
                </div>
                <div class="form-group">
                    <label for="produto-custo"><%= t('produtos.campo_custo') %></label>
                    <input class="input" type="text" id="produto-custo" name="custo" data-money>
                </div>
            </div>
            <p class="muted" style="font-size: 13px; margin-top: -4px;" id="produto-margem"><%= t('produtos.custo_ajuda') %></p>
            <label class="produto-check">
                <input type="checkbox" name="controla_estoque" value="1" id="produto-controla">
                <span><strong><%= t('produtos.campo_controla') %></strong><br><span class="muted" style="font-size: 13px;"><%= t('produtos.controla_ajuda') %></span></span>
            </label>
            <div class="clientes-fila" id="produto-estoque-campos" hidden>
                <div class="form-group">
                    <label for="produto-estoque"><%= t('produtos.campo_estoque') %></label>
                    <input class="input" type="number" id="produto-estoque" name="estoque" min="0" max="9999999" step="1" inputmode="numeric">
                </div>
                <div class="form-group">
                    <label for="produto-minimo"><%= t('produtos.campo_minimo') %></label>
                    <input class="input" type="number" id="produto-minimo" name="estoque_minimo" min="0" max="9999999" step="1" inputmode="numeric" placeholder="<%= t('produtos.minimo_ph') %>">
                </div>
            </div>
            <div class="modal__actions">
                <button type="button" class="btn btn-outline" data-modal-close><%= t('clientes.cancelar') %></button>
                <button type="submit" class="btn btn-primary" id="produto-salvar"><i class="ph ph-floppy-disk"></i> <%= t('clientes.salvar') %></button>
            </div>
        </form>
    </div>
</div>

<script>
// Formulario do produto (novo e editar no mesmo modal). A foto e reduzida no proprio aparelho (lado maior 900 px, JPEG)
// antes do envio: a foto do celular (varios MB) vira poucas centenas de KB.
(function () {
    const TXT = <%- JSON.stringify({
        novo: t('produtos.novo'), editar: t('clientes.editar'), escolher: t('produtos.foto_escolher'), trocar: t('produtos.foto_trocar'),
        erroTipo: t('produtos.erro_foto_tipo'), erroGrande: t('produtos.erro_foto_grande'),
        margem: t('produtos.margem_un'), prejuizo: t('produtos.prejuizo_un'), ajuda: t('produtos.custo_ajuda')
    }) %>;
    const CSRF = <%- JSON.stringify(csrfToken) %>;
    const LADO = 900;
    const MAX_ORIGINAL = 1536 * 1024;
    const modal = document.getElementById('modal-produto');
    const form = document.getElementById('form-produto');
    const arquivo = document.getElementById('produto-arquivo');
    const previa = document.getElementById('produto-previa');
    const rotulo = document.getElementById('produto-foto-rotulo');
    const erro = document.getElementById('produto-foto-erro');
    const remover = document.getElementById('produto-remover');
    const removerRotulo = document.getElementById('produto-remover-rotulo');
    const controla = document.getElementById('produto-controla');
    const camposEstoque = document.getElementById('produto-estoque-campos');
    const preco = document.getElementById('produto-preco');
    const custo = document.getElementById('produto-custo');
    const margem = document.getElementById('produto-margem');
    let fotoAtual = '';

    const numero = (el) => (window.AppRegras ? window.AppRegras.parseMoeda(el.value) : parseFloat(el.value)) || 0;
    const formatar = (v) => (window.gfFormatarValorMoeda ? window.gfFormatarValorMoeda(v) : String(v));
    const fmtMoeda = formatar;

    function mostrarPrevia(url) {
        previa.textContent = '';
        if (url) { const i = document.createElement('img'); i.alt = ''; i.src = url; previa.appendChild(i); }
        else { const ic = document.createElement('i'); ic.className = 'ph ph-image'; previa.appendChild(ic); }
        rotulo.textContent = url ? TXT.trocar : TXT.escolher;
    }
    function mostrarErro(msg) { erro.textContent = msg || ''; erro.hidden = !msg; }

    function atualizarEstoque() { camposEstoque.hidden = !controla.checked; }
    function atualizarMargem() {
        const p = numero(preco), c = custo.value.trim() ? numero(custo) : null;
        if (c === null || !(p > 0)) { margem.textContent = TXT.ajuda; margem.classList.remove('produto-margem--negativa'); return; }
        const l = p - c;
        margem.textContent = (l >= 0 ? TXT.margem : TXT.prejuizo).replace('{valor}', fmtMoeda(Math.abs(l))).replace('{pct}', Math.round(l / p * 100));
        margem.classList.toggle('produto-margem--negativa', l < 0);
    }

    function abrir(p) {
        form.reset();
        mostrarErro('');
        fotoAtual = p ? p.foto : '';
        document.getElementById('produto-titulo').textContent = p ? TXT.editar + ' · ' + p.nome : TXT.novo;
        form.action = (p ? '/clientes/produtos/' + p.id + '/atualizar' : '/clientes/produtos/criar') + '?_csrf=' + encodeURIComponent(CSRF);
        document.getElementById('produto-nome').value = p ? p.nome : '';
        document.getElementById('produto-descricao').value = p ? p.descricao : '';
        preco.value = p && p.preco > 0 ? formatar(p.preco) : '';
        custo.value = p && p.custo !== null ? formatar(p.custo) : '';
        controla.checked = Boolean(p && p.estoque !== null && p.estoque !== undefined);
        document.getElementById('produto-estoque').value = controla.checked ? p.estoque : '';
        document.getElementById('produto-minimo').value = p && p.minimo !== null && p.minimo !== undefined ? p.minimo : '';
        removerRotulo.hidden = !fotoAtual;
        remover.checked = false;
        mostrarPrevia(fotoAtual);
        atualizarEstoque();
        atualizarMargem();
        modal.classList.add('is-open');
        setTimeout(function () { document.getElementById('produto-nome').focus(); }, 50);
    }

    async function carregarImagem(arq) {
        if (window.createImageBitmap) {
            try { return await createImageBitmap(arq, { imageOrientation: 'from-image' }); } catch (e) { /* metodo classico */ }
        }
        return new Promise(function (resolve, reject) {
            const url = URL.createObjectURL(arq);
            const img = new Image();
            img.onload = function () { URL.revokeObjectURL(url); resolve(img); };
            img.onerror = function () { URL.revokeObjectURL(url); reject(new Error('imagem')); };
            img.src = url;
        });
    }

    // Reduz para no maximo LADO x LADO (sem cortar) e devolve o JPEG.
    async function reduzir(arq) {
        const img = await carregarImagem(arq);
        const w = img.width || img.naturalWidth, h = img.height || img.naturalHeight;
        if (!w || !h) throw new Error('imagem');
        const esc = Math.min(1, LADO / Math.max(w, h));
        const c = document.createElement('canvas');
        c.width = Math.round(w * esc); c.height = Math.round(h * esc);
        const ctx = c.getContext('2d');
        ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, c.width, c.height);
        ctx.drawImage(img, 0, 0, c.width, c.height);
        const blob = await new Promise(function (res) { c.toBlob(res, 'image/jpeg', 0.82); });
        if (!blob) throw new Error('imagem');
        return blob;
    }

    arquivo.addEventListener('change', async function () {
        const arq = arquivo.files && arquivo.files[0];
        mostrarErro('');
        if (!arq) { mostrarPrevia(fotoAtual); return; }
        if (!/^image\//.test(arq.type)) { arquivo.value = ''; mostrarErro(TXT.erroTipo); return; }
        try {
            const blob = await reduzir(arq);
            if (window.DataTransfer) {
                const dt = new DataTransfer();
                dt.items.add(new File([blob], 'produto.jpg', { type: 'image/jpeg' }));
                arquivo.files = dt.files;
            } else if (arq.size > MAX_ORIGINAL) {
                arquivo.value = ''; mostrarErro(TXT.erroGrande); return;
            }
            mostrarPrevia(URL.createObjectURL(blob));
            remover.checked = false;
        } catch (e) {
            arquivo.value = '';
            mostrarErro(TXT.erroTipo);
            mostrarPrevia(fotoAtual);
        }
    });
    remover.addEventListener('change', function () {
        if (remover.checked) { arquivo.value = ''; mostrarPrevia(''); }
        else mostrarPrevia(fotoAtual);
    });
    controla.addEventListener('change', function () {
        atualizarEstoque();
        if (controla.checked && !document.getElementById('produto-estoque').value) document.getElementById('produto-estoque').value = '0';
    });
    preco.addEventListener('input', atualizarMargem);
    custo.addEventListener('input', atualizarMargem);
    form.addEventListener('submit', function () { document.getElementById('produto-salvar').disabled = true; });

    document.addEventListener('click', function (e) {
        if (e.target.closest('[data-produto-novo]')) { abrir(null); return; }
        const b = e.target.closest('[data-produto-editar]');
        if (b) { try { abrir(JSON.parse(b.getAttribute('data-produto-editar'))); } catch (err) { /* dado invalido */ } }
    });
})();
</script>
