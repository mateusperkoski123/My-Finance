<%
    const _todos = periodo.mes === 'todos';
    const _mesNome = _todos ? t('clientes.todos_meses') : new Date(Date.UTC(periodo.ano, periodo.numero - 1, 1)).toLocaleDateString(lang, { month: 'long', year: 'numeric', timeZone: 'UTC' });
    const _hojeP = hoje.split('-').map(Number);
    const _atraso = (venc) => Math.max(0, Math.round((Date.UTC(_hojeP[0], _hojeP[1] - 1, _hojeP[2]) - Date.UTC(+venc.slice(0, 4), +venc.slice(5, 7) - 1, +venc.slice(8, 10))) / 86400000));
    const _voltar = link({ pagina: '' });
%>
<div class="page-header page-header--acoes">
    <div>
        <h1><i class="ph ph-users"></i> <%= t('clientes.titulo') %></h1>
        <p class="muted"><%= t('clientes.subtitulo') %></p>
    </div>
    <div class="page-header__botoes">
        <button type="button" class="btn btn-primary" data-modal-open="modal-novo-cliente"><i class="ph ph-user-plus"></i> <%= t('clientes.novo') %></button>
    </div>
</div>

<%- include('_abas') %>

<div class="clientes-periodo">
    <% if (!_todos) { %>
    <div class="periodo-nav" style="display: inline-flex; align-items: center; gap: 4px;">
        <a class="btn btn-outline btn-sm" href="<%= link({ mes: periodo.anterior, dia: '', pagina: '' }) %>" aria-label="<%= t('clientes.mes_anterior') %>"><i class="ph ph-caret-left"></i></a>
        <strong class="clientes-periodo__mes"><%= _mesNome %></strong>
        <a class="btn btn-outline btn-sm" href="<%= link({ mes: periodo.proximo, dia: '', pagina: '' }) %>" aria-label="<%= t('clientes.mes_seguinte') %>"><i class="ph ph-caret-right"></i></a>
    </div>
    <% if (periodo.mes !== periodo.atual) { %><a class="btn btn-outline btn-sm" href="<%= link({ mes: periodo.atual, dia: '', pagina: '' }) %>"><%= t('clientes.este_mes') %></a><% } %>
    <% } else { %>
    <strong class="clientes-periodo__mes"><%= _mesNome %></strong>
    <a class="btn btn-outline btn-sm" href="<%= link({ mes: periodo.atual, estado: '', pagina: '' }) %>"><%= t('clientes.este_mes') %></a>
    <% } %>
    <span class="muted clientes-periodo__ativos"><i class="ph ph-user-check"></i> <%= t('clientes.ativos_n', { n: totais.ativos }) %></span>
</div>

<% if (acumulado.length && !_todos) { %>
    <% acumulado.forEach(function (a) { %>
    <div class="alert alert-erro clientes-aviso">
        <i class="ph-bold ph-warning-circle"></i>
        <span><%= t('clientes.acumulado_aviso', { cuotas: a.n, clientes: a.clientes, valor: moeda(a.valor, a.moeda) }) %></span>
        <a class="btn btn-sm btn-outline" href="<%= link({ mes: 'todos', estado: 'vencidas', dia: '', pagina: '' }) %>"><%= t('clientes.ver') %></a>
    </div>
    <% }) %>
<% } %>

<% if (!resumo.length) { %>
    <div class="card placeholder-card"><p class="muted" style="margin: 0;"><%= t('clientes.sem_cuotas_mes') %></p></div>
<% } %>
<% resumo.forEach(function (r) {
    const _pc = Number(r.total_v) > 0 ? Math.round(Number(r.pagas_v) / Number(r.total_v) * 100) : 0;
%>
<section class="clientes-resumo">
    <% if (resumo.length > 1) { %><span class="badge badge-neutro"><%= r.moeda %></span><% } %>
    <div class="resumo-grid">
        <div class="card resumo-card">
            <span class="resumo-card__label"><%= t('clientes.card_esperado') %></span>
            <span class="resumo-card__valor"><%= moeda(r.total_v, r.moeda) %></span>
            <span class="resumo-card__sub muted"><%= t('clientes.cuotas_n', { n: r.total_n }) %></span>
        </div>
        <div class="card resumo-card">
            <span class="resumo-card__label"><%= t('clientes.card_pagas') %></span>
            <span class="resumo-card__valor" style="color: var(--green);"><%= moeda(r.pagas_v, r.moeda) %></span>
            <span class="resumo-card__sub muted"><%= t('clientes.cuotas_n', { n: r.pagas_n }) %></span>
        </div>
        <div class="card resumo-card">
            <span class="resumo-card__label"><%= t('clientes.card_pendentes') %></span>
            <span class="resumo-card__valor" style="color: var(--pendente);"><%= moeda(r.pendentes_v, r.moeda) %></span>
            <span class="resumo-card__sub muted"><%= t('clientes.cuotas_n', { n: r.pendentes_n }) %></span>
        </div>
        <div class="card resumo-card">
            <span class="resumo-card__label"><%= t('clientes.card_vencidas') %></span>
            <span class="resumo-card__valor" style="color: var(--red);"><%= moeda(r.vencidas_v, r.moeda) %></span>
            <span class="resumo-card__sub muted"><%= t('clientes.cuotas_n', { n: r.vencidas_n }) %></span>
        </div>
    </div>
    <div class="card clientes-progresso">
        <div class="clientes-progresso__topo"><span><%= t('clientes.cobrado_pct', { pct: _pc }) %></span><span class="muted"><%= t('clientes.pagaram_de', { pagas: r.pagas_n, total: r.total_n }) %></span></div>
        <div class="progresso" role="progressbar" aria-valuenow="<%= _pc %>" aria-valuemin="0" aria-valuemax="100"><span style="width: <%= _pc %>%;"></span></div>
    </div>
</section>
<% }) %>

<form method="get" action="/clientes" class="card clientes-filtros">
    <input type="hidden" name="mes" value="<%= periodo.mes %>">
    <% if (filtro.dia) { %><input type="hidden" name="dia" value="<%= filtro.dia %>"><% } %>
    <input class="input" type="search" name="q" value="<%= filtro.q %>" placeholder="<%= t('clientes.buscar_ph') %>" aria-label="<%= t('clientes.buscar') %>">
    <select class="input" name="estado" aria-label="<%= t('clientes.filtro_estado') %>">
        <% ['todas', 'pagas', 'pendentes', 'vencidas'].forEach(function (e) { %>
            <option value="<%= e === 'todas' ? '' : e %>" <%= filtro.estado === e ? 'selected' : '' %>><%= t('clientes.estado_' + e) %></option>
        <% }) %>
    </select>
    <select class="input" name="servico" aria-label="<%= t('clientes.filtro_servico') %>">
        <option value=""><%= t('clientes.todos_servicos') %></option>
        <% servicos.forEach(function (s) { %><option value="<%= s.id %>" <%= filtro.servico === s.id ? 'selected' : '' %>><%= s.nome %></option><% }) %>
    </select>
    <button type="submit" class="btn btn-primary"><i class="ph ph-funnel"></i> <%= t('clientes.filtrar') %></button>
</form>

<% if (filtro.dia) { %>
<div class="clientes-aviso alert alert-aviso"><i class="ph ph-calendar-check"></i> <span><%= t('clientes.so_dia', { data: formatDate(filtro.dia, 'DD/MM/YYYY') }) %></span> <a class="btn btn-sm btn-outline" href="<%= link({ dia: '', pagina: '' }) %>"><%= t('clientes.ver_mes') %></a></div>
<% } %>

<div class="card tabela-wrapper clientes-tabela">
    <% if (!cuotas.length) { %>
        <p class="muted" style="padding: 20px; margin: 0;"><%= t('clientes.sem_resultados') %></p>
    <% } else { %>
    <table class="tabela">
        <thead>
            <tr>
                <th><%= t('clientes.col_vence') %></th>
                <th><%= t('clientes.col_cliente') %></th>
                <th><%= t('clientes.col_servico') %></th>
                <th class="tabela__num"><%= t('clientes.col_valor') %></th>
                <th><%= t('clientes.col_estado') %></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        <% cuotas.forEach(function (c) {
            const pago = c.status === 'pago';
            const atraso = !pago ? _atraso(c.venc) : 0;
            const resumoPagar = c.cliente_nome + ' · ' + c.servico_nome + ' · ' + moeda(c.valor, c.moeda);
        %>
            <tr>
                <td><%= formatDate(c.venc, 'DD/MM/YYYY') %></td>
                <td>
                    <a href="/clientes/<%= c.cliente_id %>"><strong><%= c.cliente_nome %></strong></a>
                    <% if (c.celular) { %><div class="muted" style="font-size: 12px;"><i class="ph ph-phone"></i> <%= c.celular %></div><% } %>
                </td>
                <td><%= c.servico_nome %> <span class="muted">· <%= c.cuotas_total ? (c.cuota_num + '/' + c.cuotas_total) : ('#' + c.cuota_num) %></span></td>
                <td class="tabela__num"><%= moeda(c.valor, c.moeda) %></td>
                <td>
                    <% if (pago) { %><span class="badge badge-sucesso"><%= t('clientes.st_paga') %><% if (c.pago_em) { %> · <%= formatDate(c.pago_em, 'DD/MM/YYYY') %><% } %></span>
                    <% } else if (atraso > 0) { %><span class="badge badge-pendente"><%= t('clientes.st_vencida', { n: atraso }) %></span>
                    <% } else if (c.venc === hoje) { %><span class="badge badge-alerta"><%= t('clientes.st_hoje') %></span>
                    <% } else { %><span class="badge badge-neutro"><%= t('clientes.st_pendente') %></span><% } %>
                </td>
                <td class="clientes-acoes">
                    <% if (!pago) { %>
                        <form method="post" action="/clientes/cuotas/<%= c.id %>/pagar" style="display: inline;">
                            <%- csrfCampo %><input type="hidden" name="voltar" value="<%= _voltar %>">
                            <button type="submit" class="btn btn-sm btn-primary"><i class="ph ph-check"></i> <%= t('clientes.pagar') %></button>
                        </form>
                        <button type="button" class="btn btn-sm btn-outline" data-pagar-id="<%= c.id %>" data-pagar-resumo="<%= resumoPagar %>" title="<%= t('clientes.pagar_otra_fecha') %>" aria-label="<%= t('clientes.pagar_otra_fecha') %>"><i class="ph ph-calendar-blank"></i></button>
                    <% } else { %>
                        <form method="post" action="/clientes/cuotas/<%= c.id %>/pagar" style="display: inline;" data-confirm="<%= t('clientes.confirmar_desfazer') %>">
                            <%- csrfCampo %><input type="hidden" name="voltar" value="<%= _voltar %>"><input type="hidden" name="acao" value="desfazer">
                            <button type="submit" class="btn btn-sm btn-outline"><i class="ph ph-arrow-counter-clockwise"></i> <%= t('clientes.desfazer') %></button>
                        </form>
                    <% } %>
                </td>
            </tr>
        <% }) %>
        </tbody>
    </table>
    <% } %>
</div>

<%- include('_paginacao', { pagina, paginas, hrefPagina: function (n) { return link({ pagina: n }); } }) %>
<%- include('_modal_pagar', { voltar: _voltar, hoje }) %>
<%- include('_modal_cliente', { idModal: 'modal-novo-cliente', acao: '/clientes/criar', titulo: t('clientes.novo'), cliente: null }) %>
