<%# Cartao de pendentes (ingresos ou gastos), plano ou agrupado. Espera: tipo, lista, grupos (null = sem agrupamento). %>
<% const _rec = tipo === 'receita'; const _cor = _rec ? 'var(--green)' : 'var(--red)'; const _bg = _rec ? 'var(--green-bg)' : 'var(--red-bg)'; %>
<div class="card" style="border-radius: 16px; padding: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
        <h3 style="font-size: 16px; font-weight: 700; color: <%= _cor %>; display: flex; align-items: center; gap: 8px; margin: 0;">
            <i class="ph <%= _rec ? 'ph-arrow-circle-up' : 'ph-arrow-circle-down' %>" style="font-size: 20px;"></i> <%= _rec ? t('relatorios.ingresos_pendentes') : t('relatorios.egresos_pendentes') %>
        </h3>
        <span class="badge" style="background: <%= _bg %>; color: <%= _cor %>; font-weight: 600; font-size: 11px;"><%= t('relatorios.registros', { n: lista.length }) %></span>
    </div>

    <% if (grupos && grupos.length) { %>
        <div style="display: flex; flex-direction: column; gap: 12px;">
            <% grupos.forEach(g => { %>
                <details class="card" data-grupo="<%= tipo %>:<%= g.key %>" open style="border-radius: 12px; padding: 0; border: 1px solid var(--border); overflow: hidden;">
                    <summary style="display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 14px 18px; cursor: pointer; background: var(--bg); font-weight: 600; font-size: 13.5px; user-select: none;">
                        <div style="display: flex; align-items: center; gap: 8px; min-width: 0;">
                            <i class="ph ph-caret-right" style="font-size: 14px; transition: transform 0.2s; flex-shrink: 0;"></i>
                            <strong style="overflow-wrap: anywhere;"><%= g.key %></strong>
                            <span class="muted" style="font-size: 12px; font-weight: normal;">(<%= g.itens.length %>)</span>
                        </div>
                        <span style="color: <%= _cor %>; font-weight: 700; font-size: 12.5px; white-space: nowrap;"><%= _rec ? '+' : '-' %><%= moeda(g.total) %></span>
                    </summary>
                    <div style="padding: 4px 10px 10px;">
                        <%- include('_pendentes_tabela', { lista: g.itens, tipo }) %>
                    </div>
                </details>
            <% }) %>
        </div>
    <% } else { %>
        <%- include('_pendentes_tabela', { lista, tipo }) %>
    <% } %>
</div>
