<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= t('est.impr_titulo') %> — <%= formatDate(periodo.inicio, 'DD/MM/YYYY') %> a <%= formatDate(periodo.fim, 'DD/MM/YYYY') %></title>
<style>
  * { box-sizing: border-box; }
  body { font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif; color: #1b1f27; background: #eef0f4; margin: 0; padding: 24px; font-size: 12.5px; }
  .folha { background: #fff; max-width: 900px; margin: 0 auto; padding: 36px 40px; box-shadow: 0 6px 24px rgba(0,0,0,.12); }
  .acoes { max-width: 900px; margin: 0 auto 14px; display: flex; gap: 10px; }
  .acoes button { font: inherit; padding: 8px 14px; border-radius: 8px; border: 1px solid #c8ccd4; background: #fff; cursor: pointer; font-weight: 600; }
  .acoes button.primario { background: #1b1f27; color: #fff; border-color: #1b1f27; }
  h1 { font-size: 20px; margin: 0; }
  h2 { font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: #5a6270; margin: 22px 0 6px; }
  .sub { color: #5a6270; margin: 3px 0 0; }
  table { width: 100%; border-collapse: collapse; margin: 4px 0 8px; }
  th, td { padding: 5px 6px; border-bottom: 1px solid #e3e6ec; text-align: right; white-space: nowrap; vertical-align: top; }
  th:first-child, td:first-child { text-align: left; white-space: normal; }
  th { font-size: 10.5px; text-transform: uppercase; color: #5a6270; }
  tr.cat td { font-weight: 700; background: #f6f7f9; }
  tr.sub td { color: #4a515c; }
  tr.sub td:first-child { padding-left: 22px; }
  tr.tot td { font-weight: 800; border-top: 2px solid #1b1f27; border-bottom: none; }
  .pos { color: #0f7b4f; } .neg { color: #b42318; }
  .assinaturas { display: flex; gap: 48px; margin-top: 46px; }
  .assinaturas div { flex: 1; border-top: 1px solid #1b1f27; padding-top: 4px; text-align: center; color: #5a6270; }
  .anexo { page-break-before: always; }
  .anexo td, .anexo th { font-size: 11px; padding: 3px 5px; }
  .nota { color: #5a6270; font-size: 11px; margin-top: 10px; }
  @media print {
    body { background: #fff; padding: 0; }
    .acoes { display: none; }
    .folha { box-shadow: none; padding: 0; max-width: none; }
    tr { page-break-inside: avoid; }
    @page { margin: 14mm; }
  }
</style>
</head>
<body>
<%
const R = estado.receitas, D = estado.despesas, X = estado.resultado;
const pct = (v) => (v === null || v === undefined ? '—' : (v > 0.05 ? '+' : (v < -0.05 ? '−' : '')) + Math.abs(v).toFixed(1).replace('.', ',') + '%');
const val = (v) => (Math.abs(v) < 0.5 ? '—' : moeda(v));
const ant = formatDate(periodoAnt.inicio, 'DD/MM/YYYY') + ' – ' + formatDate(periodoAnt.fim, 'DD/MM/YYYY');
const ajustes = resumo.ajustes_periodo || 0;
const secao = (tipo, S) => {
    let h = '<h2>' + (tipo === 'receita' ? t('comum.receitas') : t('comum.despesas')) + '</h2><table><thead><tr><th>' + t('relatorios.demonstrativo_categoria_col') + '</th><th>' + t('est.realizado') + '</th><th>' + t('est.pendente') + '</th><th>' + t('est.total') + '</th><th>' + t('est.peso') + '</th><th>' + t('est.vs_ant') + '</th>' + (tipo === 'despesa' && orcamentoMult ? '<th>' + t('est.orcado') + '</th>' : '') + '</tr></thead><tbody>';
    S.cats.forEach((c) => {
        const orc = (x) => (tipo === 'despesa' && orcamentoMult ? '<td>' + (x.orcado ? moeda(x.orcado) + ' (' + Math.round(x.uso) + '%)' : '—') + '</td>' : '');
        h += '<tr class="cat"><td>' + String(c.nome || t('comum.sem_categoria')).replace(/</g, '&lt;') + '</td><td>' + val(c.realizado) + '</td><td>' + val(c.pendente) + '</td><td>' + moeda(c.total) + '</td><td>' + c.pct.toFixed(1).replace('.', ',') + '%</td><td>' + pct(c.variacao) + '</td>' + orc(c) + '</tr>';
        c.subLista.forEach((s) => {
            h += '<tr class="sub"><td>' + (s.direto ? t('est.sem_subcategoria') : String(s.nome || t('comum.sem_categoria')).replace(/</g, '&lt;')) + '</td><td>' + val(s.realizado) + '</td><td>' + val(s.pendente) + '</td><td>' + moeda(s.total) + '</td><td>' + s.pct.toFixed(1).replace('.', ',') + '%</td><td>' + pct(s.variacao) + '</td>' + (tipo === 'despesa' && orcamentoMult ? '<td></td>' : '') + '</tr>';
        });
    });
    h += '<tr class="tot"><td>' + t('est.total') + '</td><td>' + val(S.realizado) + '</td><td>' + val(S.pendente) + '</td><td>' + moeda(S.total) + '</td><td>100%</td><td>' + pct(S.variacao) + '</td>' + (tipo === 'despesa' && orcamentoMult ? '<td></td>' : '') + '</tr></tbody></table>';
    return h;
};
%>
<div class="acoes">
    <button class="primario" onclick="window.print()"><%= t('est.impr_imprimir') %></button>
    <button onclick="window.close()"><%= t('est.impr_fechar') %></button>
</div>
<div class="folha">
    <h1><%= t('est.impr_titulo') %></h1>
    <p class="sub"><%= usuarioNome %> · <%= formatDate(periodo.inicio, 'DD/MM/YYYY') %> – <%= formatDate(periodo.fim, 'DD/MM/YYYY') %> · <%= t('est.impr_gerado', { data: formatDate(geradoEm, 'DD/MM/YYYY') }) %></p>
    <p class="sub"><%= t('est.vs', { periodo: ant }) %></p>

    <h2><%= t('est.resumo_titulo') %></h2>
    <table>
        <thead><tr><th></th><th><%= t('est.realizado') %></th><th><%= t('est.pendente') %></th><th><%= t('est.total') %></th><th><%= t('est.vs_ant') %></th></tr></thead>
        <tbody>
            <tr><td><%= t('painel.saldo_anterior') %></td><td></td><td></td><td><%= moeda(resumo.saldo_anterior) %></td><td></td></tr>
            <tr><td>(+) <%= t('comum.receitas') %></td><td><%= val(R.realizado) %></td><td><%= val(R.pendente) %></td><td><%= moeda(R.total) %></td><td><%= pct(R.variacao) %></td></tr>
            <tr><td>(−) <%= t('comum.despesas') %></td><td><%= val(D.realizado) %></td><td><%= val(D.pendente) %></td><td><%= moeda(D.total) %></td><td><%= pct(D.variacao) %></td></tr>
            <tr class="tot"><td>(=) <%= t('est.resultado') %></td><td><%= val(X.realizado) %></td><td><%= val(X.total - X.realizado) %></td><td class="<%= X.total >= 0 ? 'pos' : 'neg' %>"><%= X.total >= 0 ? '' : '−' %><%= moeda(Math.abs(X.total)) %></td><td><%= X.anterior > 0 ? pct(X.variacao) : (Math.abs(X.total - X.anterior) < 1 ? '—' : (X.total - X.anterior > 0 ? '+' : '−') + moeda(Math.abs(X.total - X.anterior))) %></td></tr>
            <% if (Math.abs(ajustes) >= 1) { %><tr><td>(±) <%= t('est.ajustes') %></td><td></td><td></td><td><%= ajustes >= 0 ? '+' : '−' %><%= moeda(Math.abs(ajustes)) %></td><td></td></tr><% } %>
            <tr class="tot"><td>(=) <%= t('est.saldo_projetado') %></td><td></td><td></td><td><%= moeda(resumo.saldo_previsto) %></td><td></td></tr>
            <tr><td><%= t('est.saldo_realizado') %></td><td></td><td></td><td><%= moeda(resumo.saldo_disponivel) %></td><td></td></tr>
        </tbody>
    </table>

    <%- R.cats.length ? secao('receita', R) : '' %>
    <%- D.cats.length ? secao('despesa', D) : '' %>

    <div class="assinaturas"><div><%= t('est.impr_responsavel') %></div><div><%= t('est.impr_contador') %></div></div>

    <% if (anexo) { %>
    <div class="anexo">
        <h2><%= t('est.impr_anexo') %></h2>
        <table>
            <thead><tr><th><%= t('comum.data') %></th><th><%= t('comum.tipo') %></th><th><%= t('modal.descricao') %></th><th><%= t('comum.categoria') %></th><th><%= t('modal.conta') %></th><th><%= t('comum.valor') %></th><th><%= t('contas.extrato.col.status') %></th></tr></thead>
            <tbody>
            <% anexo.forEach(l => { %>
                <tr>
                    <td><%= formatDate(l.data_competencia, 'DD/MM/YYYY') %></td>
                    <td><%= t('lancamento.tipo.' + l.tipo) %></td>
                    <td style="white-space: normal;"><%= l.descricao %></td>
                    <td style="white-space: normal;"><%= l.categoria || '—' %><%= l.subcategoria ? ' / ' + l.subcategoria : '' %></td>
                    <td><%= l.conta || '—' %></td>
                    <td class="<%= l.tipo === 'receita' ? 'pos' : 'neg' %>"><%= l.tipo === 'receita' ? '+' : '−' %><%= moeda(Math.abs(parseFloat(l.valor))) %></td>
                    <td><%= l.status === 'pago' ? t('lancamento.status.pago') : t('lancamento.status.pendente') %></td>
                </tr>
            <% }) %>
            </tbody>
        </table>
        <% if (anexo.length >= 2000) { %><p class="nota"><%= t('est.impr_limite') %></p><% } %>
    </div>
    <% } %>
</div>
<script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 500); });</script>
</body>
</html>
