<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="page-header page-header--acoes">
    <div>
        <h1><i class="ph ph-chart-bar"></i> <%= t('relatorios.titulo') %></h1>
        <p class="muted"><%= t('relatorios.subtitulo') %></p>
    </div>
</div>

<%# Parametros que identificam o periodo nos links entre abas e presets. %>
<% const _qs = (extra) => new URLSearchParams(Object.assign({}, periodoParams, extra || {})).toString(); %>
<% const _mesLink = (m, a) => '/relatorios?' + new URLSearchParams({ aba: aba, preset: 'mes', mes: m, ano: a }).toString(); %>
<div class="contas-toolbar">
    <div class="tabs tabs--grade">
        <a href="/relatorios?aba=graficos&<%= _qs() %>" class="tabs__item <%= aba === 'graficos' ? 'is-active' : '' %>"><i class="ph ph-chart-pie-slice"></i> <%= t('relatorios.aba_graficos') %></a>
        <a href="/relatorios?aba=pendentes&<%= _qs() %>" class="tabs__item <%= aba === 'pendentes' ? 'is-active' : '' %>"><i class="ph ph-clock-countdown"></i> <%= t('relatorios.aba_pendentes') %></a>
        <a href="/relatorios?aba=demonstrativo&<%= _qs() %>" class="tabs__item <%= aba === 'demonstrativo' ? 'is-active' : '' %>"><i class="ph ph-table"></i> <%= t('relatorios.aba_demonstrativo') %></a>
        <a href="/relatorios?aba=demonstrativo_anual&<%= _qs() %>" class="tabs__item <%= aba === 'demonstrativo_anual' ? 'is-active' : '' %>"><i class="ph ph-calendar-blank"></i> <%= t('relatorios.aba_demonstrativo_anual') %></a>
    </div>
</div>

<!-- Barra de periodo (mes anterior/proximo, atalhos e periodo personalizado) -->
<form method="get" action="/relatorios" class="card" style="margin-bottom: 20px; padding: 14px 18px;">
    <input type="hidden" name="aba" value="<%= aba %>">
    <div class="mes-nav">
        <a class="btn btn-outline btn-sm" href="<%= _mesLink(periodo.mes_anterior, periodo.ano_anterior) %>" aria-label="<%= t('painel.mes_anterior') %>"><i class="ph ph-caret-left"></i></a>
        <div class="mes-nav__centro">
            <strong><%= periodo.preset === 'mes' ? t('painel.mes.' + periodo.mes) + ' ' + periodo.ano : t('comum.periodo') %></strong>
            <span class="muted"><%= formatDate(periodo.inicio, 'DD/MM/YYYY') %> – <%= formatDate(periodo.fim, 'DD/MM/YYYY') %></span>
        </div>
        <a class="btn btn-outline btn-sm" href="<%= _mesLink(periodo.mes_proximo, periodo.ano_proximo) %>" aria-label="<%= t('painel.mes_proximo') %>"><i class="ph ph-caret-right"></i></a>
    </div>
    <div style="display: flex; gap: 6px; flex-wrap: wrap; align-items: center;">
        <a href="/relatorios?aba=<%= aba %>&preset=hoje" class="btn <%= periodo.preset === 'hoje' ? 'btn-primary' : 'btn-outline' %> btn-sm" style="border-radius: 20px;"><%= t('filtro.hoje') %></a>
        <a href="/relatorios?aba=<%= aba %>&preset=7dias" class="btn <%= periodo.preset === '7dias' ? 'btn-primary' : 'btn-outline' %> btn-sm" style="border-radius: 20px;"><%= aba === 'pendentes' ? t('filtro.proximos_7dias') : t('filtro.7dias') %></a>
        <a href="/relatorios?aba=<%= aba %>&preset=anual&ano=<%= periodo.ano %>" class="btn <%= periodo.preset === 'anual' ? 'btn-primary' : 'btn-outline' %> btn-sm" style="border-radius: 20px;"><%= t('filtro.anual') %></a>
        <a href="/relatorios?aba=<%= aba %>&preset=mes" class="btn <%= periodo.preset === 'mes' ? 'btn-primary' : 'btn-outline' %> btn-sm" style="border-radius: 20px;"><%= t('filtro.mes_atual') %></a>
    </div>

    <!-- Periodo personalizado (recolhido por padrao) -->
    <details class="periodo-custom" <%= periodo.preset === 'custom' ? 'open' : '' %>>
        <summary><i class="ph ph-calendar-blank"></i> <%= t('filtro.periodo_personalizado') %></summary>
        <div style="display: flex; gap: 10px; margin-top: 10px; align-items: center; flex-wrap: wrap;">
            <input type="date" name="data_inicio" value="<%= periodo.inicio %>" class="input" style="width: 150px; padding: 4px 8px; font-size: 13px; border-radius: 8px;" aria-label="<%= t('relatorios.data_inicial') %>">
            <span class="muted" style="font-size: 12px;"><%= t('filtro.ate') %></span>
            <input type="date" name="data_fim" value="<%= periodo.fim %>" class="input" style="width: 150px; padding: 4px 8px; font-size: 13px; border-radius: 8px;" aria-label="<%= t('relatorios.data_final') %>">
            <button type="submit" name="aplicar" value="1" class="btn btn-outline btn-sm" style="border-radius: 8px;"><%= t('filtro.aplicar_datas') %></button>
        </div>
    </details>
    <a class="exportar-link" href="/relatorios/exportar?data_inicio=<%= periodo.inicio %>&data_fim=<%= periodo.fim %>"><i class="ph ph-download-simple"></i> <%= t('relatorios.exportar_csv') %></a>
</form>

<% if (aba === 'graficos') { %>
    <% if (resumo) { %>
        <!-- Summary Cards transferred from Dashboard -->
        <div class="resumo-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 20px;">
            <!-- Saldo Anterior com Comparativo -->
            <% const saldoAtualNoPeriodo = (resumo.receitas_recebidas - resumo.despesas_pagas + (resumo.ajustes_periodo || 0)); %>
            <% const saldoAcumuladoTotal = resumo.saldo_anterior + saldoAtualNoPeriodo; %>
            <div class="card resumo-card" style="border-radius: 16px; padding: 18px 20px; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <span class="muted" style="font-size: 13px; font-weight: 500;"><%= t('painel.saldo_anterior') %></span>
                    <div style="font-size: 22px; font-weight: 700; margin-top: 6px; color: var(--text);"><%= moeda(resumo.saldo_anterior) %></div>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11.5px; margin-top: 12px; border-top: 1px solid var(--border); padding-top: 8px;">
                    <span class="muted"><%= t('relatorios.saldo_final_label') %></span>
                    <strong style="color: <%= saldoAcumuladoTotal >= 0 ? 'var(--green)' : 'var(--red)' %>;">
                        <%= moeda(saldoAcumuladoTotal) %>
                        (<%= saldoAtualNoPeriodo >= 0 ? '+' : '' %><%= moeda(saldoAtualNoPeriodo) %>)
                    </strong>
                </div>
            </div>

            <!-- Receitas / Ingresos -->
            <div class="card resumo-card" style="border-radius: 16px; padding: 18px 20px; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; align-items: center; gap: 6px; color: var(--green); font-size: 13px; font-weight: 600;">
                        <i class="ph ph-arrow-circle-up" style="font-size: 18px;"></i> <%= t('painel.receitas') %>
                    </div>
                    <div style="font-size: 22px; font-weight: 700; margin-top: 6px; color: var(--green);"><%= moeda(resumo.receitas_recebidas) %></div>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 11.5px; margin-top: 12px; border-top: 1px solid var(--border); padding-top: 8px;">
                    <span class="muted"><%= t('painel.a_receber') %>:</span>
                    <strong style="color: var(--text);"><%= moeda(resumo.receitas_a_receber) %></strong>
                </div>
            </div>

            <!-- Despesas / Gastos -->
            <div class="card resumo-card" style="border-radius: 16px; padding: 18px 20px; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; align-items: center; gap: 6px; color: var(--red); font-size: 13px; font-weight: 600;">
                        <i class="ph ph-arrow-circle-down" style="font-size: 18px;"></i> <%= t('painel.despesas') %>
                    </div>
                    <div style="font-size: 22px; font-weight: 700; margin-top: 6px; color: var(--red);"><%= moeda(resumo.despesas_pagas) %></div>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 11.5px; margin-top: 12px; border-top: 1px solid var(--border); padding-top: 8px;">
                    <span class="muted"><%= t('painel.nao_pago') %>:</span>
                    <strong style="color: var(--text);"><%= moeda(resumo.despesas_nao_pagas) %></strong>
                </div>
            </div>
        </div>
    <% } %>
    <!-- Graficos de analise: receitas e despesas por categoria e por subcategoria (arraste para reordenar) -->
    <section class="gf-analise" style="margin-top: 24px;">
        <div class="gf-analise__cab">
            <h2><%= t('graf.titulo') %></h2>
            <p class="muted"><%= t('graf.dica') %></p>
        </div>
        <div class="gf-analise__grid" id="gfGrafGrid">
            <% [
                { id: 'rec-cat', tipo: 'receita', nivel: 'cat' },
                { id: 'des-cat', tipo: 'despesa', nivel: 'cat' },
                { id: 'rec-sub', tipo: 'receita', nivel: 'sub' },
                { id: 'des-sub', tipo: 'despesa', nivel: 'sub' }
            ].forEach(c => { const _rec = c.tipo === 'receita'; %>
            <article class="card gf-card" data-card="<%= c.id %>" data-tipo="<%= c.tipo %>" data-nivel="<%= c.nivel %>">
                <button type="button" class="gf-card__alca" aria-label="<%= t('graf.reordenar') %>" title="<%= t('graf.reordenar') %>"><i class="ph ph-dots-six-vertical"></i></button>
                <h3 class="gf-card__titulo"><span class="gf-chip gf-chip--<%= _rec ? 'verde' : 'vermelho' %>"><%= _rec ? t('graf.receitas') : t('graf.despesas') %></span> <%= c.nivel === 'cat' ? t('graf.por_categoria') : t('graf.por_subcategoria') %></h3>
                <div class="gf-card__periodo" data-periodo="<%= periodo.inicio %>|<%= periodo.fim %>"></div>
                <select class="gf-card__filtro" aria-label="<%= t('graf.situacao') %>">
                    <option value="todos"><%= t('graf.todos') %></option>
                    <option value="pago"><%= _rec ? t('graf.recebidos') : t('graf.pagos') %></option>
                    <option value="pendente"><%= t('graf.pendentes') %></option>
                </select>
                <div class="gf-card__corpo">
                    <div class="gf-card__rosca"><canvas></canvas></div>
                    <ul class="gf-leg gf-leg--rolavel"></ul>
                    <p class="muted grafico-vazio" hidden><%= t('graf.sem_dados') %></p>
                </div>
                <a class="gf-card__rodape" href="/relatorios?<%= new URLSearchParams(Object.assign({ aba: 'demonstrativo', tipo: c.tipo, nivel: c.nivel }, periodoParams)).toString() %>">
                    <%= c.nivel === 'cat' ? t('graf.ver_categorias') : t('graf.ver_subcategorias') %> <i class="ph ph-arrow-up-right"></i>
                </a>
            </article>
            <% }) %>
        </div>
    </section>

    <!-- Evolucao do saldo -->
    <div class="card grafico-card" style="margin-top: 20px;">
        <h3 class="grafico-card__titulo"><span class="grafico-card__marca" style="background: #2a78d6;"></span><%= t('relatorios.evolucao_titulo') %></h3>
        <div class="grafico-freq-card__canvas-wrap"><canvas id="chartEvolucao"></canvas></div>
        <p class="muted grafico-vazio" id="vazioEvolucao" hidden><%= t('relatorios.sem_dados_curto') %></p>
    </div>

    <!-- Grafico de Frequencia Diaria -->
    <div class="card grafico-card" style="margin-top: 20px;">
        <h3 class="grafico-card__titulo"><%= t('relatorios.frequencia_titulo') %></h3>
        <div class="grafico-freq-card__canvas-wrap"><canvas id="chartFrequencia"></canvas></div>
        <p class="muted grafico-vazio" id="vazioFreq" hidden><%= t('relatorios.sem_movimentacoes_periodo') %></p>
    </div>

    <script src="/assets/js/charts.js?v=<%= Date.now() %>"></script>
    <script>
    window.GF_GRAF = {
        dados: <%- JSON.stringify(graficosDados || []) %>,
        per: <%- JSON.stringify(new URLSearchParams(periodoParams).toString()) %>,
        lang: <%- JSON.stringify(lang) %>,
        t: {
            semCategoria: <%- JSON.stringify(t('comum.sem_categoria')) %>,
            total: <%- JSON.stringify(t('graf.total')) %>,
            semDados: <%- JSON.stringify(t('graf.sem_dados')) %>
        }
    };
    </script>
    <script src="/assets/js/graficos.js?v=<%= Date.now() %>"></script>
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const freqData = <%- JSON.stringify(frequencia || []) %>;
        const evoData = <%- JSON.stringify(evolucao || []) %>;
        if (evoData.length > 1) {
            GFCharts.evolucao('chartEvolucao', evoData);
        } else {
            document.querySelector('#chartEvolucao').parentElement.hidden = true;
            document.getElementById('vazioEvolucao').hidden = false;
        }

        if (freqData.length > 0) {
            GFCharts.frequencia('chartFrequencia', freqData);
        } else {
            document.querySelector('#chartFrequencia').parentElement.hidden = true;
            document.getElementById('vazioFreq').hidden = false;
        }
    });
    </script>
<% } else if (aba === 'pendentes') { %>
    <p class="muted" style="font-size: 13px; margin-top: 16px; margin-bottom: 16px;"><%= t('relatorios.pendentes_ajuda') %></p>

    <% if (contas && contas.length > 0) { %>
    <!-- Adicionar ingreso / gasto sem sair desta tela (mesmos formularios da Visao geral) -->
    <div class="myfinance-action-buttons" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px;">
        <button type="button" class="btn btn-primary" data-modal-open="modal-novo-receita" style="background: var(--green); border: none; font-weight: 700; padding: 12px; border-radius: 14px; font-size: 14px; min-height: 48px; display: flex; align-items: center; justify-content: center; gap: 8px;"><i class="ph ph-plus-circle" style="font-size: 20px;"></i> <%= t('painel.nova_receita') %></button>
        <button type="button" class="btn btn-primary" data-modal-open="modal-novo-despesa" style="background: var(--red); border: none; font-weight: 700; padding: 12px; border-radius: 14px; font-size: 14px; min-height: 48px; display: flex; align-items: center; justify-content: center; gap: 8px;"><i class="ph ph-minus-circle" style="font-size: 20px;"></i> <%= t('painel.nova_despesa') %></button>
    </div>
    <% const dataHoje = formatDate(hojeLocal()); %>
    <%- include('../partials/modais_lancamento', { dataHoje, voltar: currentUrl }) %>
    <% } %>

    <%# Mesma lista da Visao geral (busca, Todos/Gastos/Ingresos, agrupar, ordenar, paginacao), so com o que esta pendente. %>
    <%- include('../partials/lista_lancamentos') %>
    <%- include('../partials/modais_excluir_serie', { lancamentos }) %>
<% } else if (aba === 'demonstrativo') { %>
    <% if (categoriaFiltro) { %>
        <%# Transacoes da categoria escolhida (clique no grafico ou na tabela), no mesmo formato da Visao geral. %>
        <div class="card" style="border-radius: 16px; padding: 16px 20px; margin: 20px 0 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
                <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: <%= categoriaFiltro.cor || '#3b82f6' %>; flex-shrink: 0;"></span>
                <div style="min-width: 0;">
                    <strong style="font-size: 16px; overflow-wrap: anywhere;"><%= categoriaFiltro.pai_nome ? categoriaFiltro.pai_nome + ' / ' + categoriaFiltro.nome : categoriaFiltro.nome %></strong>
                    <div class="muted" style="font-size: 12px;"><%= t('relatorios.aba_demonstrativo') %> · <%= formatDate(periodo.inicio, 'DD/MM/YYYY') %> – <%= formatDate(periodo.fim, 'DD/MM/YYYY') %></div>
                </div>
            </div>
            <a class="btn btn-outline btn-sm" href="<%= '/relatorios?' + new URLSearchParams(Object.assign({ aba: 'demonstrativo' }, periodoParams)).toString() %>"><i class="ph ph-arrow-left"></i> <%= t('graf.voltar_estado') %></a>
        </div>
        <% if (contas && contas.length > 0) { %>
            <% const dataHoje = formatDate(hojeLocal()); %>
            <%- include('../partials/modais_lancamento', { dataHoje, voltar: currentUrl }) %>
        <% } %>
        <%- include('../partials/lista_lancamentos') %>
        <%- include('../partials/modais_excluir_serie', { lancamentos }) %>
    <% } else { %>
        <%
        const _lnk = (extra) => '/relatorios?' + new URLSearchParams(Object.assign({ aba: 'demonstrativo' }, periodoParams, extra)).toString();
        const _chip = (ativo, href, texto) => '<a href="' + href + '" class="btn btn-sm ' + (ativo ? 'btn-primary' : 'btn-outline') + '" style="border-radius: 20px;">' + texto + '</a>';
        const R = estado.receitas, D = estado.despesas, X = estado.resultado;
        const _f1 = (v) => Math.abs(v).toFixed(1).replace('.', ',');
        // Variacao contra o periodo anterior. boaSubir: subir e bom (receitas, resultado) ou ruim (despesas).
        const _delta = (v, boaSubir) => {
            if (v === null || v === undefined) return '<span class="muted" title="' + t('est.sem_base') + '">—</span>';
            if (Math.abs(v) < 0.05) return '<span class="estado-delta muted">0,0%</span>';
            const subiu = v > 0;
            const bom = subiu === boaSubir;
            return '<span class="estado-delta ' + (bom ? 'estado-delta--bom' : 'estado-delta--ruim') + '">' + (subiu ? '▲' : '▼') + ' ' + _f1(v) + '%</span>';
        };
        // Resultado: se o periodo anterior fechou em zero ou negativo, a % nao diz nada (ex.: de -382 mil para +3,8 mi = 1110%); mostra a diferenca em valor.
        const _deltaRes = (atual, anterior) => {
            if (anterior > 0) return _delta(((atual - anterior) / anterior) * 100, true);
            const dif = atual - anterior;
            if (Math.abs(dif) < 1) return '<span class="estado-delta muted">0</span>';
            return '<span class="estado-delta ' + (dif > 0 ? 'estado-delta--bom' : 'estado-delta--ruim') + '" title="' + t('est.base_negativa') + '">' + (dif > 0 ? '▲ +' : '▼ −') + moeda(Math.abs(dif)) + '</span>';
        };
        const _ajustes = resumo.ajustes_periodo || 0;
        const _ant = formatDate(periodoAnt.inicio, 'DD/MM/YYYY') + ' – ' + formatDate(periodoAnt.fim, 'DD/MM/YYYY');
        %>

        <!-- Resultado do periodo (demonstracao de resultados) -->
        <section class="card estado-resumo">
            <div class="estado-resumo__cab">
                <h3><%= t('est.resumo_titulo') %></h3>
                <span class="muted"><%= t('est.vs', { periodo: _ant }) %></span>
            </div>
            <div class="estado-linha">
                <span class="estado-linha__rot"><%= t('painel.saldo_anterior') %></span>
                <span class="estado-linha__val"><%= moeda(resumo.saldo_anterior) %></span>
            </div>
            <div class="estado-linha estado-linha--rec">
                <span class="estado-linha__rot">(+) <%= t('comum.receitas') %>
                    <small><%= t('painel.recebido') %> <b><%= moeda(R.realizado) %></b> · <%= t('painel.a_receber') %> <b><%= moeda(R.pendente) %></b></small></span>
                <span class="estado-linha__val"><%= moeda(R.total) %> <%- _delta(R.variacao, true) %></span>
            </div>
            <div class="estado-linha estado-linha--des">
                <span class="estado-linha__rot">(−) <%= t('comum.despesas') %>
                    <small><%= t('painel.pago') %> <b><%= moeda(D.realizado) %></b> · <%= t('painel.nao_pago') %> <b><%= moeda(D.pendente) %></b></small></span>
                <span class="estado-linha__val"><%= moeda(D.total) %> <%- _delta(D.variacao, false) %></span>
            </div>
            <div class="estado-linha estado-linha--res">
                <span class="estado-linha__rot">(=) <%= t('est.resultado') %>
                    <small><%= t('est.resultado_realizado') %> <b><%= moeda(X.realizado) %></b></small></span>
                <span class="estado-linha__val" style="color: <%= X.total >= 0 ? 'var(--green)' : 'var(--red)' %>;"><%= X.total >= 0 ? '' : '−' %><%= moeda(Math.abs(X.total)) %> <%- _deltaRes(X.total, X.anterior) %></span>
            </div>
            <% if (Math.abs(_ajustes) >= 1) { %>
            <div class="estado-linha">
                <span class="estado-linha__rot">(±) <%= t('est.ajustes') %><small><%= t('est.ajustes_dica') %></small></span>
                <span class="estado-linha__val"><%= _ajustes >= 0 ? '+' : '−' %><%= moeda(Math.abs(_ajustes)) %></span>
            </div>
            <% } %>
            <div class="estado-linha estado-linha--proj">
                <span class="estado-linha__rot">(=) <%= t('est.saldo_projetado') %><small><%= t('est.saldo_projetado_dica') %></small></span>
                <span class="estado-linha__val"><%= moeda(resumo.saldo_previsto) %></span>
            </div>
            <div class="estado-linha estado-linha--real">
                <span class="estado-linha__rot"><%= t('est.saldo_realizado') %><small><%= t('est.saldo_realizado_dica') %></small></span>
                <span class="estado-linha__val"><%= moeda(resumo.saldo_disponivel) %></span>
            </div>
        </section>

        <div class="card" style="border-radius: 16px; padding: 14px 18px; margin-top: 16px; display: flex; gap: 14px 24px; flex-wrap: wrap; align-items: center;">
            <div style="display: flex; gap: 6px; flex-wrap: wrap; align-items: center;">
                <span class="muted" style="font-size: 12px; font-weight: 600;"><%= t('comum.tipo') %></span>
                <%- _chip(!tipoFiltro, _lnk(nivel ? { nivel } : {}), t('painel.filtro.todas')) %>
                <%- _chip(tipoFiltro === 'receita', _lnk(Object.assign({ tipo: 'receita' }, nivel ? { nivel } : {})), t('painel.filtro.receitas')) %>
                <%- _chip(tipoFiltro === 'despesa', _lnk(Object.assign({ tipo: 'despesa' }, nivel ? { nivel } : {})), t('painel.filtro.despesas')) %>
            </div>
            <div style="display: flex; gap: 6px; flex-wrap: wrap; align-items: center;">
                <span class="muted" style="font-size: 12px; font-weight: 600;"><%= t('graf.nivel') %></span>
                <%- _chip(!nivel, _lnk(tipoFiltro ? { tipo: tipoFiltro } : {}), t('graf.nivel_ambos')) %>
                <%- _chip(nivel === 'cat', _lnk(Object.assign({ nivel: 'cat' }, tipoFiltro ? { tipo: tipoFiltro } : {})), t('graf.nivel_cat')) %>
                <%- _chip(nivel === 'sub', _lnk(Object.assign({ nivel: 'sub' }, tipoFiltro ? { tipo: tipoFiltro } : {})), t('graf.nivel_sub')) %>
            </div>
        </div>

        <%
        const _numCel = (v) => moeda(v);
        const _barraOrc = (x) => {
            if (!x.orcado) return '<span class="muted">—</span>';
            const uso = x.uso || 0;
            const cls = uso > 100 ? 'estouro' : (uso >= 80 ? 'alerta' : 'ok');
            return '<div class="orc"><div class="orc__txt"><span>' + moeda(x.orcado) + '</span><b class="orc--' + cls + '">' + Math.round(uso) + '%</b></div>' +
                '<div class="orc__barra"><span class="orc--' + cls + '" style="width:' + Math.min(uso, 100).toFixed(0) + '%"></span></div></div>';
        };
        const _tem = R.cats.length + D.cats.length > 0;
        %>
        <% if (!_tem) { %>
            <div class="card" style="border-radius: 16px; padding: 24px; margin-top: 16px;"><p class="muted" style="margin: 0;"><%= t('relatorios.demonstrativo_sem_dados') %></p></div>
        <% } %>
        <% [['receita', R, true], ['despesa', D, false]].forEach(([tp, S, boaSubir]) => {
            if (tipoFiltro && tipoFiltro !== tp) return;
            if (!S.cats.length) return;
            const _cor = tp === 'receita' ? 'var(--green)' : 'var(--red)';
            const _comOrc = tp === 'despesa' && orcamentoMult;
            // Linhas a mostrar conforme o nivel: categorias com subcategorias embaixo, so categorias ou so subcategorias.
            const _linhas = [];
            if (nivel === 'sub') {
                S.cats.forEach(c => c.subLista.filter(s => !s.direto).forEach(s => _linhas.push({ no: s, cat: c, sub: true })));
                _linhas.sort((a, b) => b.no.total - a.no.total);
            } else {
                S.cats.forEach(c => {
                    _linhas.push({ no: c, cat: c, sub: false });
                    if (nivel !== 'cat') c.subLista.forEach(s => _linhas.push({ no: s, cat: c, sub: true, filho: true }));
                });
            }
        %>
        <section class="card estado-tabela" style="border-radius: 16px; padding: 20px; margin-top: 16px;">
            <div class="estado-tabela__cab">
                <h3 style="color: <%= _cor %>;"><%= tp === 'receita' ? t('comum.receitas') : t('comum.despesas') %></h3>
                <strong style="color: <%= _cor %>;"><%= moeda(S.total) %></strong>
            </div>
            <p class="muted" style="font-size: 12px; margin: 0 0 12px;"><%= t('graf.clique_categoria') %><% if (tp === 'despesa' && !orcamentoMult) { %> · <%= t('est.orcado_so_mes') %><% } %></p>
            <div class="tabela-container">
                <table class="tabela estado-t">
                    <thead>
                        <tr>
                            <th><%= t('relatorios.demonstrativo_categoria_col') %></th>
                            <th class="num"><%= t('est.realizado') %></th>
                            <th class="num opc"><%= t('est.pendente') %></th>
                            <th class="num"><%= t('est.total') %></th>
                            <th class="num opc"><%= t('est.peso') %></th>
                            <th class="num"><%= t('est.vs_ant') %></th>
                            <% if (_comOrc) { %><th class="opc" title="<%= t('est.limite_dica') %>"><%= t('est.orcado') %></th><% } %>
                        </tr>
                    </thead>
                    <tbody>
                        <% _linhas.forEach(L => {
                            const x = L.no;
                            const href = _lnk(Object.assign({ tipo: tp, categoria_id: L.cat.id }, (L.sub && x.id) ? { subcategoria_id: x.id } : {}));
                            const nome = x.direto ? t('est.sem_subcategoria') : x.nome;
                        %>
                            <tr class="<%= L.filho ? 'estado-sub' : (L.sub ? 'estado-sub estado-sub--solo' : 'estado-cat') %>">
                                <td>
                                    <a href="<%= href %>" class="estado-nome">
                                        <% if (!L.filho) { %><span class="estado-dot" style="background: <%= L.cat.cor || '#3b82f6' %>;"></span><% } %>
                                        <span><%= L.sub && !L.filho ? L.cat.nome + ' / ' : '' %><%= nome %></span>
                                    </a>
                                </td>
                                <td class="num"><%= _numCel(x.realizado) %></td>
                                <td class="num opc"><%= _numCel(x.pendente) %></td>
                                <td class="num"><strong><%= _numCel(x.total) %></strong></td>
                                <td class="num opc"><%= _f1(x.pct) %>%</td>
                                <td class="num"><%- _delta(x.variacao, boaSubir) %></td>
                                <% if (_comOrc) { %><td class="opc"><%- L.filho ? (x.orcado ? _barraOrc(x) : '') : _barraOrc(x) %></td><% } %>
                            </tr>
                        <% }) %>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td><strong><%= t('est.total') %></strong></td>
                            <td class="num"><strong><%= _numCel(S.realizado) %></strong></td>
                            <td class="num opc"><strong><%= _numCel(S.pendente) %></strong></td>
                            <td class="num"><strong><%= _numCel(S.total) %></strong></td>
                            <td class="num opc">100%</td>
                            <td class="num"><%- _delta(S.variacao, boaSubir) %></td>
                            <% if (_comOrc) { %><td class="opc"></td><% } %>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>
        <% }) %>
        <% if (_tem && !tipoFiltro && D.cats.length && orcamentoMult) { %>
            <p class="muted" style="font-size: 12px; margin: 12px 4px 0;"><i class="ph ph-info"></i> <%= t('est.limite_dica') %> · <a href="/categorias"><%= t('est.definir_limites') %></a></p>
        <% } %>
    <% } %>
<% } else if (aba === 'demonstrativo_anual') { %>
    <div class="periodo-nav card" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; margin-top: 20px; border-radius: 16px;">
        <a class="btn btn-outline btn-sm" href="/relatorios?aba=demonstrativo_anual&ano_anual=<%= anoAnual - 1 %>">← <%= anoAnual - 1 %></a>
        <strong><%= t('relatorios.ano_label', { ano: anoAnual }) %></strong>
        <a class="btn btn-outline btn-sm" href="/relatorios?aba=demonstrativo_anual&ano_anual=<%= anoAnual + 1 %>"><%= anoAnual + 1 %> →</a>
    </div>

    <p class="muted tabela-dica"><i class="ph ph-arrows-left-right"></i> <%= t('relatorios.deslize') %></p>
    <div class="card tabela-anual-wrap" style="border-radius: 16px; padding: 20px; margin-top: 8px; overflow-x: auto;">
        <%
        const mesesNomes = Array.from({ length: 12 }, (_, i) => t('painel.mes_abrev.' + (i + 1)));
        %>
        <table class="tabela tabela-anual" style="min-width: 900px;">
            <thead>
                <tr>
                    <th><%= t('comum.categoria') %></th>
                    <% mesesNomes.forEach(m => { %>
                        <th style="text-align: right;"><%= m %></th>
                    <% }) %>
                    <th style="text-align: right;"><%= t('comum.total') %></th>
                </tr>
            </thead>
            <tbody>
                <!-- Receitas -->
                <tr style="background: var(--green-bg); font-weight: 700;">
                    <td colspan="14" style="color: var(--green);"><%= t('relatorios.receitas_upper') %></td>
                </tr>
                <% if (!demonstrativoAnual || !demonstrativoAnual.receitas || demonstrativoAnual.receitas.length === 0) { %>
                    <tr><td colspan="14" class="tabela__vazio"><%= t('relatorios.sem_receitas_ano') %></td></tr>
                <% } else { %>
                    <% demonstrativoAnual.receitas.forEach(cat => { %>
                        <tr class="tabela-anual__linha <%= cat.subcategorias && cat.subcategorias.length > 0 ? 'tabela-anual__linha--expansivel' : '' %>" data-anual-toggle="cat-rec-<%= cat.categoria_id %>">
                            <td>
                                <% if (cat.subcategorias && cat.subcategorias.length > 0) { %><span>▸ </span><% } %>
                                <strong><%= cat.categoria_nome || t('relatorios.sem_categoria') %></strong>
                            </td>
                            <% for (let m = 1; m <= 12; m++) { %>
                                <td style="text-align: right;"><%= cat.meses[m] > 0 ? moeda(cat.meses[m]) : '—' %></td>
                            <% } %>
                            <td style="text-align: right; font-weight: 700;"><%= moeda(cat.total) %></td>
                        </tr>
                        <% (cat.subcategorias || []).forEach(sub => { %>
                            <tr class="tabela-anual__linha--sub" data-anual-pai="cat-rec-<%= cat.categoria_id %>" hidden style="background: var(--bg);">
                                <td style="padding-left: 28px;"><%= sub.categoria_nome %></td>
                                <% for (let m = 1; m <= 12; m++) { %>
                                    <td style="text-align: right;"><%= sub.meses[m] > 0 ? moeda(sub.meses[m]) : '—' %></td>
                                <% } %>
                                <td style="text-align: right;"><%= moeda(sub.total) %></td>
                            </tr>
                        <% }) %>
                    <% }) %>
                <% } %>

                <!-- Despesas -->
                <tr style="background: var(--red-bg); font-weight: 700;">
                    <td colspan="14" style="color: var(--red);"><%= t('relatorios.despesas_upper') %></td>
                </tr>
                <% if (!demonstrativoAnual || !demonstrativoAnual.despesas || demonstrativoAnual.despesas.length === 0) { %>
                    <tr><td colspan="14" class="tabela__vazio"><%= t('relatorios.sem_despesas_ano') %></td></tr>
                <% } else { %>
                    <% demonstrativoAnual.despesas.forEach(cat => { %>
                        <tr class="tabela-anual__linha <%= cat.subcategorias && cat.subcategorias.length > 0 ? 'tabela-anual__linha--expansivel' : '' %>" data-anual-toggle="cat-desp-<%= cat.categoria_id %>">
                            <td>
                                <% if (cat.subcategorias && cat.subcategorias.length > 0) { %><span>▸ </span><% } %>
                                <strong><%= cat.categoria_nome || t('relatorios.sem_categoria') %></strong>
                            </td>
                            <% for (let m = 1; m <= 12; m++) { %>
                                <td style="text-align: right;"><%= cat.meses[m] > 0 ? moeda(cat.meses[m]) : '—' %></td>
                            <% } %>
                            <td style="text-align: right; font-weight: 700;"><%= moeda(cat.total) %></td>
                        </tr>
                        <% (cat.subcategorias || []).forEach(sub => { %>
                            <tr class="tabela-anual__linha--sub" data-anual-pai="cat-desp-<%= cat.categoria_id %>" hidden style="background: var(--bg);">
                                <td style="padding-left: 28px;"><%= sub.categoria_nome %></td>
                                <% for (let m = 1; m <= 12; m++) { %>
                                    <td style="text-align: right;"><%= sub.meses[m] > 0 ? moeda(sub.meses[m]) : '—' %></td>
                                <% } %>
                                <td style="text-align: right;"><%= moeda(sub.total) %></td>
                            </tr>
                        <% }) %>
                    <% }) %>
                <% } %>

                <!-- Saldo Mensal -->
                <tr style="font-weight: 800; border-top: 2px solid var(--border);">
                    <td><%= t('relatorios.balanco_liquido') %></td>
                    <% for (let m = 1; m <= 12; m++) { %>
                        <% const sVal = demonstrativoAnual ? (demonstrativoAnual.saldo_mensal[m] || 0) : 0; %>
                        <td style="text-align: right; color: <%= sVal >= 0 ? 'var(--green)' : 'var(--red)' %>;">
                            <%= sVal !== 0 ? moeda(sVal) : '—' %>
                        </td>
                    <% } %>
                    <td style="text-align: right; color: var(--text);">
                        <%
                        let totSaldo = 0;
                        if (demonstrativoAnual && demonstrativoAnual.saldo_mensal) {
                            for (let m = 1; m <= 12; m++) totSaldo += (demonstrativoAnual.saldo_mensal[m] || 0);
                        }
                        %>
                        <%= moeda(totSaldo) %>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
<% } %>
