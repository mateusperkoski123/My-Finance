<%# Tabela de pendentes (uma lista). Espera: lista, tipo ('receita'|'despesa'). Usada plana ou dentro de um grupo. %>
<% const _rec = tipo === 'receita'; const _cor = _rec ? 'var(--green)' : 'var(--red)'; %>
<div class="tabela-container">
    <table class="tabela tabela-pend">
        <thead>
            <tr>
                <th><%= t('comum.descricao_categoria') %></th>
                <th><%= t('comum.data') %></th>
                <th><%= t('comum.valor') %></th>
                <th><%= t('tabela.acoes') %></th>
            </tr>
        </thead>
        <tbody>
            <% if (lista.length === 0) { %>
                <tr>
                    <td colspan="4" class="tabela__vazio" style="text-align: center; color: var(--muted); padding: 20px;"><%= t('relatorios.pendentes_vazio') %></td>
                </tr>
            <% } else { %>
                <% lista.forEach(p => { %>
                    <tr>
                        <td>
                            <strong title="<%= p.descricao %>" style="display: block; max-width: 240px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= truncarTexto(p.descricao, 45) %></strong>
                            <div style="font-size: 11px; color: var(--muted); max-width: 240px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                <%= p.categoria_nome || '—' %><%= p.subcategoria_nome ? ' / ' + p.subcategoria_nome : '' %> • <%= p.conta_nome || '—' %>
                            </div>
                        </td>
                        <td style="white-space: nowrap; font-size: 13px;"><%= formatDate(p.data_competencia, 'DD/MM/YYYY') %></td>
                        <td style="font-weight: 700; color: <%= _cor %>; white-space: nowrap;">
                            <%= _rec ? '+' : '-' %> <%= moeda(Math.abs(p.valor)) %>
                        </td>
                        <td>
                            <div style="display: flex; gap: 6px; align-items: center;">
                                <button type="button" class="btn-editar-linha" title="<%= t('acao.editar') %>" aria-label="<%= t('acao.editar') %>" data-editar-lanc="<%= JSON.stringify({ id: p.id, tipo: p.tipo, descricao: p.descricao, valor: Math.abs(parseFloat(p.valor)), conta_id: p.conta_id, categoria_id: p.categoria_id, data_competencia: formatDate(p.data_competencia, 'YYYY-MM-DD'), data_pagamento: '', status: p.status, serie: !!p.serie_id }) %>"><i class="ph ph-pencil-simple"></i></button>
                                <form method="post" action="/lancamentos/<%= p.id %>/marcar-pago" style="display:inline;" data-ajax>
                                    <%- csrfCampo %>
                                    <input type="hidden" name="voltar" value="<%= currentUrl %>">
                                    <input type="hidden" name="status" value="pago">
                                    <button type="submit" class="btn-pagar"><i class="ph ph-check-circle"></i><span><%= _rec ? t('acao.receber') : t('acao.pagar') %></span></button>
                                </form>
                                <form method="post" action="/lancamentos/<%= p.id %>/excluir" data-ajax data-confirm="<%= t('painel.lancamento.confirmar_exclusao') %>" style="display:inline;">
                                    <%- csrfCampo %>
                                    <input type="hidden" name="voltar" value="<%= currentUrl %>">
                                    <button type="submit" class="icon-btn" title="<%= t('comum.excluir') %>" style="color: var(--red);"><i class="ph ph-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>
</div>
