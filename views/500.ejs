<div style="min-height: 70vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 20px;">
    <div class="card" style="max-width: 480px; padding: 32px; border-radius: 20px;">
        <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--red-bg); color: var(--red); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
            <i class="ph ph-warning-circle" style="font-size: 32px;"></i>
        </div>
        <h1 style="font-size: 24px; font-weight: 800; margin-bottom: 8px;"><%= t('erro500.titulo') %></h1>
        <p class="muted" style="font-size: 14px; margin-bottom: 24px;"><%= t('erro500.texto') %></p>
        <a href="/" class="btn btn-primary" style="border-radius: 12px; padding: 10px 24px;"><%= t('erro500.voltar') %></a>
    </div>
</div>
