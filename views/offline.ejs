<div class="card card-body" style="max-width: 560px; margin: 40px auto; text-align: center; padding: 40px 24px; border-radius: 16px;">
    <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--muted-bg, rgba(255, 255, 255, 0.05)); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto;">
        <i class="ph ph-wifi-slash" style="font-size: 36px; color: var(--muted, #8a8d93);"></i>
    </div>
    <h2 id="offline-titulo" style="font-size: 22px; font-weight: 700; margin-bottom: 12px; color: var(--text);"><%= t('offline.titulo') %></h2>
    <p style="color: var(--muted, #8a8d93); font-size: 14px; line-height: 1.6; margin-bottom: 24px;">
        <%= t('offline.mensagem') %>
    </p>

    <div style="background: var(--card-bg, #141721); border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1)); border-radius: 12px; padding: 20px; text-align: left; margin-bottom: 24px;">
        <div style="font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px; color: var(--text);">
            <%= t('offline.recursos_titulo') %>
        </div>
        <ul style="margin: 0; padding-left: 20px; font-size: 13px; color: var(--muted, #8a8d93); line-height: 1.6;">
            <li style="margin-bottom: 8px;"><%= t('offline.recursos_item1') %></li>
            <li><%= t('offline.recursos_item2') %></li>
        </ul>
    </div>

    <button type="button" class="btn btn-primary btn-block" onclick="window.location.reload();" style="display: flex; align-items: center; justify-content: center; gap: 8px; height: 44px; font-size: 14px;">
        <i class="ph ph-arrows-clockwise" style="font-size: 18px;"></i>
        <span><%= t('offline.tentar_novamente') %></span>
    </button>
</div>
<script>
// A tela offline e servida na URL que o usuario tentou abrir: se for um modulo que so funciona com internet, diz isso.
(function () {
    if (/^\/(ia|comunidade|admin|assinatura)(\/|$)/.test(location.pathname)) {
        document.getElementById('offline-titulo').textContent = <%- JSON.stringify(t('off.modulo_requer')) %>;
    }
})();
</script>
