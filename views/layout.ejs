<script>
// PWA Service Worker Registration & Installation Handler
(function() {
    const GF_PWA_T = {
        online: <%- JSON.stringify(t('pwa.online')) %>,
        offline: <%- JSON.stringify(t('pwa.offline')) %>,
        instalar_dica_ios: <%- JSON.stringify(t('pwa.instalar_dica_ios')) %>
    };

    // O indicador de conexao e atualizado por app-conexao.js (consulta o servidor de verdade).

    const GF_USER_ID = <%- usuarioLogado ? Number(usuarioLogado.id) : 'null' %>;
    window.GF_USER_ID = GF_USER_ID;
    const NA_TELA_DE_ENTRADA = /^\/(login|cadastro)(\/|$)/.test(location.pathname);
    let atualizacaoPedida = false;

    function avisarServiceWorker(msg) {
        if (!('serviceWorker' in navigator)) return;
        navigator.serviceWorker.ready.then(function(reg) { if (reg.active) reg.active.postMessage(msg); }).catch(function() {});
    }

    if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
            navigator.serviceWorker.register('/service-worker.js', { scope: '/' })
                .then(function(reg) {
                    // Versao nova ja instalada e esperando (ex.: aba aberta durante o deploy)
                    if (reg.waiting && navigator.serviceWorker.controller) {
                        const aviso = document.getElementById('pwa-update-banner');
                        if (aviso) aviso.style.display = 'flex';
                    }
                    reg.addEventListener('updatefound', function() {
                        const novo = reg.installing;
                        if (!novo) return;
                        novo.addEventListener('statechange', function() {
                            if (novo.state === 'installed' && navigator.serviceWorker.controller) {
                                const aviso = document.getElementById('pwa-update-banner');
                                if (aviso) aviso.style.display = 'flex';
                            }
                        });
                    });
                }).catch(function(err) {
                    console.warn('SW registration failed:', err);
                });

            // So recarrega quando o proprio usuario pediu a atualizacao (nunca no meio de um formulario).
            navigator.serviceWorker.addEventListener('controllerchange', function() {
                if (atualizacaoPedida) window.location.reload();
            });

            if (GF_USER_ID) {
                avisarServiceWorker({ type: 'SET_USER', id: String(GF_USER_ID) });
            } else if (NA_TELA_DE_ENTRADA && navigator.onLine) {
                // Saiu da conta (ou sessao expirou): apaga paginas e dados locais do usuario anterior.
                avisarServiceWorker({ type: 'CLEAR_USER_DATA' });
                if (window.AppSync && window.AppSync.encerrarSessaoLocal) window.AppSync.encerrarSessaoLocal();
            }
        });
    }

    // Ao sair: revoga o token deste aparelho e apaga o cache de paginas.
    document.addEventListener('submit', function(e) {
        const f = e.target;
        if (f && f.getAttribute && f.getAttribute('action') === '/logout') {
            avisarServiceWorker({ type: 'CLEAR_USER_DATA' });
            if (window.AppSync && window.AppSync.encerrarSessaoLocal) window.AppSync.encerrarSessaoLocal();
        }
    }, true);

    const btnUpdate = document.getElementById('btn-pwa-update');
    if (btnUpdate) {
        btnUpdate.addEventListener('click', function() {
            if (navigator.serviceWorker) {
                navigator.serviceWorker.getRegistration().then(function(reg) {
                    if (reg && reg.waiting) {
                        atualizacaoPedida = true;
                        reg.waiting.postMessage({ type: 'SKIP_WAITING' });
                    }
                });
            }
        });
    }
})();
</script>
</body>
</html>
