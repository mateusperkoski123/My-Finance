<script>
window.gfMoeda = {
    codigo: '<%= currency %>',
    decimais: <%= currency === 'PYG' ? 0 : 2 %>,
    temCentavos: <%= currency !== 'PYG' %>,
    simbolo: '<%= currency === "PYG" ? "Gs." : (currency === "BRL" ? "R$" : (currency === "USD" ? "$" : (currency === "EUR" ? "€" : "$"))) %>',
    milhar: '<%= currency === "USD" ? "," : "." %>',
    decimal: '<%= currency === "USD" ? "." : "," %>',
    separadorMilhar: '<%= currency === "USD" ? "," : "." %>',
    separadorDecimal: '<%= currency === "USD" ? "." : "," %>'
};

function abrirMenuMobile() {
    
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    if (backdrop) {
        backdrop.style.display = 'block';
        setTimeout(() => backdrop.classList.add('is-open'), 10);
    }
}
function fecharMenuMobile() {
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    if (backdrop) {
        backdrop.classList.remove('is-open');
        setTimeout(() => { backdrop.style.display = 'none'; }, 200);
    }
}
document.addEventListener('DOMContentLoaded', () => {
    // Faixa de icones do topo (celular): mostra o item ativo e indica com um degrade quando ha mais itens rolando.
    const faixa = document.querySelector('.navbar__links');
    if (faixa) {
        const ativo = faixa.querySelector('.is-active');
        if (ativo && faixa.scrollWidth > faixa.clientWidth) faixa.scrollLeft = Math.max(0, ativo.offsetLeft - (faixa.clientWidth - ativo.offsetWidth) / 2);
        const marcar = () => faixa.classList.toggle('tem-mais', faixa.scrollWidth - faixa.clientWidth - faixa.scrollLeft > 4);
        marcar(); faixa.addEventListener('scroll', marcar, { passive: true }); window.addEventListener('resize', marcar);
    }
    const toggleBtn = document.getElementById('btn-toggle-menu');
    if (toggleBtn) {
        toggleBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            abrirMenuMobile();
        });
    }
});
</script>
