    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link rel="stylesheet" href="/assets/css/app.css?v=<%= assetVersion %>">
</head>
<body>
<header class="navbar">
    <div class="navbar__inner">
        <!-- Top Left: Menu Toggle (Mobile Only) + Brand Logo + Online/Offline Badge -->
        <div style="display: flex; align-items: center; gap: 10px;">
            <a href="/" class="navbar__brand" style="display: flex; align-items: center; gap: 6px;">
                <i class="ph-fill ph-hands-clapping" style="font-size: 22px;"></i>
                <span style="font-size: 11px; text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em;">MyFinance</span>
            </a>
            <div id="pwa-status-badge" class="pwa-status-badge" role="status" aria-live="polite">
                <span class="pwa-status-dot"></span>
                <span id="pwa-status-text" class="pwa-status-text"><%= t('pwa.online') %></span>
            </div>
            <button type="button" id="pwa-fila-btn" class="pwa-fila-btn" hidden aria-label="<%= t('off.fila_aria') %>" title="<%= t('off.fila_titulo') %>">
                <i class="ph ph-clock-counter-clockwise"></i><span id="pwa-fila-n">0</span>
            </button>
        </div>

        <% if (usuarioLogado) { %>
            <nav class="navbar__links">
                <a href="/" title="<%= t('nav.visao_geral') %>" class="navbar__link <%= currentRoute === '/' ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-squares-four"></i></span>
                    <span class="navbar__label"><%= t('nav.visao_geral') %></span>
                </a>
                <a href="/relatorios" title="<%= t('nav.relatorios') %>" class="navbar__link <%= currentRoute === '/relatorios' ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-chart-bar"></i></span>
                    <span class="navbar__label"><%= t('nav.relatorios') %></span>
                </a>
                <a href="/categorias" title="<%= t('nav.categorias') %>" class="navbar__link <%= currentRoute === '/categorias' ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-tag"></i></span>
                    <span class="navbar__label"><%= t('nav.categorias') %></span>
                </a>
                <a href="/contas" title="<%= t('nav.contas') %>" class="navbar__link <%= currentRoute === '/contas' ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-bank"></i></span>
                    <span class="navbar__label"><%= t('nav.contas') %></span>
                </a>
                <% if (typeof ehAdmin !== 'undefined' && ehAdmin) { %>
                <a href="/admin" title="<%= t('nav.admin') %>" class="navbar__link <%= currentRoute.startsWith('/admin') ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-shield-star"></i></span>
                    <span class="navbar__label"><%= t('nav.admin') %></span>
                </a>
                <% } %>
                <% if (ehAdmin || (usuarioLogado && usuarioLogado.ia_habilitada)) { %>
                <a href="/ia" title="<%= t('nav.ia') %>" class="navbar__link <%= currentRoute.startsWith('/ia') ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-sparkle"></i></span>
                    <span class="navbar__label"><%= t('nav.ia') %></span>
                </a>
                <% } %>
                <a href="/comunidade" title="<%= t('nav.comunidad') %>" class="navbar__link <%= currentRoute.startsWith('/comunidade') ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-users-three"></i></span>
                    <span class="navbar__label"><%= t('nav.comunidad') %></span>
                </a>
                <a href="/configuracoes" title="<%= t('nav.configuracoes') %>" class="navbar__link <%= currentRoute.startsWith('/configuracoes') ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-gear"></i></span>
                    <span class="navbar__label"><%= t('nav.configuracoes') %></span>
                </a>
            </nav>
            <div class="navbar__user">
                <span class="navbar__user-nome" style="font-weight: 600;"><%= usuarioLogado.nome %></span>
                <button type="button" class="navbar__avatar" id="btn-toggle-menu" aria-label="<%= t('nav.menu') %>"><%= usuarioLogado.nome ? usuarioLogado.nome.charAt(0).toUpperCase() : 'U' %></button>
            </div>
        <% } %>
    </div>
</header>

<main class="container">
    <!-- PWA Banners -->
    <div id="pwa-update-banner" class="alert alert-aviso pwa-banner" style="display: none; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <i class="ph ph-arrows-clockwise" style="font-size: 20px;"></i>
            <span><%= t('pwa.atualizacao_disponivel') %></span>
        </div>
        <button type="button" id="btn-pwa-update" class="btn btn-sm btn-primary"><%= t('pwa.atualizar') %></button>
    </div>

    <div id="pwa-install-banner" class="alert alert-aviso pwa-banner" style="display: none; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px;">
        <div style="display: flex; align-items: center; gap: 8px; flex: 1;">
            <i class="ph ph-download-simple" style="font-size: 20px;"></i>
            <span id="pwa-install-text"><%= t('pwa.instalar_app') %></span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
            <button type="button" id="btn-pwa-install" class="btn btn-sm btn-primary"><%= t('pwa.instalar_app') %></button>
            <button type="button" id="btn-pwa-dismiss" class="btn btn-sm btn-outline" aria-label="<%= t('pwa.dispensar') %>">&times;</button>
        </div>
    </div>
    <% if (flash) { %>
        <%
            let msgText = flash.mensagem || '';
            if (msgText.startsWith('flash.')) {
                const resText = t(msgText);
                msgText = resText.startsWith('flash.') ? (flash.tipo === 'sucesso' ? t('flash.generico_ok') : t('flash.generico_erro')) : resText;
            }
        %>
        <div class="alert alert-<%= flash.tipo === 'sucesso' ? 'sucesso' : 'erro' %>" style="display: flex; align-items: center; gap: 8px;">
            <i class="ph-bold <%= flash.tipo === 'sucesso' ? 'ph-check-circle' : 'ph-warning-circle' %>" style="font-size: 18px;"></i>
            <span><%= msgText %></span>
        </div>
    <% } %>

    <% if (typeof assinatura !== 'undefined' && assinatura && usuarioLogado) { %>
        <% const _st = assinatura.status_efetivo; %>
        <% if (_st === 'vencida' || _st === 'cancelada') { %>
            <div class="alert alert-erro faixa-conta"><i class="ph ph-lock-simple"></i> <span><%= t('faixa.somente_leitura') %></span> <a href="/assinatura" class="btn btn-sm btn-primary"><%= t('faixa.ver_planos') %></a></div>
        <% } else if (_st === 'trial') { %>
            <div class="alert alert-aviso faixa-conta"><i class="ph ph-gift"></i> <span><%= t('faixa.trial', { dias: assinatura.dias_restantes }) %></span> <a href="/assinatura" class="btn btn-sm btn-outline"><%= t('faixa.ver_planos') %></a></div>
        <% } else if (_st === 'ativa' && assinatura.dias_restantes <= 5) { %>
            <div class="alert alert-aviso faixa-conta"><i class="ph ph-clock-countdown"></i> <span><%= t('faixa.renovar', { dias: assinatura.dias_restantes }) %></span> <a href="/assinatura" class="btn btn-sm btn-outline"><%= t('faixa.renovar_botao') %></a></div>
        <% } %>
        <% if (emailNaoVerificado) { %>
            <div class="alert alert-aviso faixa-conta"><i class="ph ph-envelope-simple"></i> <span><%= t('faixa.verificar_email') %></span>
                <form method="post" action="/verificar-email/reenviar" style="display: inline;"><%- csrfCampo %><button type="submit" class="btn btn-sm btn-outline"><%= t('conta.reenviar') %></button></form></div>
        <% } %>
    <% } %>

    <%- include('partials/saldos_contas') %>

    <%- body %>
</main>

