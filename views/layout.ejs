    <link rel="icon" type="image/png" href="/assets/icons/icon-192.png">
    <link rel="apple-touch-icon" href="/assets/icons/icon-192.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="MyFinance">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title ? title + ' - ' + t('app.nome') : t('app.nome') %></title>
    <script>
    window.GF_T = {
        total: <%- JSON.stringify(t('comum.total')) %>,
        receitas: <%- JSON.stringify(t('comum.receitas')) %>,
        despesas: <%- JSON.stringify(t('comum.despesas')) %>,
        saldo: <%- JSON.stringify(t('comum.saldo')) %>,
        sem_categoria: <%- JSON.stringify(t('comum.sem_categoria')) %>,
        sel_cat_primeiro: <%- JSON.stringify(t('modal.sel_cat_primeiro')) %>,
        sem_subcategoria: <%- JSON.stringify(t('js.sem_subcategoria')) %>,
        categoria_sem_sub: <%- JSON.stringify(t('js.categoria_sem_sub')) %>,
        dica_sub_html: <%- JSON.stringify(t('js.dica_sub_html')) %>,
        foi_recebida: <%- JSON.stringify(t('modal.foi_recebida')) %>,
        foi_pago: <%- JSON.stringify(t('modal.foi_pago')) %>,
        nao_foi_recebida: <%- JSON.stringify(t('modal.nao_foi_recebida')) %>,
        nao_foi_pago: <%- JSON.stringify(t('modal.nao_foi_pago')) %>,
        data_recebimento: <%- JSON.stringify(t('modal.data_recebimento')) %>,
        data_pagamento: <%- JSON.stringify(t('modal.data_pagamento')) %>,
        data_vencimento: <%- JSON.stringify(t('modal.data_vencimento')) %>,
        adicionar_saldo: <%- JSON.stringify(t('contas.adicionar_saldo')) %>,
        subtrair_saldo: <%- JSON.stringify(t('contas.subtrair_saldo')) %>,
        com_seguir: <%- JSON.stringify(t('comunidade.js.seguir')) %>,
        com_deixar: <%- JSON.stringify(t('comunidade.js.deixar')) %>,
        com_max_imgs: <%- JSON.stringify(t('comunidade.js.max_imgs')) %>,
        com_conf_coment: <%- JSON.stringify(t('comunidade.js.conf_coment')) %>,
        com_conf_post: <%- JSON.stringify(t('comunidade.js.conf_post')) %>,
        com_conf_admin: <%- JSON.stringify(t('comunidade.js.conf_admin')) %>,
        cat_nova: <%- JSON.stringify(t('cat_rapida.nova_categoria')) %>,
        sub_nova: <%- JSON.stringify(t('cat_rapida.nova_subcategoria')) %>,
        cat_nome_ph: <%- JSON.stringify(t('cat_rapida.nome_ph')) %>,
        cat_salvar: <%- JSON.stringify(t('cat_rapida.salvar')) %>,
        cat_cancelar: <%- JSON.stringify(t('cat_rapida.cancelar')) %>,
        cat_escolha: <%- JSON.stringify(t('cat_rapida.escolha_categoria')) %>,
        cat_cor: <%- JSON.stringify(t('cat_rapida.cor')) %>,
        cat_erro: <%- JSON.stringify(t('cat_rapida.erro')) %>,
        erro_acao: <%- JSON.stringify(t('js.erro_acao')) %>
    };
