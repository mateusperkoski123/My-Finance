<!doctype html>
<html lang="<%= lang %>" data-tema="<%= theme %>">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0b0d12">
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials">
    <link rel="icon" type="image/png" href="/assets/icons/icon-192.png">
    <link rel="apple-touch-icon" href="/assets/icons/icon-192.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="MyFinance">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <script src="/assets/js/app-instalar.js"></script>
    <title><%= title ? title + ' - ' + t('app.nome') : t('app.nome') %></title>
    <script>
    window.GF_T = {
        total: <%- JSON.stringify(t('comum.total')) %>,
        receitas: <%- JSON.stringify(t('comum.receitas')) %>,
        despesas: <%- JSON.stringify(t('comum.despesas')) %>,
        saldo: <%- JSON.stringify(t('comum.saldo')) %>,
        sem_categoria: <%- JSON.stringify(t('comum.sem_categoria')) %>,
        sel_cat_primeiro: <%- JSON.stringify(t('modal.sel_cat_primeiro')) %>,
        sem_subcategoria: <%- JSON.stringify(t('js.sem_subcategoria')) %>,
        categoria_sem_sub: <%- JSON.stringify(t('js.categoria_sem_sub')) %>,
        dica_sub_html: <%- JSON.stringify(t('js.dica_sub_html')) %>,
        foi_recebida: <%- JSON.stringify(t('modal.foi_recebida')) %>,
        foi_pago: <%- JSON.stringify(t('modal.foi_pago')) %>,
        nao_foi_recebida: <%- JSON.stringify(t('modal.nao_foi_recebida')) %>,
        nao_foi_pago: <%- JSON.stringify(t('modal.nao_foi_pago')) %>,
        data_recebimento: <%- JSON.stringify(t('modal.data_recebimento')) %>,
        data_pagamento: <%- JSON.stringify(t('modal.data_pagamento')) %>,
        data_vencimento: <%- JSON.stringify(t('modal.data_vencimento')) %>,
        adicionar_saldo: <%- JSON.stringify(t('contas.adicionar_saldo')) %>,
        subtrair_saldo: <%- JSON.stringify(t('contas.subtrair_saldo')) %>,
        com_seguir: <%- JSON.stringify(t('comunidade.js.seguir')) %>,
        com_deixar: <%- JSON.stringify(t('comunidade.js.deixar')) %>,
        com_max_imgs: <%- JSON.stringify(t('comunidade.js.max_imgs')) %>,
        com_conf_coment: <%- JSON.stringify(t('comunidade.js.conf_coment')) %>,
        com_conf_post: <%- JSON.stringify(t('comunidade.js.conf_post')) %>,
        com_conf_admin: <%- JSON.stringify(t('comunidade.js.conf_admin')) %>,
        cat_nova: <%- JSON.stringify(t('cat_rapida.nova_categoria')) %>,
        sub_nova: <%- JSON.stringify(t('cat_rapida.nova_subcategoria')) %>,
        cat_nome_ph: <%- JSON.stringify(t('cat_rapida.nome_ph')) %>,
        cat_salvar: <%- JSON.stringify(t('cat_rapida.salvar')) %>,
        cat_cancelar: <%- JSON.stringify(t('cat_rapida.cancelar')) %>,
        cat_escolha: <%- JSON.stringify(t('cat_rapida.escolha_categoria')) %>,
        cat_cor: <%- JSON.stringify(t('cat_rapida.cor')) %>,
        cat_erro: <%- JSON.stringify(t('cat_rapida.erro')) %>,
        erro_acao: <%- JSON.stringify(t('js.erro_acao')) %>,
        valor_invalido: <%- JSON.stringify(t('flash.lanc_valor_invalido')) %>
    };
    </script>
    <%# Icones (Phosphor): so os tres pesos usados no sistema, em versao fixa e direto como folha de estilo
        (o carregador por script trazia seis pesos e so aplicava os icones depois de a pagina aparecer). %>
    <%# Conexao com o CDN dos icones aberta antes de pedir os arquivos (os 3 estilos bloqueiam a primeira exibicao da pagina). %>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <% ['regular', 'bold', 'fill'].forEach(function (peso) { %><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/<%= peso %>/style.css" crossorigin="anonymous">
    <% }) %><link rel="stylesheet" href="/assets/css/app.css?v=<%= assetVersion %>">
</head>
<body>
<header class="navbar">
    <div class="navbar__inner">
        <!-- Top Left: Menu Toggle (Mobile Only) + Brand Logo + Online/Offline Badge -->
        <%# Plano com Chat IA e o admin nao desligou este usuario: mostra o Chat. Plano sem IA: mostra com o selo do plano que inclui. %>
        <%# (As paginas de erro podem ser montadas antes das regras de conta: por isso os "typeof".) %>
        <% const _ass = typeof assinatura !== 'undefined' ? assinatura : null; %>
        <% const _adm = typeof ehAdmin !== 'undefined' && ehAdmin; %>
        <% const _bloq = typeof acessoBloqueado !== 'undefined' && acessoBloqueado; %>
        <% const _planoTemIa = Boolean(_ass && _ass.plano && _ass.plano.rec_ia); %>
        <% const _mostrarIa = Boolean(usuarioLogado && (_adm || !_planoTemIa || usuarioLogado.ia_habilitada)); %>
        <% const _seloIa = !_adm && !_planoTemIa; %>
        <div style="display: flex; align-items: center; gap: 10px;">
            <a href="/" class="navbar__brand" style="display: flex; align-items: center; gap: 6px;">
                <i class="ph-fill ph-hands-clapping" style="font-size: 22px;"></i>
                <span style="font-size: 12px; text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em;">MyFinance</span>
            </a>
            <div id="pwa-status-badge" class="pwa-status-badge" role="status" aria-live="polite">
                <span class="pwa-status-dot"></span>
                <span id="pwa-status-text" class="pwa-status-text"><%= t('pwa.online') %></span>
            </div>
            <button type="button" id="pwa-fila-btn" class="pwa-fila-btn" hidden aria-label="<%= t('off.fila_aria') %>" title="<%= t('off.fila_titulo') %>">
                <i class="ph ph-clock-counter-clockwise"></i><span id="pwa-fila-n">0</span>
            </button>
        </div>

        <% if (usuarioLogado && _bloq) { %>
            <%# Sem teste em andamento e sem plano contratado: so a tela de escolher/contratar um plano e a saida. %>
            <div class="navbar__user navbar__user--bloqueado">
                <span class="navbar__user-nome" style="font-weight: 600;"><%= usuarioLogado.nome %></span>
                <form method="post" action="/logout" style="margin: 0;">
                    <%- csrfCampo %>
                    <button type="submit" class="navbar__sair"><i class="ph ph-sign-out" aria-hidden="true"></i> <%= t('nav.sair') %></button>
                </form>
            </div>
        <% } else if (usuarioLogado) { %>
            <nav class="navbar__links">
                <a href="/" title="<%= t('nav.visao_geral') %>" class="navbar__link <%= currentRoute === '/' ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-squares-four"></i></span>
                    <span class="navbar__label"><%= t('nav.visao_geral') %></span>
                </a>
                <a href="/relatorios" title="<%= t('nav.relatorios') %>" class="navbar__link <%= currentRoute === '/relatorios' ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-chart-bar"></i></span>
                    <span class="navbar__label"><%= t('nav.relatorios') %></span>
                </a>
                <a href="/categorias" title="<%= t('nav.categorias') %>" class="navbar__link <%= currentRoute === '/categorias' ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-tag"></i></span>
                    <span class="navbar__label"><%= t('nav.categorias') %></span>
                </a>
                <a href="/contas" title="<%= t('nav.contas') %>" class="navbar__link <%= currentRoute === '/contas' ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-bank"></i></span>
                    <span class="navbar__label"><%= t('nav.contas') %></span>
                </a>
                <% if (typeof ehAdmin !== 'undefined' && ehAdmin) { %>
                <a href="/admin" title="<%= t('nav.admin') %>" class="navbar__link <%= currentRoute.startsWith('/admin') ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-shield-star"></i></span>
                    <span class="navbar__label"><%= t('nav.admin') %></span>
                </a>
                <% } %>
                <% if (_mostrarIa) { %>
                <a href="/ia" title="<%= t('nav.ia') %>" class="navbar__link <%= currentRoute.startsWith('/ia') ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-sparkle"></i></span>
                    <span class="navbar__label"><%= t('nav.ia') %></span>
                    <% if (_seloIa) { %><span class="navbar__coroa" title="<%= t('bloq.disponivel_no', { plano: t('plano.premium.nome') }) %>"><i class="ph-fill ph-crown-simple" aria-hidden="true"></i></span><% } %>
                </a>
                <% } %>
                <a href="/comunidade" title="<%= t('nav.comunidad') %>" class="navbar__link <%= currentRoute.startsWith('/comunidade') ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-users-three"></i></span>
                    <span class="navbar__label"><%= t('nav.comunidad') %></span>
                    <% if (novidadesNovas > 0) { %><span class="selo-novidade" title="<%= t('novidades.selo_titulo', { n: novidadesNovas }) %>"><%= novidadesNovas > 9 ? '9+' : novidadesNovas %></span><% } %>
                </a>
                <a href="/configuracoes" title="<%= t('nav.configuracoes') %>" class="navbar__link <%= currentRoute.startsWith('/configuracoes') ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-gear"></i></span>
                    <span class="navbar__label"><%= t('nav.configuracoes') %></span>
                </a>
            </nav>
            <div class="navbar__user">
                <span class="navbar__user-nome" style="font-weight: 600;"><%= usuarioLogado.nome %></span>
                <div class="navbar__perfil">
                    <button type="button" class="navbar__avatar js-avatar" id="btn-toggle-menu" aria-haspopup="menu" aria-expanded="false" aria-label="<%= t('foto.menu_aria') %>" data-inicial="<%= usuarioLogado.nome ? usuarioLogado.nome.charAt(0).toUpperCase() : 'U' %>"><%- include('partials/avatar') %></button>
                    <div class="menu-perfil" id="menu-perfil" role="menu" hidden>
                        <div class="menu-perfil__topo">
                            <span class="menu-perfil__avatar js-avatar" data-inicial="<%= usuarioLogado.nome ? usuarioLogado.nome.charAt(0).toUpperCase() : 'U' %>"><%- include('partials/avatar') %></span>
                            <div class="menu-perfil__dados"><strong><%= usuarioLogado.nome %></strong><span><%= usuarioLogado.email || '' %></span></div>
                        </div>
                        <button type="button" role="menuitem" class="menu-perfil__item" data-abrir-foto><i class="ph ph-camera"></i> <span data-rotulo-foto><%= usuarioLogado.foto_em ? t('foto.alterar') : t('foto.adicionar') %></span></button>
                        <a role="menuitem" class="menu-perfil__item" href="/configuracoes/perfil"><i class="ph ph-user"></i> <%= t('config.menu.perfil') %></a>
                        <a role="menuitem" class="menu-perfil__item" href="/guia"><i class="ph ph-book-open"></i> <%= t('guia.titulo') %></a>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</header>

<main class="container">
    <!-- PWA Banners -->
    <div id="pwa-update-banner" class="alert alert-aviso pwa-banner" style="display: none; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <i class="ph ph-arrows-clockwise" style="font-size: 20px;"></i>
            <span><%= t('pwa.atualizacao_disponivel') %></span>
        </div>
        <button type="button" id="btn-pwa-update" class="btn btn-sm btn-primary"><%= t('pwa.atualizar') %></button>
    </div>

    <div id="pwa-install-banner" class="alert alert-aviso pwa-banner" role="dialog" aria-live="polite" style="display: none; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px;">
        <div style="display: flex; align-items: center; gap: 8px; flex: 1;">
            <i class="ph ph-download-simple" style="font-size: 20px;"></i>
            <span id="pwa-install-text"><%= t('pwa.pergunta_instalar') %></span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
            <button type="button" id="btn-pwa-sim" class="btn btn-sm btn-primary"><%= t('pwa.sim') %></button>
            <button type="button" id="btn-pwa-nao" class="btn btn-sm btn-outline"><%= t('pwa.nao') %></button>
        </div>
    </div>
    <% if (flash) { %>
        <%
            let msgText = flash.mensagem || '';
            if (msgText.startsWith('flash.')) {
                const resText = t(msgText);
                msgText = resText.startsWith('flash.') ? (flash.tipo === 'sucesso' ? t('flash.generico_ok') : t('flash.generico_erro')) : resText;
            }
        %>
        <%# data-flash: so esta mensagem some sozinha depois de alguns segundos (app.js); as faixas e os avisos fixos ficam. %>
        <div class="alert alert-<%= flash.tipo === 'sucesso' ? 'sucesso' : 'erro' %>" data-flash role="<%= flash.tipo === 'sucesso' ? 'status' : 'alert' %>" style="display: flex; align-items: center; gap: 8px;">
            <i class="ph-bold <%= flash.tipo === 'sucesso' ? 'ph-check-circle' : 'ph-warning-circle' %>" style="font-size: 18px;"></i>
            <span><%= msgText %></span>
        </div>
    <% } %>

    <% if (typeof assinatura !== 'undefined' && assinatura && usuarioLogado) { %>
        <% const _st = assinatura.status_efetivo; %>
        <% if (_st === 'vencida' || _st === 'cancelada') { %>
            <div class="alert alert-erro faixa-conta"><i class="ph ph-lock-simple"></i> <span><%= t('faixa.somente_leitura') %></span> <a href="/assinatura" class="btn btn-sm btn-primary"><%= t('faixa.ver_planos') %></a></div>
        <% } else if (_st === 'trial' && currentRoute !== '/assinatura') { %>
            <% if (emailNaoVerificado) { %>
            <%# Teste e e-mail por confirmar: uma faixa so (antes eram duas e empurravam o conteudo para baixo). %>
            <div class="alert alert-aviso faixa-conta faixa-conta--junta"><i class="ph ph-gift"></i> <span><b><%= assinatura.teste_plano ? t('faixa.trial_curto_plano', { plano: t('plano.' + assinatura.plano_codigo + '.curto'), dias: assinatura.dias_restantes }) : t('faixa.trial_curto', { dias: assinatura.dias_restantes }) %></b> · <form method="post" action="/verificar-email/reenviar" class="faixa-conta__link"><%- csrfCampo %><button type="submit" title="<%= t('conta.reenviar') %>"><%= t('faixa.confirmar_email_curto') %></button></form></span> <a href="/assinatura" class="btn btn-sm btn-outline"><%= t('faixa.ver_planos') %></a></div>
            <% } else { %>
            <div class="alert alert-aviso faixa-conta"><i class="ph ph-gift"></i> <span><%= assinatura.teste_plano ? t('faixa.trial_plano', { plano: t('plano.' + assinatura.plano_codigo + '.nome'), dias: assinatura.dias_restantes }) : t('faixa.trial', { dias: assinatura.dias_restantes }) %></span> <a href="/assinatura" class="btn btn-sm btn-outline"><%= t('faixa.ver_planos') %></a></div>
            <% } %>
        <% } else if (_st === 'ativa' && assinatura.dias_restantes <= 5) { %>
            <div class="alert alert-aviso faixa-conta"><i class="ph ph-clock-countdown"></i> <span><%= t('faixa.renovar', { dias: assinatura.dias_restantes }) %></span> <a href="/assinatura" class="btn btn-sm btn-outline"><%= t('faixa.renovar_botao') %></a></div>
        <% } %>
        <% if (emailNaoVerificado && !(_st === 'trial' && currentRoute !== '/assinatura')) { %>
            <div class="alert alert-aviso faixa-conta"><i class="ph ph-envelope-simple"></i> <span><%= t('faixa.verificar_email') %></span>
                <form method="post" action="/verificar-email/reenviar" style="display: inline;"><%- csrfCampo %><button type="submit" class="btn btn-sm btn-outline"><%= t('conta.reenviar') %></button></form></div>
        <% } %>
    <% } %>

    <%- include('partials/saldos_contas') %>

    <%- body %>
</main>

<% if (usuarioLogado && !_bloq) { %>
    <%# Celular: barra de navegacao fixa embaixo. O + abre Receita/Despesa; "Mais" abre o resto (a faixa do topo so tem a marca e o perfil). %>
    <% const _rota = currentRoute || ''; const _principal = _rota === '/' || _rota.startsWith('/relatorios') || _rota.startsWith('/contas'); %>
    <div class="folha-fundo" id="folha-fundo" hidden></div>
    <div class="folha" id="folha-novo" role="menu" hidden>
        <button type="button" role="menuitem" class="folha__item" data-novo="receita"><i class="ph ph-arrow-circle-up" style="color: var(--green);"></i> <%= t('painel.nova_receita') %></button>
        <button type="button" role="menuitem" class="folha__item" data-novo="despesa"><i class="ph ph-arrow-circle-down" style="color: var(--red);"></i> <%= t('painel.nova_despesa') %></button>
    </div>
    <div class="folha" id="folha-mais" role="menu" hidden>
        <a role="menuitem" class="folha__item <%= _rota.startsWith('/categorias') ? 'is-active' : '' %>" href="/categorias"><i class="ph ph-tag"></i> <%= t('nav.categorias') %></a>
        <a role="menuitem" class="folha__item <%= _rota.startsWith('/comunidade') ? 'is-active' : '' %>" href="/comunidade"><i class="ph ph-users-three"></i> <%= t('nav.comunidad') %><% if (novidadesNovas > 0) { %> <span class="selo-novidade" title="<%= t('novidades.selo_titulo', { n: novidadesNovas }) %>"><%= novidadesNovas > 9 ? '9+' : novidadesNovas %></span><% } %></a>
        <% if (_mostrarIa) { %><a role="menuitem" class="folha__item <%= _rota.startsWith('/ia') ? 'is-active' : '' %>" href="/ia"><i class="ph ph-sparkle"></i> <%= t('nav.ia') %><% if (_seloIa) { %> <%- include('partials/selo_plano', { plano: 'premium' }) %><% } %></a><% } %>
        <% if (_adm) { %><a role="menuitem" class="folha__item <%= _rota.startsWith('/admin') ? 'is-active' : '' %>" href="/admin"><i class="ph ph-shield-star"></i> <%= t('nav.admin') %></a><% } %>
        <a role="menuitem" class="folha__item <%= _rota.startsWith('/guia') ? 'is-active' : '' %>" href="/guia"><i class="ph ph-book-open"></i> <%= t('guia.titulo') %></a>
        <a role="menuitem" class="folha__item <%= _rota === '/assinatura' ? 'is-active' : '' %>" href="/assinatura"><i class="ph ph-crown-simple"></i> <%= t('config.menu.assinatura') %></a>
        <a role="menuitem" class="folha__item <%= _rota.startsWith('/configuracoes') ? 'is-active' : '' %>" href="/configuracoes"><i class="ph ph-gear"></i> <%= t('nav.configuracoes') %></a>
        <hr>
        <form method="post" action="/logout"><%- csrfCampo %><button type="submit" role="menuitem" class="folha__item folha__item--sair"><i class="ph ph-sign-out"></i> <%= t('nav.sair') %></button></form>
    </div>
    <nav class="barra-inf" aria-label="<%= t('nav.principal') %>">
        <a href="/" class="<%= _rota === '/' ? 'is-active' : '' %>"><i class="ph<%= _rota === '/' ? '-fill' : '' %> ph-house"></i><span><%= t('nav.visao_geral') %></span></a>
        <a href="/relatorios" class="<%= _rota.startsWith('/relatorios') ? 'is-active' : '' %>"><i class="ph<%= _rota.startsWith('/relatorios') ? '-fill' : '' %> ph-chart-bar"></i><span><%= t('nav.relatorios') %></span></a>
        <button type="button" class="barra-inf__novo" id="barra-novo" aria-haspopup="menu" aria-expanded="false" aria-label="<%= t('nav.novo') %>"><i class="ph ph-plus"></i></button>
        <a href="/contas" class="<%= _rota.startsWith('/contas') ? 'is-active' : '' %>"><i class="ph<%= _rota.startsWith('/contas') ? '-fill' : '' %> ph-bank"></i><span><%= t('nav.contas_curto') %></span></a>
        <button type="button" id="barra-mais" class="<%= !_principal ? 'is-active' : '' %>" aria-haspopup="menu" aria-expanded="false"><i class="ph<%= !_principal ? '-fill' : '' %> ph-dots-three-outline"></i><span><%= t('nav.mais') %></span><% if (novidadesNovas > 0) { %><span class="barra-inf__ponto" aria-hidden="true"></span><% } %></button>
    </nav>
<% } %>

<script>
window.gfMoeda = {
    codigo: '<%= currency %>',
    decimais: <%= currency === 'PYG' ? 0 : 2 %>,
    temCentavos: <%= currency !== 'PYG' %>,
    simbolo: '<%= currency === "PYG" ? "Gs." : (currency === "BRL" ? "R$" : (currency === "USD" ? "$" : (currency === "EUR" ? "€" : "$"))) %>',
    milhar: '<%= currency === "USD" ? "," : "." %>',
    decimal: '<%= currency === "USD" ? "." : "," %>',
    separadorMilhar: '<%= currency === "USD" ? "," : "." %>',
    separadorDecimal: '<%= currency === "USD" ? "." : "," %>'
};

// Barra inferior (celular): "+" e "Mais" abrem uma folha; tocar fora ou em Esc fecha.
function fecharFolhas() {
    ['folha-novo', 'folha-mais', 'folha-fundo'].forEach((id) => { const el = document.getElementById(id); if (el) el.hidden = true; });
    ['barra-novo', 'barra-mais'].forEach((id) => { const el = document.getElementById(id); if (el) el.setAttribute('aria-expanded', 'false'); });
}
function alternarFolha(folhaId, botaoId) {
    const folha = document.getElementById(folhaId);
    if (!folha) return;
    const abrir = folha.hidden;
    fecharFolhas();
    if (abrir) {
        folha.hidden = false;
        document.getElementById('folha-fundo').hidden = false;
        document.getElementById(botaoId).setAttribute('aria-expanded', 'true');
    }
}
document.addEventListener('DOMContentLoaded', () => {
    // Faixa de icones do topo (celular): mostra o item ativo e indica com um degrade quando ha mais itens rolando.
    const faixa = document.querySelector('.navbar__links');
    if (faixa) {
        const ativo = faixa.querySelector('.is-active');
        if (ativo && faixa.scrollWidth > faixa.clientWidth) faixa.scrollLeft = Math.max(0, ativo.offsetLeft - (faixa.clientWidth - ativo.offsetWidth) / 2);
        const marcar = () => faixa.classList.toggle('tem-mais', faixa.scrollWidth - faixa.clientWidth - faixa.scrollLeft > 4);
        marcar(); faixa.addEventListener('scroll', marcar, { passive: true }); window.addEventListener('resize', marcar);
    }
    const bNovo = document.getElementById('barra-novo');
    const bMais = document.getElementById('barra-mais');
    if (bNovo) bNovo.addEventListener('click', () => alternarFolha('folha-novo', 'barra-novo'));
    if (bMais) bMais.addEventListener('click', () => alternarFolha('folha-mais', 'barra-mais'));
    const fundo = document.getElementById('folha-fundo');
    if (fundo) fundo.addEventListener('click', fecharFolhas);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fecharFolhas(); });
    // Novo lancamento: abre o formulario desta pagina; nas paginas sem formulario, vai para o painel com ele aberto.
    document.querySelectorAll('[data-novo]').forEach((btn) => btn.addEventListener('click', () => {
        const tipo = btn.getAttribute('data-novo');
        const modal = document.getElementById('modal-novo-' + tipo);
        fecharFolhas();
        if (modal) modal.classList.add('is-open'); else window.location.href = '/?action=' + tipo;
    }));
});
</script>
