<!doctype html>
<html lang="<%= lang %>" data-tema="<%= theme %>">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0b0d12">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" type="image/png" href="/assets/icons/icon-192.png">
    <link rel="apple-touch-icon" href="/assets/icons/icon-192.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="MyFinance">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title ? title + ' - ' + t('app.nome') : t('app.nome') %></title>
    <script>
    window.GF_T = {
        total: <%- JSON.stringify(t('comum.total')) %>,
        receitas: <%- JSON.stringify(t('comum.receitas')) %>,
        despesas: <%- JSON.stringify(t('comum.despesas')) %>,
        saldo: <%- JSON.stringify(t('comum.saldo')) %>,
        sem_categoria: <%- JSON.stringify(t('comum.sem_categoria')) %>,
        sel_cat_primeiro: <%- JSON.stringify(t('modal.sel_cat_primeiro')) %>,
        sem_subcategoria: <%- JSON.stringify(t('js.sem_subcategoria')) %>,
        categoria_sem_sub: <%- JSON.stringify(t('js.categoria_sem_sub')) %>,
        dica_sub_html: <%- JSON.stringify(t('js.dica_sub_html')) %>,
        foi_recebida: <%- JSON.stringify(t('modal.foi_recebida')) %>,
        foi_pago: <%- JSON.stringify(t('modal.foi_pago')) %>,
        nao_foi_recebida: <%- JSON.stringify(t('modal.nao_foi_recebida')) %>,
        nao_foi_pago: <%- JSON.stringify(t('modal.nao_foi_pago')) %>,
        data_recebimento: <%- JSON.stringify(t('modal.data_recebimento')) %>,
        data_pagamento: <%- JSON.stringify(t('modal.data_pagamento')) %>,
        data_vencimento: <%- JSON.stringify(t('modal.data_vencimento')) %>,
        adicionar_saldo: <%- JSON.stringify(t('contas.adicionar_saldo')) %>,
        subtrair_saldo: <%- JSON.stringify(t('contas.subtrair_saldo')) %>,
        com_seguir: <%- JSON.stringify(t('comunidade.js.seguir')) %>,
        com_deixar: <%- JSON.stringify(t('comunidade.js.deixar')) %>,
        com_max_imgs: <%- JSON.stringify(t('comunidade.js.max_imgs')) %>,
        com_conf_coment: <%- JSON.stringify(t('comunidade.js.conf_coment')) %>,
        com_conf_post: <%- JSON.stringify(t('comunidade.js.conf_post')) %>,
        com_conf_admin: <%- JSON.stringify(t('comunidade.js.conf_admin')) %>,
        cat_nova: <%- JSON.stringify(t('cat_rapida.nova_categoria')) %>,
        sub_nova: <%- JSON.stringify(t('cat_rapida.nova_subcategoria')) %>,
        cat_nome_ph: <%- JSON.stringify(t('cat_rapida.nome_ph')) %>,
        cat_salvar: <%- JSON.stringify(t('cat_rapida.salvar')) %>,
        cat_cancelar: <%- JSON.stringify(t('cat_rapida.cancelar')) %>,
        cat_escolha: <%- JSON.stringify(t('cat_rapida.escolha_categoria')) %>,
        cat_cor: <%- JSON.stringify(t('cat_rapida.cor')) %>,
        cat_erro: <%- JSON.stringify(t('cat_rapida.erro')) %>,
        erro_acao: <%- JSON.stringify(t('js.erro_acao')) %>
    };
    </script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link rel="stylesheet" href="/assets/css/app.css?v=<%= Date.now() %>">
</head>
<body>
<header class="navbar">
    <div class="navbar__inner">
        <!-- Top Left: Menu Toggle (Mobile Only) + Brand Logo -->
        <div style="display: flex; align-items: center; gap: 10px;">
            <a href="/" class="navbar__brand" style="display: flex; align-items: center; gap: 6px;">
                <i class="ph-fill ph-hands-clapping" style="font-size: 22px;"></i>
                <span style="font-size: 11px; text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em;">MyFinance</span>
            </a>
        </div>

        <% if (usuarioLogado) { %>
            <nav class="navbar__links">
                <a href="/" title="<%= t('nav.visao_geral') %>" class="navbar__link <%= currentRoute === '/' ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-squares-four"></i></span>
                    <span class="navbar__label"><%= t('nav.visao_geral') %></span>
                </a>
                <a href="/relatorios" title="<%= t('nav.relatorios') %>" class="navbar__link <%= currentRoute === '/relatorios' ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-chart-bar"></i></span>
                    <span class="navbar__label"><%= t('nav.relatorios') %></span>
                </a>
                <a href="/categorias" title="<%= t('nav.categorias') %>" class="navbar__link <%= currentRoute === '/categorias' ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-tag"></i></span>
                    <span class="navbar__label"><%= t('nav.categorias') %></span>
                </a>
                <a href="/contas" title="<%= t('nav.contas') %>" class="navbar__link <%= currentRoute === '/contas' ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-bank"></i></span>
                    <span class="navbar__label"><%= t('nav.contas') %></span>
                </a>
                <% if (typeof ehAdmin !== 'undefined' && ehAdmin) { %>
                <a href="/admin" title="<%= t('nav.admin') %>" class="navbar__link <%= currentRoute.startsWith('/admin') ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-shield-star"></i></span>
                    <span class="navbar__label"><%= t('nav.admin') %></span>
                </a>
                <% } %>
                <% if (ehAdmin || (usuarioLogado && usuarioLogado.ia_habilitada)) { %>
                <a href="/ia" title="<%= t('nav.ia') %>" class="navbar__link <%= currentRoute.startsWith('/ia') ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-sparkle"></i></span>
                    <span class="navbar__label"><%= t('nav.ia') %></span>
                </a>
                <% } %>
                <a href="/comunidade" title="<%= t('nav.comunidad') %>" class="navbar__link <%= currentRoute.startsWith('/comunidade') ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-users-three"></i></span>
                    <span class="navbar__label"><%= t('nav.comunidad') %></span>
                </a>
                <a href="/configuracoes" title="<%= t('nav.configuracoes') %>" class="navbar__link <%= currentRoute.startsWith('/configuracoes') ? 'is-active' : '' %>">
                    <span class="navbar__icon"><i class="ph ph-gear"></i></span>
                    <span class="navbar__label"><%= t('nav.configuracoes') %></span>
                </a>
            </nav>
            <div class="navbar__user">
                <span class="navbar__user-nome" style="font-weight: 600;"><%= usuarioLogado.nome %></span>
                <button type="button" class="navbar__avatar" id="btn-toggle-menu" aria-label="<%= t('nav.menu') %>"><%= usuarioLogado.nome ? usuarioLogado.nome.charAt(0).toUpperCase() : 'U' %></button>
            </div>
        <% } %>
    </div>
</header>

<main class="container">
    <% if (flash) { %>
        <%
            let msgText = flash.mensagem || '';
            if (msgText.startsWith('flash.')) {
                const resText = t(msgText);
                msgText = resText.startsWith('flash.') ? (flash.tipo === 'sucesso' ? t('flash.generico_ok') : t('flash.generico_erro')) : resText;
            }
        %>
        <div class="alert alert-<%= flash.tipo === 'sucesso' ? 'sucesso' : 'erro' %>" style="display: flex; align-items: center; gap: 8px;">
            <i class="ph-bold <%= flash.tipo === 'sucesso' ? 'ph-check-circle' : 'ph-warning-circle' %>" style="font-size: 18px;"></i>
            <span><%= msgText %></span>
        </div>
    <% } %>

    <% if (typeof assinatura !== 'undefined' && assinatura && usuarioLogado) { %>
        <% const _st = assinatura.status_efetivo; %>
        <% if (_st === 'vencida' || _st === 'cancelada') { %>
            <div class="alert alert-erro faixa-conta"><i class="ph ph-lock-simple"></i> <span><%= t('faixa.somente_leitura') %></span> <a href="/assinatura" class="btn btn-sm btn-primary"><%= t('faixa.ver_planos') %></a></div>
        <% } else if (_st === 'trial') { %>
            <div class="alert alert-aviso faixa-conta"><i class="ph ph-gift"></i> <span><%= t('faixa.trial', { dias: assinatura.dias_restantes }) %></span> <a href="/assinatura" class="btn btn-sm btn-outline"><%= t('faixa.ver_planos') %></a></div>
        <% } else if (_st === 'ativa' && assinatura.dias_restantes <= 5) { %>
            <div class="alert alert-aviso faixa-conta"><i class="ph ph-clock-countdown"></i> <span><%= t('faixa.renovar', { dias: assinatura.dias_restantes }) %></span> <a href="/assinatura" class="btn btn-sm btn-outline"><%= t('faixa.renovar_botao') %></a></div>
        <% } %>
        <% if (emailNaoVerificado) { %>
            <div class="alert alert-aviso faixa-conta"><i class="ph ph-envelope-simple"></i> <span><%= t('faixa.verificar_email') %></span>
                <form method="post" action="/verificar-email/reenviar" style="display: inline;"><%- csrfCampo %><button type="submit" class="btn btn-sm btn-outline"><%= t('conta.reenviar') %></button></form></div>
        <% } %>
    <% } %>

    <%- include('partials/saldos_contas') %>

    <%- body %>
</main>

<% if (usuarioLogado) { %>

    <!-- Mobile Drawer Overlay & Menu Panel -->
    <div class="drawer-backdrop" id="mobile-drawer-backdrop" style="display: none;" onclick="fecharMenuMobile()">
        <div class="drawer-panel" onclick="event.stopPropagation()">
            <div class="drawer-header">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <i class="ph-fill ph-hands-clapping" style="font-size: 24px; color: var(--green);"></i>
                    <strong style="font-size: 16px;">MyFinance</strong>
                </div>
                <button type="button" class="drawer-close-btn" onclick="fecharMenuMobile()">&times;</button>
            </div>
            
            <div class="drawer-user-info">
                <div class="drawer-user-avatar"><%= usuarioLogado.nome ? usuarioLogado.nome.charAt(0).toUpperCase() : 'U' %></div>
                <div style="min-width: 0; flex: 1;">
                    <div style="font-weight: 700; font-size: 14px; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= usuarioLogado.nome %></div>
                    <div style="font-size: 11px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= usuarioLogado.email || '' %></div>
                </div>
            </div>

            <nav class="drawer-links">
                <a href="/" class="drawer-link <%= currentRoute === '/' ? 'is-active' : '' %>">
                    <i class="ph ph-squares-four"></i>
                    <span><%= t('nav.visao_geral') %></span>
                </a>
                <a href="/relatorios" class="drawer-link <%= currentRoute === '/relatorios' ? 'is-active' : '' %>">
                    <i class="ph ph-chart-bar"></i>
                    <span><%= t('nav.relatorios') %></span>
                </a>
                <a href="/categorias" class="drawer-link <%= currentRoute === '/categorias' ? 'is-active' : '' %>">
                    <i class="ph ph-tag"></i>
                    <span><%= t('nav.categorias') %></span>
                </a>
                <a href="/contas" class="drawer-link <%= currentRoute === '/contas' ? 'is-active' : '' %>">
                    <i class="ph ph-bank"></i>
                    <span><%= t('nav.contas') %></span>
                </a>
                <% if (typeof ehAdmin !== 'undefined' && ehAdmin) { %>
                <a href="/admin" class="drawer-link <%= currentRoute.startsWith('/admin') ? 'is-active' : '' %>">
                    <i class="ph ph-shield-star"></i>
                    <span><%= t('nav.admin') %></span>
                </a>
                <% } %>
                <% if (ehAdmin || (usuarioLogado && usuarioLogado.ia_habilitada)) { %>
                <a href="/ia" class="drawer-link <%= currentRoute.startsWith('/ia') ? 'is-active' : '' %>">
                    <i class="ph ph-sparkle"></i>
                    <span><%= t('nav.ia') %></span>
                </a>
                <% } %>
                <a href="/comunidade" class="drawer-link <%= currentRoute.startsWith('/comunidade') ? 'is-active' : '' %>">
                    <i class="ph ph-users-three"></i>
                    <span><%= t('nav.comunidad') %></span>
                </a>
                <a href="/assinatura" class="drawer-link <%= currentRoute === '/assinatura' ? 'is-active' : '' %>">
                    <i class="ph ph-crown-simple"></i>
                    <span><%= t('config.menu.assinatura') %></span>
                </a>
                <a href="/configuracoes" class="drawer-link <%= currentRoute.startsWith('/configuracoes') ? 'is-active' : '' %>">
                    <i class="ph ph-gear"></i>
                    <span><%= t('nav.configuracoes') %></span>
                </a>
            </nav>

            <div class="drawer-footer">
                <form method="post" action="/logout" style="width: 100%;">
                    <%- csrfCampo %>
                    <button type="submit" class="btn btn-outline btn-block" style="color: var(--red); border-color: var(--red-bg); justify-content: flex-start; gap: 8px;">
                        <i class="ph ph-sign-out" style="font-size: 18px;"></i>
                        <span><%= t('nav.sair') %></span>
                    </button>
                </form>
            </div>
        </div>
    </div>
<% } %>

<script>
window.gfMoeda = {
    codigo: '<%= currency %>',
    decimais: <%= currency === 'PYG' ? 0 : 2 %>,
    temCentavos: <%= currency !== 'PYG' %>,
    simbolo: '<%= currency === "PYG" ? "Gs." : (currency === "BRL" ? "R$" : (currency === "USD" ? "$" : (currency === "EUR" ? "€" : "$"))) %>',
    milhar: '<%= currency === "USD" ? "," : "." %>',
    decimal: '<%= currency === "USD" ? "." : "," %>',
    separadorMilhar: '<%= currency === "USD" ? "," : "." %>',
    separadorDecimal: '<%= currency === "USD" ? "." : "," %>'
};

function abrirMenuMobile() {
    
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    if (backdrop) {
        backdrop.style.display = 'block';
        setTimeout(() => backdrop.classList.add('is-open'), 10);
    }
}
function fecharMenuMobile() {
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    if (backdrop) {
        backdrop.classList.remove('is-open');
        setTimeout(() => { backdrop.style.display = 'none'; }, 200);
    }
}
document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('btn-toggle-menu');
    if (toggleBtn) {
        toggleBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            abrirMenuMobile();
        });
    }
});
</script>
<script src="/assets/js/app.js"></script>
</body>
</html>
