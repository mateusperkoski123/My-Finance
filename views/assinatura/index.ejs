<%
const ass = assinatura;
const st = ass ? ass.status_efetivo : null;
const ciclos = { mensal: t('assinatura.ciclo_mensal'), anual: t('assinatura.ciclo_anual') };
const nomePlano = (c) => t('plano.' + c + '.nome');
%>
<%
const moedaPg = (m) => ({ PYG: 'Gs.', USD: 'US$', BRL: 'R$' }[m] || m);
const abaInicial = (st === 'ativa' || (pagamentos && pagamentos.length > 0)) ? 'assinatura' : 'planos';
%>
<%# Sem teste em andamento e sem plano contratado (acessoBloqueado), esta e a unica tela do sistema: sem o menu de Configuracoes. %>
<% if (!acessoBloqueado) { %>
<div class="page-header settings-titulo-mobile">
    <h1><i class="ph ph-gear"></i> <%= t('config.titulo') %></h1>
</div>
<div class="settings-layout">
<%- include('../configuracoes/_menu', { menuAtivo: 'assinatura' }) %>
<div class="settings-content">
<% } %>
<% if (st === 'teste_encerrado' && !ehAdmin) { %>
<section class="card teste-fim" role="status">
    <span class="teste-fim__icone"><i class="ph ph-hourglass-high" aria-hidden="true"></i></span>
    <div>
        <h1><%= t('assinatura.teste_fim_titulo') %></h1>
        <p><%= t('assinatura.teste_fim_texto', { app: negocio.NOME_APP }) %></p>
    </div>
</section>
<% } %>
<div class="page-header" style="margin-top: 4px;">
    <h2 style="margin: 0;"><i class="ph ph-crown-simple"></i> <%= t('assinatura.titulo') %></h2>
    <p class="muted"><%= t('assinatura.subtitulo') %></p>
</div>
<div class="assin-abas" role="tablist">
    <button type="button" role="tab" data-tab="assinatura" class="<%= abaInicial === 'assinatura' ? 'is-ativo' : '' %>"><%= t('assinatura.tab_assinatura') %></button>
    <button type="button" role="tab" data-tab="planos" class="<%= abaInicial === 'planos' ? 'is-ativo' : '' %>"><%= t('assinatura.tab_planos') %></button>
</div>

<div data-painel="assinatura" <%= abaInicial === 'assinatura' ? '' : 'hidden' %>>
<% if (ass) { %>
<section class="card assinatura-atual">
    <div style="display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; align-items: flex-start;">
        <div>
            <span class="muted" style="font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em;"><%= t('assinatura.seu_plano') %></span>
            <h2 style="margin: 4px 0 6px;"><%= st === 'escolher' ? t('assinatura.sem_plano') : nomePlano(ass.plano_codigo) %></h2>
            <p class="muted" style="margin: 0;">
                <% if (st === 'beta') { %>
                    <%= t('assinatura.estado_beta') %>
                <% } else if (st === 'trial') { %>
                    <%= t(ass.teste_plano ? 'assinatura.estado_trial_plano' : 'assinatura.estado_trial', { dias: ass.dias_restantes }) %>
                <% } else if (st === 'escolher') { %>
                    <%= t('assinatura.estado_escolher') %>
                <% } else if (st === 'teste_encerrado') { %>
                    <%= t('assinatura.estado_teste_encerrado') %>
                <% } else if (st === 'ativa') { %>
                    <%= t('assinatura.estado_ativa', { ciclo: ciclos[ass.ciclo] || '', data: formatDate(ass.periodo_fim, 'DD/MM/YYYY'), dias: ass.dias_restantes }) %>
                <% } else if (st === 'cancelada') { %>
                    <%= t('assinatura.estado_cancelada') %>
                <% } else { %>
                    <%= t('assinatura.estado_vencida') %>
                <% } %>
            </p>
        </div>
        <span class="badge <%= (st === 'beta' || st === 'trial' || st === 'ativa') ? 'badge-sucesso' : 'badge-pendente' %>"><%= t('assinatura.status.' + st) %></span>
    </div>

    <% if (ass.solicitado_codigo) { %>
        <div class="alert alert-aviso" style="margin-top: 14px;">
            <i class="ph ph-hourglass"></i>
            <%= t('assinatura.pedido_pendente', { plano: nomePlano(ass.solicitado_codigo), ciclo: ciclos[ass.ciclo_solicitado] || '' }) %>
        </div>
    <% } %>
    <% if (st === 'vencida' || st === 'cancelada') { %>
        <div class="alert alert-erro" style="margin-top: 14px;"><i class="ph ph-lock-simple"></i> <%= t('assinatura.modo_leitura') %></div>
    <% } %>
    <% if (st === 'escolher') { %>
        <div style="margin-top: 14px;">
            <a href="/teste" class="btn btn-primary"><i class="ph ph-gift"></i> <%= t('assinatura.escolher_botao') %></a>
            <p class="muted" style="font-size: 13px; margin: 8px 0 0;"><%= t('assinatura.prueba_sub', { dias: negocio.TRIAL_DIAS }) %></p>
        </div>
    <% } %>
    <% if (st === 'ativa') { const ultimo = (pagamentos || []).find(pg => pg.status === 'pago'); %>
    <dl class="assin-dados">
        <div><dt><%= t('assinatura.plano') %></dt><dd><%= nomePlano(ass.plano_codigo) %></dd></div>
        <% if (ultimo) { %><div><dt><%= t('assinatura.valor_plano') %></dt><dd><%= moedaPg(ultimo.moeda) %> <%= fmt(ultimo.valor) %></dd></div><% } %>
        <div><dt><%= t('assinatura.recorrencia') %></dt><dd><%= ciclos[ass.ciclo] || '-' %></dd></div>
        <div><dt><%= t('assinatura.assinatura_inicio') %></dt><dd><%= formatDate(ass.periodo_inicio, 'DD/MM/YYYY') %></dd></div>
        <div><dt><%= t('assinatura.fim_ciclo') %></dt><dd><%= formatDate(ass.periodo_fim, 'DD/MM/YYYY') %></dd></div>
        <div><dt><%= t('assinatura.status_titulo') %></dt><dd><%= t('assinatura.status.' + st) %></dd></div>
    </dl>
    <% } %>
</section>
<% } %>

<section class="card" style="margin-top: 20px;" id="recibos">
    <div class="recibos__topo">
        <div>
            <h2 style="margin: 0;"><i class="ph ph-receipt" aria-hidden="true"></i> <%= t('assinatura.recibos_titulo') %></h2>
            <p class="muted" style="margin: 4px 0 0;"><%= t('assinatura.recibos_sub') %></p>
        </div>
        <% if (pagamentos && pagamentos.length > 0) { %><span class="badge badge-neutro"><%= t('assinatura.recibos_qtd', { n: pagamentos.length }) %></span><% } %>
    </div>
    <% if (!pagamentos || pagamentos.length === 0) { %>
        <p class="muted" style="margin: 14px 0 0;"><%= t('assinatura.recibos_vazio') %></p>
    <% } else { %>
    <div class="recibos">
        <% pagamentos.forEach(pg => {
            const quando = pg.pago_em || pg.created_at;
            const numero = new Date(quando).getFullYear() + '-' + String(pg.id).padStart(6, '0');
            const stPg = { pago: 'assinatura.pg_pago', pendente: 'assinatura.pg_pendente', estornado: 'assinatura.pg_estornado' }[pg.status] || 'assinatura.pg_pago';
        %>
        <article class="recibo">
            <div class="recibo__linha">
                <div>
                    <div class="recibo__num"><i class="ph ph-receipt" aria-hidden="true"></i> <%= t('assinatura.recibo_n', { n: numero }) %></div>
                    <div class="muted recibo__sub"><%= pg.plano_codigo ? nomePlano(pg.plano_codigo) : '-' %> · <%= ciclos[pg.ciclo] || '-' %></div>
                </div>
                <span class="badge <%= pg.status === 'pago' ? 'badge-sucesso' : 'badge-pendente' %>"><%= t(stPg) %></span>
            </div>
            <div class="recibo__dados">
                <div><span><%= t('assinatura.pago_em') %></span><b><%= formatDate(quando, 'DD/MM/YYYY') %></b></div>
                <div><span><%= t('assinatura.valor_pago') %></span><b><%= moedaPg(pg.moeda) %> <%= fmt(pg.valor) %></b></div>
                <div><span><%= t('assinatura.metodo') %></span><b><%= pg.metodo %></b></div>
            </div>
            <div class="recibo__acoes">
                <a class="btn btn-outline" href="/assinatura/recibo/<%= pg.id %>" target="_blank" rel="noopener"><i class="ph ph-eye" aria-hidden="true"></i> <%= t('assinatura.recibo_ver') %></a>
                <a class="btn btn-outline" href="/assinatura/recibo/<%= pg.id %>?imprimir=1" target="_blank" rel="noopener"><i class="ph ph-download-simple" aria-hidden="true"></i> <%= t('assinatura.recibo_pdf') %></a>
            </div>
        </article>
        <% }) %>
    </div>
    <% } %>
</section>

<%
const ind = indicacao || {};
%>
<% if (!acessoBloqueado) { %>
<section class="card" style="margin-top: 20px;" id="indicacao">
    <h2><i class="ph ph-gift" aria-hidden="true"></i> <%= t('indicacao.titulo') %></h2>
    <% if (!ind.pode) { %>
        <p class="muted"><%= t('indicacao.bloqueado') %></p>
    <% } else { %>
        <p class="muted"><%= t('indicacao.texto', { pct: ind.percentual }) %></p>
        <% if (ind.codigo) { %>
            <div style="display: flex; gap: 28px; flex-wrap: wrap; margin-top: 8px;">
                <div><span class="muted" style="font-size: 13px;"><%= t('indicacao.seu_codigo') %></span><div style="font-size: 24px; font-weight: 700; letter-spacing: .06em;"><%= ind.codigo %></div></div>
                <div><span class="muted" style="font-size: 13px;"><%= t('indicacao.usos') %></span><div style="font-size: 24px; font-weight: 700;"><%= ind.usos %></div></div>
                <div><span class="muted" style="font-size: 13px;"><%= t('indicacao.credito') %></span><div style="font-size: 24px; font-weight: 700;">Gs. <%= fmt(ind.saldo) %></div><small class="muted"><%= t('indicacao.credito_dica') %></small></div>
            </div>
        <% } else { %>
            <form method="post" action="/assinatura/indicacao" class="lanc-form" style="max-width: 420px;">
                <%- csrfCampo %>
                <label class="lanc-campo">
                    <span><%= t('indicacao.criar_label') %></span>
                    <input class="input" type="text" name="codigo" required minlength="4" maxlength="20" pattern="[A-Za-z0-9]{4,20}" autocomplete="off" style="text-transform: uppercase;" placeholder="MEUCODIGO">
                    <small class="muted"><%= t('indicacao.criar_dica') %></small>
                </label>
                <button type="submit" class="btn btn-primary"><%= t('indicacao.criar_botao') %></button>
            </form>
        <% } %>
    <% } %>
</section>
<% } %>
</div>

<div data-painel="planos" <%= abaInicial === 'planos' ? '' : 'hidden' %>>
<%
const comprar = planos.filter(p => p.codigo !== 'prueba');
const selecionado = comprar.some(p => p.codigo === 'premium') ? 'premium' : (comprar[0] ? comprar[0].codigo : '');
%>
<section class="planos">
    <div class="planos__topo">
        <h2><%= t('assinatura.escolha') %></h2>
        <div class="planos__ciclo" role="group" aria-label="<%= t('assinatura.ciclo') %>">
            <button type="button" class="is-ativo" data-ciclo="mensal"><%= t('assinatura.ciclo_mensal') %></button>
            <button type="button" data-ciclo="anual"><%= t('assinatura.ciclo_anual') %> <small><%= t('assinatura.dois_gratis') %></small></button>
        </div>
    </div>
    <div class="planos__abas" role="group">
        <% comprar.forEach(p => { %>
            <button type="button" data-aba="<%= p.codigo %>" class="<%= p.codigo === selecionado ? 'is-ativo' : '' %>"><%= t('plano.' + p.codigo + '.curto') %></button>
        <% }) %>
    </div>

<div class="planos-grid">
    <% comprar.forEach(p => {
        const atual = ass && ass.plano_codigo === p.codigo && (st === 'beta' || st === 'trial' || st === 'ativa');
        const economia = p.preco_mensal * 12 - p.preco_anual;
        const txtMensal = fmt(p.preco_mensal);
        const txtAnual = fmt(Math.round(p.preco_anual / 12));
        const linhaMensal = t('assinatura.cobrado_mes');
        const linhaAnual = t('assinatura.cobrado_ano', { valor: fmt(p.preco_anual), economia: fmt(economia) });
    %>
        <article class="card plano-card <%= atual ? 'plano-card--atual' : '' %> <%= p.codigo === 'premium' ? 'plano-card--destaque' : '' %> <%= p.codigo === 'pro' ? 'plano-card--pro' : '' %> <%= p.codigo === selecionado ? 'is-sel' : '' %>" data-plano="<%= p.codigo %>">
            <% if (p.codigo === 'premium') { %><span class="plano-card__faixa plano-card__faixa--vendido"><i class="ph-bold ph-star" aria-hidden="true"></i> <%= t('assinatura.mais_vendido') %></span><% } else if (p.codigo === 'pro') { %><span class="plano-card__faixa plano-card__faixa--ouro"><i class="ph-bold ph-crown-simple" aria-hidden="true"></i> <%= t('assinatura.mais_completo') %></span><% } %>
            <% if (atual) { %><span class="plano-card__selo plano-card__selo--atual"><%= t(st === 'trial' ? 'assinatura.em_teste' : 'assinatura.plano_atual') %></span><% } %>
            <h3><%= nomePlano(p.codigo) %></h3>
            <div class="muted plano-card__sub"><%= t('plano.' + p.codigo + '.sub') %></div>
            <div class="plano-card__preco"><span class="plano-card__moeda">Gs.</span> <span data-preco data-mensal="<%= txtMensal %>" data-anual="<%= txtAnual %>"><%= txtMensal %></span><small>/<%= t('assinatura.mes') %></small></div>
            <div class="muted plano-card__sub plano-card__cobranca" data-cobranca data-mensal="<%= linhaMensal %>" data-anual="<%= linhaAnual %>"><%= linhaMensal %></div>

            <div class="muted plano-card__iva"><%= t('assinatura.sem_iva') %></div>

            <div class="plano-card__acoes">
                <%# Durante o teste do plano escolhido da para passar a testar outro plano (o prazo nao reinicia); "Adquirir" fica logo abaixo. %>
                <% if (ass && st === 'trial' && ass.plano_codigo !== p.codigo) { %>
                    <form method="post" action="/teste/trocar" class="plano-card__testar">
                        <%- csrfCampo %>
                        <input type="hidden" name="plano" value="<%= p.codigo %>">
                        <button type="submit" class="btn btn-outline" title="<%= t('assinatura.testar_plano_dica', { dias: ass.dias_restantes }) %>"><i class="ph ph-flask" aria-hidden="true"></i> <%= t('assinatura.testar_plano') %></button>
                    </form>
                <% } %>
                <button type="button" data-solicitar data-plano="<%= p.codigo %>" data-nome="<%= nomePlano(p.codigo) %>"
                        data-resumo-mensal="Gs. <%= txtMensal %> / <%= t('assinatura.mes') %>"
                        data-resumo-anual="Gs. <%= fmt(p.preco_anual) %> / <%= t('assinatura.ano') %> (Gs. <%= txtAnual %> / <%= t('assinatura.mes') %>)"
                        class="btn btn-adquirir"><i class="ph-bold ph-shopping-cart-simple" aria-hidden="true"></i>
                    <span data-valor data-mensal="<%= t('assinatura.adquirir', { valor: 'Gs. ' + txtMensal + ' / ' + t('assinatura.mes') }) %>" data-anual="<%= t('assinatura.adquirir', { valor: 'Gs. ' + fmt(p.preco_anual) + ' / ' + t('assinatura.ano') }) %>"><%= t('assinatura.adquirir', { valor: 'Gs. ' + txtMensal + ' / ' + t('assinatura.mes') }) %></span></button>
            </div>

            <%- include('_recursos', { p: p }) %>
        </article>
    <% }) %>
</div>
</section>

<script>
(function () {
    var secao = document.querySelector('.planos');
    if (!secao) return;
    secao.querySelectorAll('[data-ciclo]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var c = btn.getAttribute('data-ciclo');
            secao.querySelectorAll('[data-ciclo]').forEach(function (b) { b.classList.toggle('is-ativo', b === btn); });
            secao.querySelectorAll('[data-preco],[data-cobranca],[data-valor]').forEach(function (el) { el.textContent = el.getAttribute('data-' + c); });
            ciclo = c;
        });
    });

    // "Quero este plano": abre a janela de confirmacao (plano, ciclo, preco sem IVA e telefone de contato).
    var ciclo = 'mensal';
    secao.querySelectorAll('[data-solicitar]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var modal = document.getElementById('modal-pedido-plano');
            modal.querySelector('[name="plano"]').value = btn.getAttribute('data-plano');
            modal.querySelector('[name="ciclo"]').value = ciclo;
            modal.querySelector('[data-pedido-nome]').textContent = btn.getAttribute('data-nome');
            modal.querySelector('[data-pedido-ciclo]').textContent = secao.querySelector('[data-ciclo="' + ciclo + '"]').firstChild.textContent.trim();
            modal.querySelector('[data-pedido-preco]').textContent = btn.getAttribute('data-resumo-' + ciclo);
            modal.classList.add('is-open');
            limparDesconto();
            var campo = modal.querySelector('[name="telefone_numero"]');
            if (campo) setTimeout(function () { campo.focus(); }, 50);
            // Codigo ja digitado (outro plano ou outro ciclo): confere de novo para o resumo bater com este plano.
            var cod = document.getElementById('pedido-codigo');
            if (cod && cod.value.trim()) aplicarCodigo();
        });
    });

    // Codigo de desconto: confere no servidor e mostra o desconto e o total antes de pagar.
    // (A janela do pedido vem depois deste script: os campos sao buscados na hora do uso.)
    function limparDesconto() { var c = document.getElementById('pedido-desconto'); if (c) { c.hidden = true; c.textContent = ''; } }
    function aplicarCodigo() {
        var campoCodigo = document.getElementById('pedido-codigo');
        var botaoAplicar = document.getElementById('pedido-aplicar');
        var caixaDesconto = document.getElementById('pedido-desconto');
        if (!campoCodigo || !campoCodigo.value.trim()) { limparDesconto(); return; }
        var form = campoCodigo.form;
        var rotulo = botaoAplicar.textContent;
        botaoAplicar.disabled = true;
        botaoAplicar.textContent = botaoAplicar.getAttribute('data-conferindo');
        var dados = new URLSearchParams({ _csrf: form.querySelector('[name="_csrf"]').value, codigo: campoCodigo.value, plano: form.querySelector('[name="plano"]').value, ciclo: form.querySelector('[name="ciclo"]').value });
        fetch('/assinatura/indicacao/conferir', { method: 'POST', body: dados, credentials: 'same-origin', headers: { 'X-Requested-With': 'fetch' } })
            .then(function (r) { if (!r.ok) throw new Error('http ' + r.status); return r.json(); })
            .then(function (j) {
                caixaDesconto.className = 'pedido-desconto ' + (j.ok ? 'pedido-desconto--ok' : 'pedido-desconto--erro');
                caixaDesconto.textContent = '';
                (j.ok ? j.linhas.concat([j.total]) : [j.mensagem]).forEach(function (texto, i, todas) {
                    var linha = document.createElement(j.ok && i === todas.length - 1 ? 'strong' : 'div');
                    linha.textContent = texto;
                    caixaDesconto.appendChild(linha);
                });
                caixaDesconto.hidden = false;
                caixaDesconto.scrollIntoView({ block: 'nearest' });
            })
            .catch(function () { caixaDesconto.className = 'pedido-desconto pedido-desconto--erro'; caixaDesconto.textContent = (window.GF_T || {}).erro_acao || ''; caixaDesconto.hidden = false; })
            .then(function () { botaoAplicar.disabled = false; botaoAplicar.textContent = rotulo; });
    }
    document.addEventListener('DOMContentLoaded', function () {
        var campoCodigo = document.getElementById('pedido-codigo');
        var botaoAplicar = document.getElementById('pedido-aplicar');
        if (!campoCodigo || !botaoAplicar) return;
        botaoAplicar.addEventListener('click', aplicarCodigo);
        // Enter no campo confere o codigo em vez de enviar o pedido; mudar o codigo apaga o resumo antigo.
        campoCodigo.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); aplicarCodigo(); } });
        campoCodigo.addEventListener('input', limparDesconto);
    });
    // Vindo da tela de teste ("Adquirir por ..."): abre direto o pedido do plano escolhido.
    var comprar = new URLSearchParams(location.search).get('comprar');
    if (comprar) {
        // O modal do pedido vem depois deste script na pagina: espera o fim do carregamento.
        document.addEventListener('DOMContentLoaded', function () {
            var cod = comprar.replace(/[^a-z]/g, '');
            var alvo = secao.querySelector('[data-solicitar][data-plano="' + cod + '"]');
            if (!alvo) return;
            secao.querySelectorAll('[data-aba]').forEach(function (b) { b.classList.toggle('is-ativo', b.getAttribute('data-aba') === cod); });
            secao.querySelectorAll('.plano-card').forEach(function (c) { c.classList.toggle('is-sel', c.getAttribute('data-plano') === cod); });
            alvo.click();
        });
    }
    secao.querySelectorAll('[data-aba]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var cod = btn.getAttribute('data-aba');
            secao.querySelectorAll('[data-aba]').forEach(function (b) { b.classList.toggle('is-ativo', b === btn); });
            secao.querySelectorAll('.plano-card').forEach(function (c) { c.classList.toggle('is-sel', c.getAttribute('data-plano') === cod); });
        });
    });
})();
</script>

<p class="muted" style="font-size: 13px; margin-top: 4px;"><i class="ph ph-info"></i> <%= negocio.EMAIL_SUPORTE ? t('assinatura.como_pagar') : t('assinatura.como_pagar').replace(/\s*[^.]*:\s*$/, '') %><% if (negocio.EMAIL_SUPORTE) { %> <b><%= negocio.EMAIL_SUPORTE %></b><% } %></p>
<% if (acessoBloqueado) { %>
    <%# Unico caminho para a tela da conta enquanto o resto do sistema esta fechado (a pessoa pode excluir a conta e os dados). %>
    <p class="muted" style="font-size: 13px;"><a href="/configuracoes/conta"><i class="ph ph-identification-card"></i> <%= t('config.menu.conta') %>: <%= t('conta.excluir_titulo') %></a></p>
<% } %>
</div>

<div class="modal-backdrop modal-backdrop--lanc" id="modal-pedido-plano" data-modal>
    <div class="modal card modal--lanc">
        <div class="modal__header">
            <div class="modal__titulo">
                <span class="modal__icone"><i class="ph ph-crown-simple"></i></span>
                <h2><%= t('assinatura.pedido_titulo') %></h2>
            </div>
            <button type="button" class="modal__fechar" data-modal-close aria-label="<%= t('comum.fechar') %>"><i class="ph ph-x"></i></button>
        </div>
        <form method="post" action="/assinatura/solicitar" class="lanc-form">
            <%- csrfCampo %>
            <input type="hidden" name="plano" value="">
            <input type="hidden" name="ciclo" value="mensal">
            <div class="pedido-resumo">
                <div><strong data-pedido-nome></strong> · <span data-pedido-ciclo></span></div>
                <div class="pedido-resumo__preco" data-pedido-preco></div>
                <div class="muted" style="font-size: 13px;"><i class="ph ph-info"></i> <%= t('assinatura.sem_iva_aviso') %></div>
            </div>
            <% if (pagoOnline) { %>
            <%# Codigo de desconto logo abaixo do preco (no fim da janela ficava fora da tela no celular). "Aplicar" confere no
                servidor, sem criar pedido, e mostra desconto, credito e total antes de pagar. %>
            <div class="lanc-campo">
                <label for="pedido-codigo"><span><%= t('assinatura.codigo_indicacao') %></span></label>
                <div class="pedido-codigo">
                    <input class="input" type="text" id="pedido-codigo" name="codigo_indicacao" autocomplete="off" maxlength="20" style="text-transform: uppercase;" value="<%= codigoSalvo %>">
                    <button type="button" class="btn btn-outline" id="pedido-aplicar" data-conferindo="<%= t('assinatura.conferindo_codigo') %>"><%= t('assinatura.aplicar_codigo') %></button>
                </div>
                <small class="muted"><%= t('assinatura.codigo_indicacao_dica', { pct: (indicacao || {}).percentual || 20 }) %></small>
                <div class="pedido-desconto" id="pedido-desconto" role="status" aria-live="polite" hidden></div>
            </div>
            <% } %>
            <label class="lanc-campo">
                <span><%= t('assinatura.telefone') %></span>
                <div class="pedido-tel">
                    <select class="input" name="telefone_codigo" aria-label="<%= t('assinatura.pais') %>">
                        <% paises.forEach(pa => { %><option value="<%= pa.codigo %>" <%= (usuarioLogado.telefone_codigo || '+595') === pa.codigo ? 'selected' : '' %>><%= pa.bandeira %> <%= pa.nome[idiomaTel] %> (<%= pa.codigo %>)</option><% }) %>
                    </select>
                    <input class="input" type="tel" name="telefone_numero" inputmode="tel" autocomplete="tel-national" required maxlength="20"
                           placeholder="981 123 456" value="<%= usuarioLogado.telefone_numero || '' %>">
                </div>
                <small class="muted"><%= t('assinatura.telefone_dica') %></small>
            </label>
            <% if (pagoOnline) { %>
            <label class="lanc-campo">
                <span><%= t('assinatura.documento') %></span>
                <input class="input" type="text" name="documento" inputmode="numeric" autocomplete="off" required maxlength="20" placeholder="1234567">
                <small class="muted"><%= t('assinatura.documento_dica') %></small>
            </label>
            <% } %>
            <div class="modal-rodape">
                <button type="button" class="btn btn-outline" data-modal-close><%= t('assinatura.cancelar') %></button>
                <button type="submit" class="btn btn-primary btn-salvar"><%= t(pagoOnline ? 'assinatura.pagar_agora' : 'assinatura.enviar_pedido') %></button>
            </div>
        </form>
    </div>
</div>

<script>
(function () {
    var abas = document.querySelectorAll('.assin-abas [data-tab]');
    function abrir(nome) {
        abas.forEach(function (b) { b.classList.toggle('is-ativo', b.getAttribute('data-tab') === nome); });
        document.querySelectorAll('[data-painel]').forEach(function (p) { p.hidden = p.getAttribute('data-painel') !== nome; });
    }
    abas.forEach(function (b) { b.addEventListener('click', function () { abrir(b.getAttribute('data-tab')); }); });
    // Vindo de "Adquirir por ..." (?comprar=plano): o pedido abre sobre a aba dos planos.
    if (new URLSearchParams(location.search).get('comprar')) abrir('planos');
    if (location.hash === '#indicacao' || location.hash === '#recibos') abrir('assinatura');
})();
</script>
<% if (!acessoBloqueado) { %>
</div>
</div>
<% } %>
