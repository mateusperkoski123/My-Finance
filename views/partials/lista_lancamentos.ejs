<%#
  Lista de lancamentos da "Visao geral" (busca, abas de tipo, agrupar/ordenar, tabela ou acordeoes e paginacao).
  Usada no Painel e em Relatorios (Movimentos pendentes / Estado financeiro). Espera as variaveis do Painel:
  periodo, filtros, ordenacao, agrupamento, lancamentos, grupos, totalRegistros, somaFiltrada, totalPaginas, paginaAtual, porPagina.
  Opcionais: listaBase (caminho, padrao '/'), listaParams (parametros fixos de periodo/aba), agruparOpcoes, limparUrl.
%>
<%
const _listaBase = typeof listaBase !== 'undefined' ? listaBase : '/';
const _listaParams = typeof listaParams !== 'undefined' ? listaParams : (periodo.customizado ? { data_inicio: periodo.inicio, data_fim: periodo.fim } : { mes: periodo.mes, ano: periodo.ano });
const _agruparOpcoes = typeof agruparOpcoes !== 'undefined' ? agruparOpcoes : ['sem_agrupamento', 'categoria', 'subcategoria', 'vencimento', 'criacao', 'conta', 'status'];
const _limparUrl = typeof limparUrl !== 'undefined' ? limparUrl : (_listaBase + '?' + new URLSearchParams(_listaParams).toString());
%>
<!-- Sub-filtros por tipo (Todas / Despesas / Receitas) -->
<div class="card" style="border-radius: 16px; padding: 18px 24px; margin-bottom: 16px;">
    <%
    function buildQueryLink(novosParams) {
        const raw = Object.assign(
            {},
            _listaParams,
            filtros,
            { ordenar: ordenacao, agrupar: agrupamento, por_pagina: porPagina !== 30 ? porPagina : null },
            novosParams
        );
        const cleaned = {};
        for (const key in raw) {
            const val = raw[key];
            if (val !== null && val !== undefined && val !== '' && val !== 'null' && val !== 'undefined' && val !== 'sem_agrupamento') {
                cleaned[key] = val;
            }
        }
        return _listaBase + '?' + new URLSearchParams(cleaned).toString();
    }
    %>
    <form method="get" action="<%= _listaBase %>" class="busca-linha" role="search">
        <% const _p = Object.assign({}, _listaParams, { tipo: filtros.tipo, categoria_id: filtros.categoria_id, subcategoria_id: filtros.subcategoria_id, ordenar: ordenacao, agrupar: agrupamento }); %>
        <% Object.keys(_p).forEach(k => { if (_p[k] !== null && _p[k] !== undefined && _p[k] !== '' && _p[k] !== 'sem_agrupamento') { %><input type="hidden" name="<%= k %>" value="<%= _p[k] %>"><% } }) %>
        <input class="input" type="search" name="busca" value="<%= filtros.busca %>" placeholder="<%= t('painel.busca_placeholder') %>" aria-label="<%= t('painel.buscar_lancamentos') %>">
        <button type="submit" class="btn btn-outline" aria-label="<%= t('categorias.buscar') %>"><i class="ph ph-magnifying-glass"></i></button>
        <% if (filtros.busca) { %><a class="btn btn-outline" href="<%= buildQueryLink({ busca: '' }) %>" title="<%= t('painel.limpar_busca') %>"><i class="ph ph-x"></i></a><% } %>
    </form>
    <div class="tipo-tabs" style="display: flex; gap: 16px; font-size: 13px; font-weight: 600; flex-wrap: wrap;">
        <a href="<%= buildQueryLink({ tipo: 'todas' }) %>" class="<%= filtros.tipo === 'todas' ? 'is-active' : '' %>" style="text-decoration: none; color: <%= filtros.tipo === 'todas' ? 'var(--text)' : 'var(--muted)' %>; <%= filtros.tipo === 'todas' ? 'border-bottom: 2px solid var(--text); padding-bottom: 4px;' : '' %>"><%= t('painel.filtro.todas') %></a>
        <a href="<%= buildQueryLink({ tipo: 'despesas' }) %>" class="<%= (filtros.tipo === 'despesas' || filtros.tipo === 'despesa') ? 'is-active' : '' %>" style="text-decoration: none; color: <%= (filtros.tipo === 'despesas' || filtros.tipo === 'despesa') ? 'var(--text)' : 'var(--muted)' %>; <%= (filtros.tipo === 'despesas' || filtros.tipo === 'despesa') ? 'border-bottom: 2px solid var(--text); padding-bottom: 4px;' : '' %>"><%= t('painel.filtro.despesas') %></a>
        <a href="<%= buildQueryLink({ tipo: 'receitas' }) %>" class="<%= (filtros.tipo === 'receitas' || filtros.tipo === 'receita') ? 'is-active' : '' %>" style="text-decoration: none; color: <%= (filtros.tipo === 'receitas' || filtros.tipo === 'receita') ? 'var(--text)' : 'var(--muted)' %>; <%= (filtros.tipo === 'receitas' || filtros.tipo === 'receita') ? 'border-bottom: 2px solid var(--text); padding-bottom: 4px;' : '' %>"><%= t('painel.filtro.receitas') %></a>
    </div>

<!-- Barra de Ferramentas: Agrupamento & Ordenação (no mesmo cartão das abas, menos ruído visual) -->
<div class="painel-toolbar" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border);">
    <div style="display: flex; align-items: center; gap: 8px;">
        <i class="ph ph-folder" style="font-size: 18px; color: var(--muted);"></i>
        <select class="input" style="padding: 6px 12px; font-size: 13px; border-radius: 12px; min-width: 160px;" onchange="gfAtualizarParam('agrupar', this.value)">
            <% if (_agruparOpcoes.includes('sem_agrupamento')) { %><option value="sem_agrupamento" <%= agrupamento === 'sem_agrupamento' ? 'selected' : '' %>> <%= t('filtro.sem_agrupamento') %></option><% } %>
            <% if (_agruparOpcoes.includes('categoria')) { %><option value="categoria" <%= agrupamento === 'categoria' ? 'selected' : '' %>> <%= t('modal.categoria') %></option><% } %>
            <% if (_agruparOpcoes.includes('subcategoria')) { %><option value="subcategoria" <%= agrupamento === 'subcategoria' ? 'selected' : '' %>> <%= t('modal.subcategoria') %></option><% } %>
            <% if (_agruparOpcoes.includes('vencimento')) { %><option value="vencimento" <%= agrupamento === 'vencimento' ? 'selected' : '' %>> <%= t('filtro.vencimento') %></option><% } %>
            <% if (_agruparOpcoes.includes('criacao')) { %><option value="criacao" <%= agrupamento === 'criacao' ? 'selected' : '' %>> <%= t('filtro.criacao') %></option><% } %>
            <% if (_agruparOpcoes.includes('conta')) { %><option value="conta" <%= agrupamento === 'conta' ? 'selected' : '' %>> <%= t('modal.conta') %></option><% } %>
            <% if (_agruparOpcoes.includes('status')) { %><option value="status" <%= agrupamento === 'status' ? 'selected' : '' %>> <%= t('filtro.status') %></option><% } %>
        </select>
    </div>

    <div style="display: flex; align-items: center; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 6px;">
            <span class="muted" style="font-size: 13px;"><%= t('filtro.ordenar') %></span>
            <select class="input" style="padding: 6px 12px; font-size: 13px; border-radius: 12px;" onchange="gfAtualizarParam('ordenar', this.value)">
                <option value="data" <%= (ordenacao === 'data') ? 'selected' : '' %>><%= t('ordenar.data') %></option>
                <option value="vencimento" <%= ordenacao === 'vencimento' ? 'selected' : '' %>><%= t('ordenar.vencimento') %></option>
                <option value="valor" <%= ordenacao === 'valor' ? 'selected' : '' %>><%= t('ordenar.valor') %></option>
                <option value="criacao" <%= ordenacao === 'criacao' ? 'selected' : '' %>><%= t('ordenar.criacao') %></option>
            </select>
        </div>
    </div>
</div>
</div>

<script>
function gfAtualizarParam(chave, valor) {
    const url = new URL(window.location.href);
    if (valor && valor !== 'sem_agrupamento' && valor !== 'null' && valor !== 'undefined') {
        url.searchParams.set(chave, valor);
    } else {
        url.searchParams.delete(chave);
    }
    if (chave !== 'pagina') url.searchParams.delete('pagina');
    window.location.href = url.toString();
}
</script>

<% const _filtroAtivo = (filtros.tipo && filtros.tipo !== 'todas') || filtros.busca || filtros.categoria_id || filtros.subcategoria_id; %>
<% if (_filtroAtivo) { %>
<div class="filtro-ativo" role="status">
    <span><i class="ph ph-funnel"></i>
        <%= (filtros.tipo === 'despesas' || filtros.tipo === 'despesa') ? t('filtro.somente_despesas') : ((filtros.tipo === 'receitas' || filtros.tipo === 'receita') ? t('filtro.somente_receitas') : t('filtro.ativo')) %>
        · <%- t('filtro.total', { n: '<strong>' + totalRegistros + '</strong>', valor: '<strong>' + moeda(somaFiltrada) + '</strong>' }) %>
    </span>
    <a href="<%= _limparUrl %>"><%= t('filtro.limpar') %></a>
</div>
<% } %>

<!-- Conteúdo: Exibição Agrupada (Accordion) ou Tabela Padrão -->
<div class="card lista-card">
    <% if (lancamentos && lancamentos.length || (grupos && grupos.length)) { %>
    <form method="post" action="/lancamentos/excluir-lote" id="form-lote-lanc" class="lote-barra" data-confirm="">
        <%- csrfCampo %>
        <input type="hidden" name="voltar" value="<%= currentUrl %>">
        <input type="hidden" name="todos" id="lote-lanc-modo" value="">
        <input type="hidden" name="simular" id="lote-lanc-simular" value="">
        <% Object.keys(_listaParams).forEach(function (k) { if (_listaParams[k] !== null && _listaParams[k] !== undefined && _listaParams[k] !== '') { %><input type="hidden" name="<%= k %>" value="<%= _listaParams[k] %>"><% } }) %>
        <input type="hidden" name="tipo" value="<%= filtros.tipo || '' %>">
        <input type="hidden" name="busca" value="<%= filtros.busca || '' %>">
        <input type="hidden" name="categoria_id" value="<%= filtros.categoria_id || '' %>">
        <input type="hidden" name="subcategoria_id" value="<%= filtros.subcategoria_id || '' %>">
        <div class="lote-barra__linha">
            <label class="check" style="margin: 0; display: flex; align-items: center; gap: 8px; font-size: 13px;"><input type="checkbox" class="lote-check" id="lote-lanc-todos" aria-label="<%= t('lote.selecionar_todos') %>"> <%= t('lote.selecionar_todos') %></label>
            <span class="muted" id="lote-lanc-contagem" style="font-size: 13px;"></span>
            <button type="button" class="link-botao" id="lote-lanc-filtro" hidden></button>
            <button type="button" class="link-botao" id="lote-lanc-limpar" hidden><%= t('lote.limpar') %></button>
            <button type="submit" class="btn btn-danger btn-sm" id="lote-lanc-excluir" hidden><i class="ph ph-trash"></i> <%= t('lote.excluir') %></button>
        </div>
        <div class="lote-barra__todos" id="lote-lanc-extra" hidden>
            <label for="lote-lanc-manter" class="muted" style="font-size: 13px;"><%= t('lote.manter_texto') %></label>
            <input class="input" type="text" name="manter" id="lote-lanc-manter" maxlength="80" style="max-width: 320px;">
            <label class="check" style="margin: 0; font-size: 13px; display: flex; align-items: center; gap: 8px;"><input type="checkbox" name="todo_periodo" value="1"> <%= t('lote.todo_periodo') %></label>
            <button type="button" class="btn btn-outline btn-sm" id="lote-lanc-ensaio"><i class="ph ph-magnifying-glass"></i> <%= t('lote.simular') %></button>
        </div>
    </form>
    <script>
    (function () {
        var form = document.getElementById('form-lote-lanc');
        var todos = document.getElementById('lote-lanc-todos');
        var contagem = document.getElementById('lote-lanc-contagem');
        var botao = document.getElementById('lote-lanc-excluir');
        var modo = document.getElementById('lote-lanc-modo');
        var linkFiltro = document.getElementById('lote-lanc-filtro');
        var limpar = document.getElementById('lote-lanc-limpar');
        var extra = document.getElementById('lote-lanc-extra');
        var simular = document.getElementById('lote-lanc-simular');
        var TOTAL = <%= totalRegistros || 0 %>;
        var txtSel = <%- JSON.stringify(t('lote.selecionados', { n: '{n}' })) %>;
        var txtConf = <%- JSON.stringify(t('lote.confirmar', { n: '{n}' })) %>;
        var txtConfTodos = <%- JSON.stringify(t('lote.confirmar_todos')) %>;
        var txtFiltro = <%- JSON.stringify(t('lote.todos_filtro', { total: '{total}' })) %>;
        var txtAtivo = <%- JSON.stringify(t('lote.todos_ativo')) %>;
        function itens() { return Array.prototype.slice.call(document.querySelectorAll('.lote-lanc')); }
        function atualizar() {
            var lista = itens();
            var n = lista.filter(function (i) { return i.checked; }).length;
            var todasPaginas = modo.value === '1';
            contagem.textContent = todasPaginas ? txtAtivo : (n ? txtSel.replace('{n}', n) : '');
            botao.hidden = n === 0 && !todasPaginas;
            todos.checked = todasPaginas || (n > 0 && n === lista.length);
            todos.indeterminate = !todasPaginas && n > 0 && n < lista.length;
            // so oferece "todos do filtro" quando a pagina inteira esta marcada e ha mais lancamentos alem dela
            linkFiltro.hidden = todasPaginas || !(n === lista.length && n > 0 && TOTAL > lista.length);
            if (!linkFiltro.hidden) linkFiltro.textContent = txtFiltro.replace('{total}', TOTAL);
            limpar.hidden = !todasPaginas;
            extra.hidden = !todasPaginas;
            form.setAttribute('data-confirm', todasPaginas ? txtConfTodos : txtConf.replace('{n}', n));
        }
        todos.addEventListener('change', function () { modo.value = ''; itens().forEach(function (i) { i.checked = todos.checked; }); atualizar(); });
        document.addEventListener('change', function (e) { if (e.target && e.target.classList && e.target.classList.contains('lote-lanc')) { modo.value = ''; atualizar(); } });
        linkFiltro.addEventListener('click', function () { modo.value = '1'; atualizar(); });
        limpar.addEventListener('click', function () { modo.value = ''; itens().forEach(function (i) { i.checked = false; }); atualizar(); });
        // Ensaio: manda o formulario pedindo so a contagem (sem confirmacao, porque nada e apagado).
        document.getElementById('lote-lanc-ensaio').addEventListener('click', function () {
            simular.value = '1';
            form.setAttribute('data-confirm', '');
            form.submit();
        });
        form.addEventListener('submit', function () { simular.value = ''; });
        atualizar();
    })();
    </script>
    <% } %>
    <% if (agrupamento && agrupamento !== 'sem_agrupamento' && grupos && grupos.length > 0) { %>
        <!-- Renderização de Acordeões Agrupados estilo Referência -->
        <div style="display: flex; flex-direction: column; gap: 12px;">
            <% grupos.forEach((g, idx) => { %>
                <details class="card lista-grupo" data-grupo="<%= g.key %>" <%= idx === 0 ? 'open' : '' %>>
                    <summary style="display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; cursor: pointer; background: var(--bg); font-weight: 600; font-size: 13.5px; user-select: none;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <i class="ph ph-caret-right" style="font-size: 14px; transition: transform 0.2s;"></i>
                            <strong><%= ({ 'Pagos': t('grupo.pagos'), 'Pendentes': t('grupo.pendentes'), 'Sem Data': t('grupo.sem_data'), 'Outros': t('grupo.outros'), 'Sem categoria': t('comum.sem_categoria'), 'Sem Categoria': t('comum.sem_categoria') })[g.key] || (String(g.key).startsWith('Sem Categoria / ') ? t('comum.sem_categoria') + ' / ' + String(g.key).slice(16) : g.key) %></strong>
                            <span class="muted" style="font-size: 13px; font-weight: normal;">(<%= g.count %>)</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 10px; font-size: 13px;">
                            <% if (g.pagoCount > 0) { %>
                                <span class="badge badge-sucesso"><%= g.pagoCount %> <%= t('lancamento.status.pago').toLowerCase() %></span>
                            <% } %>
                            <% if (g.pendenteCount > 0) { %>
                                <span class="badge badge-alerta"><%= g.pendenteCount %> <%= t('lancamento.status.pendente').toLowerCase() %></span>
                            <% } %>
                            <% if (g.totalReceitas > 0) { %>
                                <span style="color: var(--green); font-weight: 700;">+<%= moeda(g.totalReceitas) %></span>
                            <% } %>
                            <% if (g.totalDespesas > 0) { %>
                                <span style="color: var(--red); font-weight: 700;">-<%= moeda(g.totalDespesas) %></span>
                            <% } %>
                        </div>
                    </summary>

                    <div class="lista-grupo__corpo">
                        <div class="tabela-container">
                            <table class="tabela tabela-lanc">
                                <thead>
                                    <tr>
                                        <th class="lote-col"></th>
                                        <th><%= t('painel.lancamento.descricao_label') %></th>
                                        <th><%= t('painel.lancamento.categoria_label') %></th>
                                        <th><%= t('painel.lancamento.conta_label') %></th>
                                        <th><%= t('painel.lancamento.data_label') %></th>
                                        <th><%= t('painel.lancamento.valor_label') %></th>
                                        <th><%= t('painel.lancamento.status_label') %></th>
                                        <th><%= t('tabela.acoes') %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% g.lancamentos.forEach(l => { %>
                                        <tr class="lanc-linha lanc-linha--<%= l.tipo %>">
                                            <td class="lote-col"><input type="checkbox" class="lote-check lote-lanc" name="ids" value="<%= l.id %>" form="form-lote-lanc" aria-label="<%= t('lote.selecionar') %>"></td>
                                            <td>
                                                <% const _sis = (l.tipo === 'ajuste' || l.tipo === 'transferencia'); const _desc = descricaoLancamento(l); %>
                                                <strong title="<%= _desc %>"><% if (_sis) { %><i class="ph <%= l.tipo === 'ajuste' ? 'ph-scales' : 'ph-arrows-left-right' %>" style="color: var(--muted);"></i> <% } %><%= _sis ? _desc : truncarTexto(l.descricao, 45) %></strong>
                                                <%- include('badge_serie', { l: l }) %>
                                            </td>
                                            <td>
                                                <% if (l.categoria_nome) { %>
                                                    <div style="display: flex; flex-direction: column; gap: 2px;">
                                                        <span style="font-weight: 600; font-size: 13px; color: var(--text); display: flex; align-items: center; gap: 6px; white-space: nowrap;">
                                                            <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: <%= l.categoria_cor || '#3b82f6' %>; flex-shrink: 0;"></span>
                                                            <a href="/categorias/<%= l.categoria_parent_id || l.categoria_id %>" class="link-categoria" title="<%= t('categorias.det_abrir') %>" style="color: inherit;"><%= l.categoria_nome %></a>
                                                        </span>
                                                        <% if (l.subcategoria_nome) { %>
                                                            <a href="/categorias/<%= l.categoria_id %>" class="link-categoria muted" title="<%= t('categorias.det_abrir') %>" style="font-size: 12px; padding-left: 14px; white-space: nowrap;"><%= l.subcategoria_nome %></a>
                                                        <% } %>
                                                    </div>
                                                <% } else { %>
                                                    <span class="muted">—</span>
                                                <% } %>
                                            </td>
                                            <td><%= l.conta_nome || '—' %></td>
                                            <td><%= formatDate(l.data_competencia, 'DD/MM/YYYY') %></td>
                                            <td style="font-weight: 700; white-space: nowrap; color: <%= (l.tipo === 'despesa' || (l.tipo !== 'receita' && parseFloat(l.valor) < 0)) ? 'var(--red)' : 'var(--green)' %>;">
                                                <%= (l.tipo === 'despesa' || (l.tipo !== 'receita' && parseFloat(l.valor) < 0)) ? '-' : '+' %> <%= moeda(Math.abs(parseFloat(l.valor)), l.conta_moeda) %><% if (l.tipo === 'transferencia') { const _cb = cambioTexto(l); if (_cb) { %><span class="lanc-cambio"><%= _cb %></span><% } } %>
                                            </td>
                                            <td>
                                                <span class="badge <%= l.status === 'pago' ? 'badge-sucesso' : 'badge-alerta' %>">
                                                    <%= l.status === 'pago' ? (l.tipo === 'receita' ? t('lanc.status.recebido') : t('lanc.status.pago')) : t('lanc.status.pendente') %>
                                                </span>
                                            </td>
                                            <td class="td-acoes"><%- include('../partials/acoes_lancamento', { l: l, modalSerie: true }) %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </details>
            <% }) %>
        </div>
    <% } else { %>
        <!-- Tabela Padrão (Sem Agrupamento) -->
        <div class="tabela-container">
            <table class="tabela tabela-lanc">
                <thead>
                    <tr>
                        <th class="lote-col"></th>
                                        <th><%= t('painel.lancamento.descricao_label') %></th>
                        <th><%= t('painel.lancamento.categoria_label') %></th>
                        <th><%= t('painel.lancamento.conta_label') %></th>
                        <th><%= t('painel.lancamento.data_label') %></th>
                        <th><%= t('painel.lancamento.valor_label') %></th>
                        <th><%= t('painel.lancamento.status_label') %></th>
                        <th><%= t('tabela.acoes') %></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!lancamentos || lancamentos.length === 0) { %>
                        <tr>
                            <td colspan="8" class="tabela__vazio"><div class="vazio"><i class="ph ph-receipt"></i><strong><%= t('painel.lista_vazia') %></strong><%= t('painel.vazio_dica') %></div></td>
                        </tr>
                    <% } else { %>
                        <% lancamentos.forEach(l => { %>
                            <tr class="lanc-linha lanc-linha--<%= l.tipo %>">
                                            <td class="lote-col"><input type="checkbox" class="lote-check lote-lanc" name="ids" value="<%= l.id %>" form="form-lote-lanc" aria-label="<%= t('lote.selecionar') %>"></td>
                                <td>
                                    <% const _sis = (l.tipo === 'ajuste' || l.tipo === 'transferencia'); const _desc = descricaoLancamento(l); %>
                                                <strong title="<%= _desc %>"><% if (_sis) { %><i class="ph <%= l.tipo === 'ajuste' ? 'ph-scales' : 'ph-arrows-left-right' %>" style="color: var(--muted);"></i> <% } %><%= _sis ? _desc : truncarTexto(l.descricao, 45) %></strong>
                                    <%- include('badge_serie', { l: l }) %>
                                </td>
                                <td>
                                    <% if (l.categoria_nome) { %>
                                        <div style="display: flex; flex-direction: column; gap: 2px;">
                                            <span style="font-weight: 600; font-size: 13px; color: var(--text); display: flex; align-items: center; gap: 6px; white-space: nowrap;">
                                                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: <%= l.categoria_cor || '#3b82f6' %>; flex-shrink: 0;"></span>
                                                <a href="/categorias/<%= l.categoria_parent_id || l.categoria_id %>" class="link-categoria" title="<%= t('categorias.det_abrir') %>" style="color: inherit;"><%= l.categoria_nome %></a>
                                            </span>
                                            <% if (l.subcategoria_nome) { %>
                                                <a href="/categorias/<%= l.categoria_id %>" class="link-categoria muted" title="<%= t('categorias.det_abrir') %>" style="font-size: 12px; padding-left: 14px; white-space: nowrap;"><%= l.subcategoria_nome %></a>
                                            <% } %>
                                        </div>
                                    <% } else { %>
                                        <span class="muted">—</span>
                                    <% } %>
                                </td>
                                <td><%= l.conta_nome || '—' %></td>
                                <td><%= formatDate(l.data_competencia, 'DD/MM/YYYY') %></td>
                                <td style="font-weight: 700; white-space: nowrap; color: <%= (l.tipo === 'despesa' || (l.tipo !== 'receita' && parseFloat(l.valor) < 0)) ? 'var(--red)' : 'var(--green)' %>;">
                                                <%= (l.tipo === 'despesa' || (l.tipo !== 'receita' && parseFloat(l.valor) < 0)) ? '-' : '+' %> <%= moeda(Math.abs(parseFloat(l.valor)), l.conta_moeda) %><% if (l.tipo === 'transferencia') { const _cb = cambioTexto(l); if (_cb) { %><span class="lanc-cambio"><%= _cb %></span><% } } %>
                                </td>
                                <td>
                                    <span class="badge <%= l.status === 'pago' ? 'badge-sucesso' : 'badge-alerta' %>">
                                        <%= l.status === 'pago' ? (l.tipo === 'receita' ? t('lanc.status.recebido') : t('lanc.status.pago')) : t('lanc.status.pendente') %>
                                    </span>
                                </td>
                                <td class="td-acoes"><%- include('../partials/acoes_lancamento', { l: l, modalSerie: true }) %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<% if ((!agrupamento || agrupamento === 'sem_agrupamento') && totalRegistros > 0) { %>
<%
const _ini = (paginaAtual - 1) * porPagina + 1;
const _fim = Math.min(paginaAtual * porPagina, totalRegistros);
%>
<div class="paginacao" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-top: 12px; font-size: 13px;">
    <span class="muted"><%= t('paginacao.mostrando', { a: _ini, b: _fim, total: totalRegistros }) %></span>
    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
        <label class="muted" style="display: flex; align-items: center; gap: 6px; margin: 0;"><%= t('paginacao.por_pagina') %>
            <select class="input" style="padding: 4px 8px; font-size: 13px; width: auto; border-radius: 8px;" onchange="gfAtualizarParam('por_pagina', this.value)">
                <% [30, 50, 100, 200, 500].forEach(n => { %><option value="<%= n %>" <%= porPagina === n ? 'selected' : '' %>><%= n %></option><% }) %>
            </select>
        </label>
        <% if (paginaAtual > 1) { %><a class="btn btn-outline btn-sm" href="<%= buildQueryLink({ pagina: paginaAtual - 1 }) %>"><i class="ph ph-caret-left"></i> <%= t('paginacao.voltar') %></a><% } %>
        <% if (paginaAtual < totalPaginas) { %><a class="btn btn-outline btn-sm" href="<%= buildQueryLink({ pagina: paginaAtual + 1 }) %>"><%= t('paginacao.proximo') %> <i class="ph ph-caret-right"></i></a><% } %>
    </div>
</div>
<% } %>
