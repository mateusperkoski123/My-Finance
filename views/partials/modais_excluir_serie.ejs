<%# Modais "Excluir serie" (so / esta e proximas / toda a serie) das linhas em serie. Espera: lancamentos. Usado no Painel e em Relatorios. %>
<!-- Modais Excluir Série (a edição usa o modal compartilhado de partials/modais_lancamento) -->
<% if (lancamentos && lancamentos.length > 0) { %>
    <% lancamentos.filter(l => l.tipo === 'receita' || l.tipo === 'despesa' || (l.tipo === 'transferencia' && l.transferencia_par_id)).forEach(l => { %>
        <% if (l.serie_id) { %>
            <div class="modal-backdrop" id="modal-excluir-<%= l.id %>">
                <div class="modal card">
                    <div class="modal__header">
                        <h3><%= t('painel.excluir_serie_titulo') %></h3>
                        <button type="button" class="modal__close" data-modal-close>&times;</button>
                    </div>
                    <form method="post" action="/lancamentos/<%= l.id %>/excluir" class="form" data-ajax>
                        <%- csrfCampo %>
<input type="hidden" name="voltar" value="<%= currentUrl %>">
                        <p style="font-weight: 600; font-size: 13.5px; margin-bottom: 6px;"><%= t('painel.excluir_serie_aviso') %></p>
                        <p class="muted" style="font-size: 12px; margin-top: 0; margin-bottom: 16px;"><%= t('painel.excluir_serie_pergunta') %></p>

                        <div style="background: var(--bg); padding: 14px; border-radius: 12px; margin-bottom: 16px; border: 1px solid var(--border);">
                            <label style="display: block; margin-bottom: 10px; font-size: 13px; cursor: pointer;">
                                <input type="radio" name="escopo_serie" value="apenas_esta" checked>
                                <strong><%= t('series.apenas_esta') %></strong>
                                <span class="muted" style="display: block; font-size: 11px; margin-left: 20px;"><%= t('series.apenas_esta_desc') %></span>
                            </label>
                            <label style="display: block; margin-bottom: 10px; font-size: 13px; cursor: pointer;">
                                <input type="radio" name="escopo_serie" value="esta_e_proximas">
                                <strong><%= t('series.esta_e_proximas') %></strong>
                                <span class="muted" style="display: block; font-size: 11px; margin-left: 20px;"><%= t('series.esta_e_proximas_desc') %></span>
                            </label>
                            <label style="display: block; font-size: 13px; cursor: pointer;">
                                <input type="radio" name="escopo_serie" value="toda_serie">
                                <strong><%= t('series.toda_serie') %></strong>
                                <span class="muted" style="display: block; font-size: 11px; margin-left: 20px;"><%= t('series.toda_serie_desc') %></span>
                            </label>
                        </div>

                        <div class="modal__actions">
                            <button type="button" class="btn btn-outline" data-modal-close><%= t('modal.cancelar') %></button>
                            <button type="submit" class="btn btn-primary" style="background: var(--red); border: none;"><%= t('painel.confirmar_exclusao_btn') %></button>
                        </div>
                    </form>
                </div>
            </div>
        <% } %>
    <% }) %>
<% } %>
