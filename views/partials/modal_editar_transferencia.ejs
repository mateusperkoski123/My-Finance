<%# Modal "Editar transferencia" entre contas: valor, data e situacao. Preenchido por public/assets/js/app.js (botao com data-editar-transf).
   A data e uma so: o dia do vencimento (pendente) ou o dia em que a transferencia foi feita (paga). %>
<div class="modal-backdrop modal-backdrop--lanc" id="modal-editar-transferencia" data-modal>
    <div class="modal card modal--lanc modal--transferencia">
        <div class="modal__header">
            <div class="modal__titulo">
                <span class="modal__icone"><i class="ph ph-arrows-left-right"></i></span>
                <h2><%= t('modal.editar_transferencia') %></h2>
            </div>
            <button type="button" class="modal__fechar" data-modal-close aria-label="<%= t('comum.fechar') %>"><i class="ph ph-x"></i></button>
        </div>

        <form method="post" action="#" class="form lanc-form" data-editar-form data-ajax>
            <%- csrfCampo %>
            <input type="hidden" name="voltar" value="<%= currentUrl %>">

            <div class="lanc-campo">
                <strong data-transf-descricao style="display: block; font-size: 13.5px; overflow-wrap: anywhere;"></strong>
                <span class="muted" style="font-size: 11.5px;"><%= t('modal.transf_aviso') %></span>
            </div>

            <div class="form-group">
                <label for="ed-transf-valor"><%= t('modal.valor') %></label>
                <input class="input lanc-form__valor" type="text" id="ed-transf-valor" name="valor" data-money data-money-positivo required>
            </div>

            <div class="lanc-campo lanc-campo--linha">
                <div class="lanc-campo__rotulo">
                    <span class="lanc-campo__ico lanc-campo__ico--status" data-status-icon-box><i class="ph ph-clock" data-status-icon></i></span>
                    <div>
                        <strong data-status-title><%= t('modal.nao_foi_pago') %></strong>
                        <small><%= t('painel.status_pagamento') %></small>
                    </div>
                </div>
                <label class="toggle">
                    <input type="checkbox" name="status" value="pago" data-gf-status-toggle data-tipo="despesa" aria-label="<%= t('modal.foi_pago') %>">
                    <span class="toggle__track"><span class="toggle__thumb"></span></span>
                </label>
            </div>

            <div class="lanc-campo">
                <label class="lanc-campo__rotulo" for="ed-transf-data">
                    <span class="lanc-campo__ico"><i class="ph ph-calendar"></i></span>
                    <strong data-status-date-label><%= t('modal.data_vencimento') %></strong>
                </label>
                <input class="input" type="date" id="ed-transf-data" name="data_competencia" required>
            </div>

            <div class="lanc-campo" data-ed-serie hidden>
                <p class="lanc-serie__titulo"><%= t('series.titulo') %></p>
                <p class="muted lanc-serie__dica"><%= t('modal.transf_escopo_dica') %></p>
                <label class="lanc-serie__opcao"><input type="radio" name="escopo_serie" value="apenas_esta" checked> <%= t('series.apenas_esta') %></label>
                <label class="lanc-serie__opcao"><input type="radio" name="escopo_serie" value="esta_e_proximas"> <%= t('series.esta_e_proximas') %></label>
                <label class="lanc-serie__opcao"><input type="radio" name="escopo_serie" value="toda_serie"> <%= t('series.toda_serie') %></label>
            </div>

            <div class="modal-rodape">
                <button type="button" class="btn btn-outline" data-modal-close><%= t('modal.cancelar') %></button>
                <button type="submit" class="btn btn-salvar"><i class="ph ph-floppy-disk"></i> <%= t('modal.salvar') %></button>
            </div>
        </form>
    </div>
</div>
