<%
const _editavel = l.tipo === 'receita' || l.tipo === 'despesa';
const _agendada = l.tipo === 'transferencia' && !!l.transferencia_par_id; // par de transferencia agendada
const _rotuloPagar = l.tipo === 'receita' ? t('acao.receber') : t('acao.pagar');
%>
<div class="acoes-linha">
    <% if (l.status !== 'pago') { %>
        <form method="post" action="/lancamentos/<%= l.id %>/marcar-pago" data-ajax>
            <%- csrfCampo %>
            <input type="hidden" name="voltar" value="<%= currentUrl %>">
            <input type="hidden" name="status" value="pago">
            <button type="submit" class="btn-pagar" title="<%= l.tipo === 'receita' ? t('acao.marcar_recebido') : t('acao.marcar_pago') %>"><i class="ph ph-check-circle"></i><span><%= _rotuloPagar %></span></button>
        </form>
    <% } %>
    <% if (_editavel || _agendada) { %>
        <details class="menu-acoes">
            <summary aria-label="<%= t('acao.mais') %>" title="<%= t('acao.mais') %>"><i class="ph ph-dots-three-vertical"></i></summary>
            <div class="menu-acoes__lista">
                <% if (_editavel) { %><button type="button" data-editar-lanc="<%= JSON.stringify({ id: l.id, tipo: l.tipo, descricao: l.descricao, valor: Math.abs(parseFloat(l.valor)), conta_id: l.conta_id, categoria_id: l.categoria_id, data_competencia: formatDate(l.data_competencia, 'YYYY-MM-DD'), data_pagamento: l.data_pagamento ? formatDate(l.data_pagamento, 'YYYY-MM-DD') : '', status: l.status, serie: !!l.serie_id }) %>"><i class="ph ph-pencil-simple"></i> <%= t('acao.editar') %></button><% } %>
                <% if (l.status === 'pago') { %>
                    <form method="post" action="/lancamentos/<%= l.id %>/marcar-pago" data-ajax>
                        <%- csrfCampo %>
                        <input type="hidden" name="voltar" value="<%= currentUrl %>">
                        <input type="hidden" name="status" value="pendente">
                        <button type="submit"><i class="ph ph-arrow-counter-clockwise"></i> <%= t('acao.desfazer') %></button>
                    </form>
                <% } %>
                <% if (l.serie_id && typeof modalSerie !== 'undefined' && modalSerie) { %>
                    <button type="button" class="perigo" data-modal-open="modal-excluir-<%= l.id %>"><i class="ph ph-trash"></i> <%= t('acao.excluir') %></button>
                <% } else { %>
                    <form method="post" action="/lancamentos/<%= l.id %>/excluir" data-ajax data-confirm="<%= t('painel.lancamento.confirmar_exclusao') %>">
                        <%- csrfCampo %>
                        <input type="hidden" name="voltar" value="<%= currentUrl %>">
                        <button type="submit" class="perigo"><i class="ph ph-trash"></i> <%= t('acao.excluir') %></button>
                    </form>
                <% } %>
            </div>
        </details>
    <% } %>
</div>
