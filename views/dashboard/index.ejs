

<%
const dataHoje = formatDate(hojeLocal());
const data7DiasDate = hojeLocal(); data7DiasDate.setDate(data7DiasDate.getDate() - 7);
const data7Dias = formatDate(data7DiasDate);
const dataAnoInicio = hojeLocal().getFullYear() + '-01-01';
const dataAnoFim = hojeLocal().getFullYear() + '-12-31';

const e7Dias = periodo.customizado && periodo.inicio === data7Dias && periodo.fim === dataHoje;
const eAno = periodo.customizado && periodo.inicio === dataAnoInicio && periodo.fim === dataAnoFim;
// Qualquer ano inteiro (1/1 a 31/12) e tratado como visao anual, com setas de ano a ano.
const _anoInteiro = periodo.customizado && /^\d{4}-01-01$/.test(periodo.inicio) && periodo.fim === periodo.inicio.slice(0, 4) + '-12-31' ? Number(periodo.inicio.slice(0, 4)) : null;
const _livre = periodo.customizado && !_anoInteiro;
const _ymd = (d) => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
const _dt = (iso) => { const p = iso.split('-').map(Number); return new Date(p[0], p[1] - 1, p[2]); };
const _linkAno = (a) => '/?data_inicio=' + a + '-01-01&data_fim=' + a + '-12-31';
// Periodo livre: as setas andam o mesmo numero de dias para tras / para frente.
const _dias = _livre ? Math.round((_dt(periodo.fim) - _dt(periodo.inicio)) / 86400000) + 1 : 0;
const _deslocar = (sinal) => { const i = _dt(periodo.inicio); i.setDate(i.getDate() + sinal * _dias); const f = _dt(periodo.fim); f.setDate(f.getDate() + sinal * _dias); return '/?data_inicio=' + _ymd(i) + '&data_fim=' + _ymd(f); };
const _hoje = hojeLocal();
const _mesPassado = new Date(_hoje.getFullYear(), _hoje.getMonth() - 1, 1);
const _ultimos30 = new Date(_hoje.getFullYear(), _hoje.getMonth(), _hoje.getDate() - 29);
const eMes = !periodo.customizado && periodo.e_mes_atual;
const eHoje = periodo.customizado && periodo.inicio === dataHoje && periodo.fim === dataHoje;

const nomesMeses = {
    1: t('painel.mes.1'), 2: t('painel.mes.2'), 3: t('painel.mes.3'), 4: t('painel.mes.4'),
    5: t('painel.mes.5'), 6: t('painel.mes.6'), 7: t('painel.mes.7'), 8: t('painel.mes.8'),
    9: t('painel.mes.9'), 10: t('painel.mes.10'), 11: t('painel.mes.11'), 12: t('painel.mes.12')
};
%>

<%- include('../partials/moeda_foco') %>
<div class="myfinance-top-controls card" data-periodo-ini="<%= periodo.inicio %>" data-periodo-fim="<%= periodo.fim %>" style="margin-bottom: 20px; padding: 14px 16px;">
    <!-- Top row: Month navigator & Period Badge -->
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 12px;">
        <div style="display: flex; align-items: center; gap: 8px; flex: 1; min-width: 220px; justify-content: space-between; background: var(--bg); padding: 8px 12px; border-radius: 12px; border: 1px solid var(--border);">
            <a class="btn btn-outline btn-sm" href="<%= _anoInteiro ? _linkAno(_anoInteiro - 1) : (_livre ? _deslocar(-1) : '/?mes=' + periodo.mes_anterior + '&ano=' + periodo.ano_anterior) %>" style="border-radius: 8px;" aria-label="<%= t('painel.periodo_anterior') %>"><i class="ph ph-caret-left"></i></a>
            <div style="text-align: center;">
                <strong style="font-size: 15px; font-weight: 700; display: block; color: var(--text);"><% if (_anoInteiro) { %><%= t('painel.ano_titulo', { ano: _anoInteiro }) %><% } else if (_livre) { %><%= t('painel.periodo_personalizado') %><% } else { %><%= nomesMeses[periodo.mes] %> <%= periodo.ano %><% } %></strong>
                <span class="muted" style="font-size: 12px; font-weight: 500;"><%= formatDate(periodo.inicio, 'DD/MM/YYYY') %> - <%= formatDate(periodo.fim, 'DD/MM/YYYY') %></span>
            </div>
            <a class="btn btn-outline btn-sm" href="<%= _anoInteiro ? _linkAno(_anoInteiro + 1) : (_livre ? _deslocar(1) : '/?mes=' + periodo.mes_proximo + '&ano=' + periodo.ano_proximo) %>" style="border-radius: 8px;" aria-label="<%= t('painel.periodo_proximo') %>"><i class="ph ph-caret-right"></i></a>
        </div>

        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
            <div class="seg">
                <a href="/?data_inicio=<%= dataHoje %>&data_fim=<%= dataHoje %>" class="<%= eHoje ? 'is-on' : '' %>"><%= t('painel.hoje') %></a>
                <a href="/?mes=<%= hojeLocal().getMonth() + 1 %>&ano=<%= hojeLocal().getFullYear() %>" class="<%= eMes ? 'is-on' : '' %>"><%= t('filtro.mes_atual') %></a>
                <a href="/?data_inicio=<%= dataAnoInicio %>&data_fim=<%= dataAnoFim %>" class="<%= eAno ? 'is-on' : '' %>"><%= t('painel.este_ano') %></a>
                <%# Periodo livre e filtro so existem quando ha contas (os formularios ficam mais abaixo, junto com a lista). %>
                <% if (contas && contas.length > 0) { %>
                <button type="button" class="<%= _livre && !eHoje && !e7Dias && !eAno ? 'is-on' : '' %>" data-modal-open="modal-periodo"><i class="ph ph-calendar-dots"></i> <%= t('painel.personalizado') %></button>
                <% } %>
            </div>
            <% if (contas && contas.length > 0) { %>
            <button type="button" class="btn btn-outline btn-sm" data-modal-open="modal-filtro-avancado" style="border-radius: 20px; min-height: 42px;"><i class="ph ph-sliders-horizontal"></i> <%= t('filtro.filtrar') %></button>
            <% } %>
        </div>
    </div>
</div>

<% if (!contas || contas.length === 0) { %>
    <div class="card boas-vindas">
        <h2><%= t('painel.bv_titulo') %></h2>
        <p class="muted" style="margin: 0;"><%= t('painel.bv_sub') %></p>
        <ol>
            <li><b>1</b><span><%- t('painel.bv_passo1') %></span></li>
            <li><b>2</b><span><%- t('painel.bv_passo2') %></span></li>
            <li><b>3</b><span><%- t('painel.bv_passo3') %></span></li>
        </ol>
        <div class="boas-vindas__acoes">
            <a href="/contas" class="btn btn-primary"><%= t('painel.ir_para_contas') %></a>
            <a href="/guia" class="btn btn-outline"><i class="ph ph-book-open"></i> <%= t('guia.ver') %></a>
        </div>
    </div>
<% } else { %>

<% const _temPend = Boolean(pendenciasUrgentes && pendenciasUrgentes.totalGeral > 0); %>
<%# Resumo do periodo em 4 cartoes: o saldo de hoje, as receitas, as despesas e como o periodo deve terminar. Receitas e despesas
    separam o que ja aconteceu (recebido/pago) do que falta (a receber/a pagar). %>
<%
const _entrou = Number(resumo.receitas_recebidas) || 0, _saiu = Number(resumo.despesas_pagas) || 0, _sobrou = _entrou - _saiu;
const _aReceber = Number(resumo.receitas_a_receber) || 0, _aPagar = Number(resumo.despesas_nao_pagas) || 0;
const _recTotal = _entrou + _aReceber, _despTotal = _saiu + _aPagar, _resultado = _recTotal - _despTotal;
const _rotPeriodo = formatDate(periodo.inicio, 'DD/MM/YYYY') + ' - ' + formatDate(periodo.fim, 'DD/MM/YYYY');
const _comSinal = (v) => (v < 0 ? '-' : '') + moeda(Math.abs(v));
const _cor = (v) => v >= 0 ? 'var(--green)' : 'var(--red)';
%>
<section class="painel-kpis" aria-label="<%= t('painel.kpi.aria') %>">
    <article class="card pkpi pkpi--saldo">
        <div class="pkpi__topo">
            <span class="pkpi__rotulo"><span class="pkpi__icone"><i class="ph ph-wallet"></i></span><%= t('painel.saldo_disponivel') %></span>
            <button type="button" id="btn-ocultar-saldo" class="btn-olho" aria-label="<%= t('painel.ocultar_saldo') %>" title="<%= t('painel.ocultar_saldo') %>" aria-pressed="false"><i class="ph ph-eye"></i></button>
        </div>
        <div class="pkpi__valor" data-saldo-oculta style="color: <%= _cor(resumo.saldo_disponivel) %>;"><%= _comSinal(resumo.saldo_disponivel) %></div>
        <div class="pkpi__sub"><%= t('painel.kpi.todas_contas') %></div>
        <div class="pkpi__chips">
            <div class="pkpi__chip"><small><%= t('painel.saldo_anterior') %></small><b data-saldo-oculta><%= _comSinal(resumo.saldo_anterior) %></b></div>
            <div class="pkpi__chip pkpi__chip--<%= _sobrou >= 0 ? 'verde' : 'vermelho' %>" title="<%= t('painel.resumo_dica') %>"><small><%= t('painel.sobrou') %></small><b data-saldo-oculta><%= _comSinal(_sobrou) %></b></div>
        </div>
    </article>
    <article class="card pkpi pkpi--receitas">
        <div class="pkpi__topo">
            <span class="pkpi__rotulo"><span class="pkpi__icone"><i class="ph ph-arrow-circle-up"></i></span><%= t('painel.receitas') %></span>
            <button type="button" class="pkpi__novo" data-modal-open="modal-novo-receita" aria-label="<%= t('painel.nova_receita') %>" title="<%= t('painel.nova_receita') %>"><i class="ph-bold ph-plus"></i></button>
        </div>
        <div class="pkpi__valor" data-saldo-oculta style="color: var(--green);"><%= moeda(_recTotal) %></div>
        <div class="pkpi__sub"><%= _rotPeriodo %></div>
        <div class="pkpi__chips">
            <div class="pkpi__chip pkpi__chip--verde"><small><i class="ph ph-check-circle" aria-hidden="true"></i> <%= t('painel.recebido') %></small><b data-saldo-oculta><%= moeda(_entrou) %></b></div>
            <div class="pkpi__chip pkpi__chip--ambar"><small><i class="ph ph-clock" aria-hidden="true"></i> <%= t('painel.a_receber') %></small><b data-saldo-oculta><%= moeda(_aReceber) %></b></div>
        </div>
    </article>
    <article class="card pkpi pkpi--despesas">
        <div class="pkpi__topo">
            <span class="pkpi__rotulo"><span class="pkpi__icone"><i class="ph ph-arrow-circle-down"></i></span><%= t('painel.despesas') %></span>
            <button type="button" class="pkpi__novo" data-modal-open="modal-novo-despesa" aria-label="<%= t('painel.nova_despesa') %>" title="<%= t('painel.nova_despesa') %>"><i class="ph-bold ph-plus"></i></button>
        </div>
        <div class="pkpi__valor" data-saldo-oculta style="color: var(--red);"><%= moeda(_despTotal) %></div>
        <div class="pkpi__sub"><%= _rotPeriodo %></div>
        <div class="pkpi__chips">
            <div class="pkpi__chip pkpi__chip--verde"><small><i class="ph ph-check-circle" aria-hidden="true"></i> <%= t('painel.pago') %></small><b data-saldo-oculta><%= moeda(_saiu) %></b></div>
            <div class="pkpi__chip pkpi__chip--vermelho"><small><i class="ph ph-clock" aria-hidden="true"></i> <%= t('painel.pend_pagar') %></small><b data-saldo-oculta><%= moeda(_aPagar) %></b></div>
        </div>
    </article>
    <article class="card pkpi pkpi--previsto">
        <div class="pkpi__topo">
            <span class="pkpi__rotulo"><span class="pkpi__icone"><i class="ph ph-chart-line-up"></i></span><%= t('painel.saldo_previsto') %></span>
        </div>
        <div class="pkpi__valor" data-saldo-oculta style="color: <%= _cor(resumo.saldo_previsto) %>;"><%= _comSinal(resumo.saldo_previsto) %></div>
        <div class="pkpi__sub"><%= t('painel.kpi.apos_pendencias') %></div>
        <div class="pkpi__chips pkpi__chips--um">
            <div class="pkpi__chip pkpi__chip--<%= _resultado >= 0 ? 'verde' : 'vermelho' %>" title="<%= t('painel.kpi.resultado_dica') %>"><small><%= t('painel.kpi.resultado') %></small><b data-saldo-oculta><%= _comSinal(_resultado) %></b></div>
        </div>
    </article>
</section>
<script>
// Ocultar/mostrar os valores. Alem do carregamento, roda quando a pagina troca o conteudo sem recarregar
// (depois de pagar ou salvar um lancamento): os valores precisam continuar ocultos.
(function () {
    function iniciar() {
        var btn = document.getElementById('btn-ocultar-saldo');
        if (!btn) return;
        var els = document.querySelectorAll('[data-saldo-oculta]');
        els.forEach(function (el) { el.setAttribute('data-original', el.textContent.trim()); });
        function aplicar(oculto) {
            els.forEach(function (el) { el.textContent = oculto ? '••••••' : el.getAttribute('data-original'); });
            btn.firstElementChild.className = oculto ? 'ph ph-eye-slash' : 'ph ph-eye';
            btn.setAttribute('aria-pressed', oculto ? 'true' : 'false');
        }
        var oculto = false;
        try { oculto = localStorage.getItem('gf_saldo_oculto') === '1'; } catch (e) {}
        aplicar(oculto);
        btn.addEventListener('click', function () {
            oculto = !oculto;
            try { localStorage.setItem('gf_saldo_oculto', oculto ? '1' : '0'); } catch (e) {}
            aplicar(oculto);
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', iniciar); else iniciar();
})();
</script>

<% if (_temPend) { %>
<!-- Pendencias vencidas ou que vencem hoje -->
<section class="card pendencias" id="pendencias" aria-label="<%= t('painel.pendencias') %>">
    <div class="pendencias__topo">
        <span class="pendencias__titulo"><i class="ph ph-warning-circle" style="color: var(--pendente); font-size: 18px;"></i> <%= t('painel.vencidas_hoje', { n: pendenciasUrgentes.total }) %></span>
        <a href="/relatorios?aba=pendentes" class="muted" style="font-size: 13px; font-weight: 600;"><%= t('painel.ver_todas') %></a>
    </div>
    <%# Filtro do cartao: A receber / A pagar (clicar de novo no ativo volta a mostrar tudo). O servidor filtra, porque o cartao so lista os 5 primeiros. %>
    <%
    const _qsPend = new URLSearchParams(String(currentUrl || '').split('?')[1] || '');
    _qsPend.delete('pend');
    const _linkPend = (v) => { const q = new URLSearchParams(_qsPend); if (v) q.set('pend', v); const s = q.toString(); return currentRoute + (s ? '?' + s : '') + '#pendencias'; };
    %>
    <div class="pendencias__filtros" role="group" aria-label="<%= t('painel.pend_filtrar') %>">
        <% [['receber', 'painel.pend_receber', pendenciasUrgentes.totalReceber], ['pagar', 'painel.pend_pagar', pendenciasUrgentes.totalPagar]].forEach(function (f) { const _ativo = filtroPend === f[0]; %>
            <% if (f[2] > 0 || _ativo) { %>
                <a class="pendencias__filtro pendencias__filtro--<%= f[0] %><%= _ativo ? ' is-active' : '' %>" href="<%= _linkPend(_ativo ? null : f[0]) %>" aria-pressed="<%= _ativo ? 'true' : 'false' %>"><%= t(f[1]) %> <span>(<%= f[2] %>)</span></a>
            <% } else { %>
                <span class="pendencias__filtro pendencias__filtro--<%= f[0] %> is-vazio" aria-disabled="true"><%= t(f[1]) %> <span>(0)</span></span>
            <% } %>
        <% }) %>
    </div>
    <div class="pendencias__lista">
        <% if (!pendenciasUrgentes.itens.length) { %><p class="muted" style="margin: 8px 0 0; font-size: 13px;"><%= t('painel.pend_vazio') %></p><% } %>
        <% pendenciasUrgentes.itens.forEach(p => { const dias = parseInt(p.dias_atraso, 10) || 0; %>
            <div class="pendencias__item">
                <div class="pendencias__info">
                    <div class="pendencias__desc"><%= p.descricao %></div>
                    <div class="pendencias__meta"><%= p.conta_nome %> · <%= formatDate(p.data_competencia, 'DD/MM/YYYY') %> ·
                        <% if (dias > 0) { %><span class="atraso"><%= t(dias > 1 ? 'painel.dias_atraso' : 'painel.dia_atraso', { n: dias }) %></span><% } else { %><%= t('painel.vence_hoje') %><% } %>
                    </div>
                </div>
                <div class="pendencias__valor" style="color: <%= p.tipo === 'receita' ? 'var(--green)' : 'var(--red)' %>;"><%= p.tipo === 'receita' ? '+' : '-' %> <%= moeda(Math.abs(parseFloat(p.valor))) %></div>
                <form method="post" action="/lancamentos/<%= p.id %>/marcar-pago" data-ajax>
                    <%- csrfCampo %>
                    <input type="hidden" name="voltar" value="<%= currentUrl %>">
                    <input type="hidden" name="status" value="pago">
                    <button type="submit" class="btn-pagar"><i class="ph ph-check-circle"></i><span><%= p.tipo === 'receita' ? t('acao.receber') : t('acao.pagar') %></span></button>
                </form>
            </div>
        <% }) %>
    </div>
</section>
<% } %>

<div class="painel-resumo">
<!-- Comparativo: periodo anterior x atual (fixos/variaveis) -->
<%
const cmp = comparativo;
const rotAnt = periodo.customizado ? formatDate(cmp.periodoAnt.inicio, 'DD/MM') + ' - ' + formatDate(cmp.periodoAnt.fim, 'DD/MM') : nomesMeses[periodo.mes_anterior];
const rotAtual = periodo.customizado ? formatDate(periodo.inicio, 'DD/MM') + ' - ' + formatDate(periodo.fim, 'DD/MM') : nomesMeses[periodo.mes];
// bomSobe: true quando aumentar e bom (receitas e saldo); false para despesas
const linhasCmp = [
    { k: 'receita_fixa', bomSobe: true }, { k: 'receita_variavel', bomSobe: true },
    { k: 'despesa_fixa', bomSobe: false }, { k: 'despesa_variavel', bomSobe: false },
    { k: 'saldo_total', bomSobe: true, total: true }
];
%>
<details class="card comp-card recolhivel">
    <summary class="recolhivel__titulo"><span><%= t('painel.comp.titulo') %></span><small><%= t('painel.abrir') %></small></summary>
    <div class="comp-grid comp-grid--cab">
        <span></span>
        <span class="comp-col"><%= rotAnt %></span>
        <span class="comp-col"><%= rotAtual %></span>
        <span class="comp-col comp-col--var"><%= t('painel.comp.variacao') %></span>
    </div>
    <% linhasCmp.forEach(l => {
        const ant = cmp.anterior[l.k], atu = cmp.atual[l.k];
        const dif = atu - ant;
        const sem = Math.abs(dif) < 0.005;
        const sobe = dif > 0;
        const bom = sobe === l.bomSobe;
        const pct = ant !== 0 ? Math.abs(dif) / Math.abs(ant) * 100 : null;
        const cor = sem ? 'var(--muted)' : (bom ? 'var(--green)' : 'var(--red)');
    %>
    <div class="comp-grid comp-linha<%= l.total ? ' comp-linha--total' : '' %>">
        <span class="comp-rotulo"><%= t('painel.comp.' + l.k) %></span>
        <span class="comp-col" data-saldo-oculta><%= moeda(ant) %></span>
        <span class="comp-col comp-col--atual" data-saldo-oculta><%= moeda(atu) %></span>
        <span class="comp-col comp-col--var" style="color: <%= cor %>;">
            <% if (sem) { %>
                <i class="ph ph-minus"></i> <span><%= t('painel.comp.sem_variacao') %></span>
            <% } else { %>
                <i class="ph <%= sobe ? 'ph-arrow-up' : 'ph-arrow-down' %>"></i>
                <span><span data-saldo-oculta><%= sobe ? '+' : '-' %><%= moeda(Math.abs(dif)) %></span><small> <%= pct !== null ? '(' + (sobe ? '+' : '-') + pct.toFixed(1).replace('.', ',') + '%)' : '(' + t('painel.comp.novo') + ')' %></small></span>
            <% } %>
        </span>
    </div>
    <% }) %>
</details>

<% if (despesasPorCategoria && despesasPorCategoria.length > 0) { %>
<details class="card grafico-card recolhivel" id="det-despesas-painel" style="margin-bottom: 16px;">
    <summary class="recolhivel__titulo"><span><span class="grafico-card__marca" style="background: var(--red);"></span><%= t('relatorios.grafico_despesas_titulo') %></span><small><%= t('painel.abrir') %></small></summary>
    <div class="grafico-card__corpo grafico-card__corpo--rosca">
        <div class="grafico-card__canvas-wrap"><canvas id="chartDespesasPainel"></canvas></div>
        <ul class="gf-leg" id="legDespesasPainel"></ul>
    </div>
</details>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
<script src="/assets/js/charts.js?v=<%= assetVersion %>"></script>
<script>
(function () {
    var dados = <%- jsonScript(despesasPorCategoria) %>;
    var det = document.getElementById('det-despesas-painel');
    var feito = false;
    function desenhar() {
        if (feito || !det.open || !window.Chart || !window.GFCharts) return;
        feito = true;
        GFCharts.rosca('chartDespesasPainel', 'legDespesasPainel', dados, { rotulo: (window.GF_T || {}).despesas || 'Despesas' });
    }
    det.addEventListener('toggle', function () { if (window.Chart && window.GFCharts) desenhar(); else window.addEventListener('load', desenhar); });
})();
</script>
<% } %>

</div>

<%- include('../partials/lista_lancamentos') %>

<!-- Modal Periodo personalizado: de / ate + atalhos -->
<div class="modal-backdrop" id="modal-periodo">
    <div class="modal card">
        <div class="modal__header">
            <h3><%= t('painel.periodo_personalizado') %></h3>
            <button type="button" class="modal__close" data-modal-close>&times;</button>
        </div>
        <div class="periodo-atalhos">
            <a class="btn btn-outline btn-sm" href="/?data_inicio=<%= data7Dias %>&data_fim=<%= dataHoje %>"><%= t('painel.preset_7') %></a>
            <a class="btn btn-outline btn-sm" href="/?data_inicio=<%= _ymd(_ultimos30) %>&data_fim=<%= dataHoje %>"><%= t('painel.preset_30') %></a>
            <a class="btn btn-outline btn-sm" href="/?mes=<%= _mesPassado.getMonth() + 1 %>&ano=<%= _mesPassado.getFullYear() %>"><%= t('painel.preset_mes_passado') %></a>
            <a class="btn btn-outline btn-sm" href="<%= _linkAno(_hoje.getFullYear() - 1) %>"><%= t('painel.preset_ano_passado') %></a>
        </div>
        <form method="get" action="/" class="form" id="form-periodo">
            <div class="form-row">
                <div class="form-group">
                    <label for="periodo-de"><%= t('painel.periodo_de') %></label>
                    <input class="input" type="date" id="periodo-de" name="data_inicio" value="<%= periodo.inicio %>" required>
                </div>
                <div class="form-group">
                    <label for="periodo-ate"><%= t('painel.periodo_ate') %></label>
                    <input class="input" type="date" id="periodo-ate" name="data_fim" value="<%= periodo.fim %>" min="<%= periodo.inicio %>" required>
                </div>
            </div>
            <p class="form-help" id="periodo-erro" style="color: var(--red);" hidden><%= t('painel.periodo_invalido') %></p>
            <div class="modal__actions">
                <button type="button" class="btn btn-outline" data-modal-close><%= t('modal.cancelar') %></button>
                <button type="submit" class="btn btn-primary"><%= t('painel.aplicar_periodo') %></button>
            </div>
        </form>
        <script>
        (function () {
            var de = document.getElementById('periodo-de');
            var ate = document.getElementById('periodo-ate');
            var erro = document.getElementById('periodo-erro');
            var form = document.getElementById('form-periodo');
            // A data final nunca pode ficar antes da inicial: se a inicial passar dela, a final acompanha.
            de.addEventListener('change', function () {
                ate.min = de.value;
                if (ate.value && ate.value < de.value) ate.value = de.value;
                erro.hidden = true;
            });
            form.addEventListener('submit', function (e) {
                if (!de.value || !ate.value || ate.value < de.value) { e.preventDefault(); erro.hidden = false; }
            });
        })();
        </script>
    </div>
</div>

<!-- Modal Filtro Avançado por Categoria/Subcategoria -->
<div class="modal-backdrop" id="modal-filtro-avancado">
    <div class="modal card">
        <div class="modal__header">
            <h3><%= t('painel.filtrar_titulo') %></h3>
            <button type="button" class="modal__close" data-modal-close>&times;</button>
        </div>
        <form method="get" action="/" class="form">
            <input type="hidden" name="tipo" value="<%= filtros.tipo %>">
            <input type="hidden" name="agrupar" value="<%= agrupamento %>">
            <input type="hidden" name="ordenar" value="<%= ordenacao %>">

            <div class="form-group">
                <label><%= t('painel.buscar_desc_label') %></label>
                <input class="input" type="text" name="busca" value="<%= filtros.busca %>" placeholder="<%= t('painel.filtro.buscar_placeholder') %>">
            </div>

            <div class="form-group">
                <label><%= t('comum.categoria') %></label>
                <select class="input" name="categoria_id" id="filtro-categoria-select">
                    <option value=""><%= t('painel.todas_categorias') %></option>
                    <% categoriasArvore.forEach(c => { %>
                        <option value="<%= c.id %>" <%= filtros.categoria_id == c.id ? 'selected' : '' %>><%= c.nome %></option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label><%= t('comum.subcategoria') %></label>
                <select class="input" name="subcategoria_id" id="filtro-subcategoria-select">
                    <option value=""><%= t('painel.todas_subcategorias') %></option>
                    <% categoriasArvore.forEach(c => { %>
                        <% (c.subcategorias || []).forEach(sub => { %>
                            <option value="<%= sub.id %>" <%= filtros.subcategoria_id == sub.id ? 'selected' : '' %>><%= c.nome %> / <%= sub.nome %></option>
                        <% }) %>
                    <% }) %>
                </select>
            </div>

            <div class="modal__actions">
                <button type="button" class="btn btn-outline" data-modal-close><%= t('modal.cancelar') %></button>
                <button type="submit" class="btn btn-primary"><%= t('painel.aplicar_filtros') %></button>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/modais_excluir_serie', { lancamentos }) %>

<%- include('../partials/modais_lancamento', { dataHoje, voltar: currentUrl }) %>
<% } %>
