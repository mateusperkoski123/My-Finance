                    <div style="border: 1px solid var(--border); border-radius: 14px; padding: 12px 16px; background: var(--bg);">
                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                            <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--card); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center;">
                                <i class="ph ph-calendar-blank" style="font-size: 18px; color: var(--muted);"></i>
                            </div>
                            <div>
                                <strong style="font-size: 13px; display: block;"><%= t('modal.data_competencia') %></strong>
                            </div>
                        </div>
                        <input class="input" type="date" id="novo-receita-data" name="data_competencia" value="<%= dataHoje %>" required style="border-radius: 10px; padding: 8px 12px; font-size: 13px;">
                    </div>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 8px;">
                <button type="submit" class="btn" style="background: var(--green); color: var(--on-accent); border: none; border-radius: 12px; padding: 12px; font-size: 14px; font-weight: 700; width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;">
                    <i class="ph ph-floppy-disk" style="font-size: 18px;"></i> <%= t('painel.salvar_receita') %>
                </button>
                <button type="button" class="btn btn-outline" data-modal-close style="border-radius: 12px; padding: 10px; font-size: 13.5px; font-weight: 600; width: 100%;">
                    <%= t('modal.cancelar') %>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Nova Despesa -->
<div class="modal-backdrop" id="modal-novo-despesa" data-modal style="background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(4px);">
    <div class="modal card" style="max-width: 520px; border-radius: 20px; padding: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.15); border: 1px solid var(--border);">
        <div class="modal__header" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--red-bg); display: flex; align-items: center; justify-content: center;">
                    <i class="ph ph-trend-down" style="color: var(--red); font-size: 20px;"></i>
                </div>
                <h2 style="font-size: 18px; font-weight: 700; margin: 0;"><%= t('painel.add_despesa') %></h2>
            </div>
            <button type="button" class="modal__fechar" data-modal-close aria-label="<%= t('comum.fechar') %>" style="background: none; border: none; font-size: 18px; cursor: pointer; color: var(--muted);"><i class="ph ph-x"></i></button>
        </div>

        <form method="post" action="/lancamentos" class="form" style="display: flex; flex-direction: column; gap: 16px;">
            <%- csrfCampo %>
            <input type="hidden" name="tipo" value="despesa">

            <div>
                <h4 style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); font-weight: 700; margin-bottom: 12px;"><%= t('modal.inf_basicas') %></h4>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label for="novo-despesa-descricao" style="font-size: 13px; font-weight: 600; margin-bottom: 4px; display: block;"><%= t('modal.descricao') %></label>
                    <input class="input" type="text" id="novo-despesa-descricao" name="descricao" placeholder="<%= t('painel.ph_despesa') %>" style="border-radius: 12px; padding: 10px 14px; font-size: 13.5px;" required>
                </div>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label for="novo-despesa-valor" style="font-size: 13px; font-weight: 600; margin-bottom: 4px; display: block;"><%= t('modal.valor') %></label>
                    <input class="input" type="text" id="novo-despesa-valor" name="valor" data-money inputmode="decimal" placeholder="0" style="border-radius: 12px; padding: 10px 14px; font-size: 16px; font-weight: 700;" required>
                </div>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label for="novo-despesa-categoria" style="font-size: 13px; font-weight: 600; margin-bottom: 4px; display: block;"><%= t('comum.categoria') %> *</label>
                    <select class="input" id="novo-despesa-categoria" name="categoria_id" data-gf-categoria-select data-subcategoria-atual="" required style="border-radius: 12px; padding: 10px 14px; font-size: 13.5px;">
                        <option value=""><%= t('modal.escolha_cat') %></option>
                        <% (categoriasArvore || []).filter(cat => !cat.sistema).forEach(cat => { %>
                            <option value="<%= cat.id %>"><%= cat.nome %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label for="novo-despesa-subcategoria" style="font-size: 13px; font-weight: 600; margin-bottom: 4px; display: block;"><%= t('comum.subcategoria') %></label>
                    <select class="input" id="novo-despesa-subcategoria" name="subcategoria_id" data-gf-subcategoria-select disabled style="border-radius: 12px; padding: 10px 14px; font-size: 13.5px;">
                        <option value=""><%= t('modal.sel_cat_primeiro') %></option>
                    </select>
                </div>
            </div>

            <div>
                <h4 style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); font-weight: 700; margin-bottom: 12px;"><%= t('modal.config_transacao') %></h4>

                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <div style="border: 1px solid var(--border); border-radius: 14px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; background: var(--bg);">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--red-bg); display: flex; align-items: center; justify-content: center;" data-status-icon-box>
                                <i class="ph ph-trend-down" style="font-size: 18px; color: var(--red);" data-status-icon></i>
                            </div>
                            <div>
                                <strong style="font-size: 13px; display: block;" data-status-title><%= t('modal.nao_foi_pago') %></strong>
                                <span style="font-size: 11px; color: var(--muted);"><%= t('painel.status_pagamento') %></span>
                            </div>
                        </div>
                        <label class="toggle" style="margin: 0;">
                            <input type="checkbox" name="foi_pago" value="1" data-gf-status-toggle data-tipo="despesa">
                            <span class="toggle__track"><span class="toggle__thumb"></span></span>
                        </label>
                    </div>

                    <div style="border: 1px solid var(--border); border-radius: 14px; padding: 12px 16px; background: var(--bg);">
                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                            <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--card); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center;">
                                <i class="ph ph-calendar" style="font-size: 18px; color: var(--muted);"></i>
                            </div>
                            <div>
                                <strong style="font-size: 13px; display: block;" data-status-date-label><%= t('modal.data_vencimento') %></strong>
                            </div>
                        </div>
                        <input class="input" type="date" id="novo-despesa-data-pagamento" name="data_pagamento" value="<%= dataHoje %>" style="border-radius: 10px; padding: 8px 12px; font-size: 13px;">
                    </div>

                    <div style="border: 1px solid var(--border); border-radius: 14px; padding: 12px 16px; background: var(--bg);">
                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                            <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--card); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center;">
                                <i class="ph ph-bank" style="font-size: 18px; color: var(--muted);"></i>
                            </div>
                            <div>
                                <strong style="font-size: 13px; display: block;"><%= t('modal.conta') %></strong>
                            </div>
                        </div>
                        <select class="input" id="novo-despesa-conta" name="conta_id" required style="border-radius: 10px; padding: 8px 12px; font-size: 13px;">
                            <% (contas || []).forEach(c => { %>
                                <option value="<%= c.id %>"><%= c.nome %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div style="border: 1px solid var(--border); border-radius: 14px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; background: var(--bg);">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--card); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center;">
                                <i class="ph ph-push-pin" style="font-size: 18px; color: var(--muted);"></i>
                            </div>
                            <div>
                                <strong style="font-size: 13px; display: block;"><%= t('modal.despesa_fixa') %></strong>
                            </div>
                        </div>
                        <label class="toggle" style="margin: 0;">
                            <input type="checkbox" name="e_fixo" value="1">
                            <span class="toggle__track"><span class="toggle__thumb"></span></span>
                        </label>
                    </div>

                    <div style="border: 1px solid var(--border); border-radius: 14px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; background: var(--bg);">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--card); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center;">
                                <i class="ph ph-arrows-clockwise" style="font-size: 18px; color: var(--muted);"></i>
                            </div>
                            <div>
                                <strong style="font-size: 13px; display: block;"><%= t('modal.repetir') %></strong>
                            </div>
                        </div>
                        <label class="toggle" style="margin: 0;">
                            <input type="checkbox" name="repetir" value="1" data-gf-toggle-repetir>
                            <span class="toggle__track"><span class="toggle__thumb"></span></span>
                        </label>
                    </div>

                    <div class="form-group" data-gf-repetir-alvo hidden style="padding: 10px 14px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg);">
                        <label for="novo-despesa-quantidade-repeticoes" style="font-size: 12px; font-weight: 600;"><%= t('modal.qtd_repeticoes') %></label>
                        <input class="input" type="number" id="novo-despesa-quantidade-repeticoes" name="quantidade_repeticoes" min="2" max="60" value="12" style="border-radius: 8px; padding: 6px 10px; font-size: 13px;">
                    </div>

                    <div style="border: 1px solid var(--border); border-radius: 14px; padding: 12px 16px; background: var(--bg);">
                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                            <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--card); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center;">
                                <i class="ph ph-calendar-blank" style="font-size: 18px; color: var(--muted);"></i>
                            </div>
                            <div>
                                <strong style="font-size: 13px; display: block;"><%= t('modal.data_competencia') %></strong>
                            </div>
                        </div>
                        <input class="input" type="date" id="novo-despesa-data" name="data_competencia" value="<%= dataHoje %>" required style="border-radius: 10px; padding: 8px 12px; font-size: 13px;">
                    </div>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 8px;">
                <button type="submit" class="btn" style="background: var(--red); color: var(--on-accent); border: none; border-radius: 12px; padding: 12px; font-size: 14px; font-weight: 700; width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;">
                    <i class="ph ph-floppy-disk" style="font-size: 18px;"></i> <%= t('painel.salvar_despesa') %>
                </button>
                <button type="button" class="btn btn-outline" data-modal-close style="border-radius: 12px; padding: 10px; font-size: 13.5px; font-weight: 600; width: 100%;">
                    <%= t('modal.cancelar') %>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
window.gfCategoriasArvore = <%- JSON.stringify(categoriasArvore || []) %>;
</script>

<% } %>

<% if (contas && contas.length > 0) { %>
<!-- Botao flutuante (celular) -->
<div class="fab" id="fab">
    <div class="fab__menu">
        <button type="button" class="fab__item fab__item--receita" data-modal-open="modal-novo-receita" onclick="document.getElementById('fab').classList.remove('is-open')"><i class="ph ph-arrow-circle-up"></i> <%= t('painel.nova_receita') %></button>
        <button type="button" class="fab__item fab__item--despesa" data-modal-open="modal-novo-despesa" onclick="document.getElementById('fab').classList.remove('is-open')"><i class="ph ph-arrow-circle-down"></i> <%= t('painel.nova_despesa') %></button>
    </div>
    <button type="button" class="fab__botao" aria-label="<%= t('painel.novo_lancamento') %>" onclick="document.getElementById('fab').classList.toggle('is-open')"><i class="ph ph-plus"></i></button>
</div>
<div class="fab-fundo" onclick="document.getElementById('fab').classList.remove('is-open')"></div>
<% } %>
