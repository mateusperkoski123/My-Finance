

<%
const dataHoje = formatDate(hojeLocal());
const data7DiasDate = hojeLocal(); data7DiasDate.setDate(data7DiasDate.getDate() - 7);
const data7Dias = formatDate(data7DiasDate);
const dataAnoInicio = hojeLocal().getFullYear() + '-01-01';
const dataAnoFim = hojeLocal().getFullYear() + '-12-31';

const e7Dias = periodo.customizado && periodo.inicio === data7Dias && periodo.fim === dataHoje;
const eAno = periodo.customizado && periodo.inicio === dataAnoInicio && periodo.fim === dataAnoFim;
const eMes = !periodo.customizado && periodo.e_mes_atual;
const eHoje = periodo.customizado && periodo.inicio === dataHoje && periodo.fim === dataHoje;

const nomesMeses = {
    1: t('painel.mes.1'), 2: t('painel.mes.2'), 3: t('painel.mes.3'), 4: t('painel.mes.4'),
    5: t('painel.mes.5'), 6: t('painel.mes.6'), 7: t('painel.mes.7'), 8: t('painel.mes.8'),
    9: t('painel.mes.9'), 10: t('painel.mes.10'), 11: t('painel.mes.11'), 12: t('painel.mes.12')
};
%>

<div class="myfinance-top-controls card" data-periodo-ini="<%= periodo.inicio %>" data-periodo-fim="<%= periodo.fim %>" style="margin-bottom: 20px; padding: 14px 16px;">
    <!-- Top row: Month navigator & Period Badge -->
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 12px;">
        <div style="display: flex; align-items: center; gap: 8px; flex: 1; min-width: 220px; justify-content: space-between; background: var(--bg); padding: 8px 12px; border-radius: 12px; border: 1px solid var(--border);">
            <a class="btn btn-outline btn-sm" href="/?mes=<%= periodo.mes_anterior %>&ano=<%= periodo.ano_anterior %>" style="border-radius: 8px;"><i class="ph ph-caret-left"></i></a>
            <div style="text-align: center;">
                <strong style="font-size: 15px; font-weight: 700; display: block; color: var(--text);"><%= nomesMeses[periodo.mes] %> <%= periodo.ano %></strong>
                <span class="muted" style="font-size: 12px; font-weight: 500;"><%= formatDate(periodo.inicio, 'DD/MM/YYYY') %> - <%= formatDate(periodo.fim, 'DD/MM/YYYY') %></span>
            </div>
            <a class="btn btn-outline btn-sm" href="/?mes=<%= periodo.mes_proximo %>&ano=<%= periodo.ano_proximo %>" style="border-radius: 8px;"><i class="ph ph-caret-right"></i></a>
        </div>

        <div style="display: flex; gap: 6px; flex-wrap: wrap; align-items: center;">
            <a href="/?data_inicio=<%= dataHoje %>&data_fim=<%= dataHoje %>" class="btn <%= eHoje ? 'btn-primary' : 'btn-outline' %> btn-sm" style="border-radius: 20px;"><%= t('painel.hoje') %></a>
            <a href="/?mes=<%= hojeLocal().getMonth() + 1 %>&ano=<%= hojeLocal().getFullYear() %>" class="btn <%= eMes ? 'btn-primary' : 'btn-outline' %> btn-sm" style="border-radius: 20px;"><%= t('filtro.mes_atual') %></a>
            <%# O filtro so existe quando ha contas (o formulario dele fica mais abaixo, junto com a lista). %>
            <% if (contas && contas.length > 0) { %>
            <button type="button" class="btn btn-outline btn-sm" data-modal-open="modal-filtro-avancado" style="border-radius: 20px;"><i class="ph ph-sliders-horizontal"></i> <%= t('filtro.filtrar') %></button>
            <% } %>
        </div>
    </div>
</div>

<% if (!contas || contas.length === 0) { %>
    <div class="card boas-vindas">
        <h2><%= t('painel.bv_titulo') %></h2>
        <p class="muted" style="margin: 0;"><%= t('painel.bv_sub') %></p>
        <ol>
            <li><b>1</b><span><%- t('painel.bv_passo1') %></span></li>
            <li><b>2</b><span><%- t('painel.bv_passo2') %></span></li>
            <li><b>3</b><span><%- t('painel.bv_passo3') %></span></li>
        </ol>
        <a href="/contas" class="btn btn-primary"><%= t('painel.ir_para_contas') %></a>
    </div>
<% } else { %>

<% const _temPend = Boolean(pendenciasUrgentes && pendenciasUrgentes.total > 0); %>
<%# Duas colunas no computador: saldo, resumo do mes e botoes a esquerda; o que vence agora a direita (sem rolar para achar). %>
<div class="painel-grid<%= _temPend ? '' : ' painel-grid--uma' %>">
<div class="painel-grid__esq">
<!-- Card Principal: Saldo Disponível -->
<div class="card resumo-card" style="border-radius: 20px; padding: 22px 24px; margin-bottom: 16px; background: var(--card); border: 1px solid var(--border); box-shadow: var(--shadow);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span class="muted" style="font-size: 14px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
            <%= t('painel.saldo_disponivel') %>
            <button type="button" id="btn-ocultar-saldo" class="btn-olho" aria-label="<%= t('painel.ocultar_saldo') %>" title="<%= t('painel.ocultar_saldo') %>" aria-pressed="false"><i class="ph ph-eye"></i></button>
        </span>
        <span style="font-size: 12px; background: var(--bg); padding: 4px 10px; border-radius: 12px; font-weight: 600; color: var(--muted); border: 1px solid var(--border);"><%= t('contas.total_consolidado') %></span>
    </div>
    <div data-saldo-oculta style="font-size: 32px; font-weight: 800; color: <%= resumo.saldo_disponivel >= 0 ? 'var(--green)' : 'var(--red)' %>;">
        <%= moeda(resumo.saldo_disponivel) %>
    </div>
    <% if (Math.abs(resumo.saldo_previsto - resumo.saldo_disponivel) > 0.5) { %>
    <div style="display: flex; justify-content: space-between; font-size: 13px; margin-top: 14px; border-top: 1px solid var(--border); padding-top: 10px;">
        <span class="muted"><%= t('painel.saldo_previsto_apos') %></span>
        <strong data-saldo-oculta style="color: var(--text); font-weight: 700;"><%= moeda(resumo.saldo_previsto) %></strong>
    </div>
    <% } %>
</div>
<%# Resumo do mes: so o que ja foi recebido e pago no periodo (o que falta aparece em "Saldo previsto"). %>
<% const _entrou = Number(resumo.receitas_recebidas) || 0, _saiu = Number(resumo.despesas_pagas) || 0, _sobrou = _entrou - _saiu; %>
<div class="painel-tres" title="<%= t('painel.resumo_dica') %>">
    <div><small><%= t('painel.entrou') %></small><b class="verde" data-saldo-oculta><%= moeda(_entrou) %></b></div>
    <div><small><%= t('painel.saiu') %></small><b class="vermelho" data-saldo-oculta><%= moeda(_saiu) %></b></div>
    <div><small><%= t('painel.sobrou') %></small><b style="color: <%= _sobrou >= 0 ? 'var(--green)' : 'var(--red)' %>;" data-saldo-oculta><%= (_sobrou < 0 ? '-' : '') + moeda(Math.abs(_sobrou)) %></b></div>
</div>
<%# Botoes de acao logo abaixo do saldo: no computador ficam a vista sem rolar a pagina (no celular o botao flutuante "+" faz esse papel). %>
<div class="myfinance-action-buttons">
    <button type="button" class="btn btn-acao btn-acao--receita" data-modal-open="modal-novo-receita"><i class="ph ph-plus-circle"></i> <%= t('painel.nova_receita') %></button>
    <button type="button" class="btn btn-acao btn-acao--despesa" data-modal-open="modal-novo-despesa"><i class="ph ph-minus-circle"></i> <%= t('painel.nova_despesa') %></button>
</div>
</div>
<script>
// Ocultar/mostrar os valores. Alem do carregamento, roda quando a pagina troca o conteudo sem recarregar
// (depois de pagar ou salvar um lancamento): os valores precisam continuar ocultos.
(function () {
    function iniciar() {
        var btn = document.getElementById('btn-ocultar-saldo');
        if (!btn) return;
        var els = document.querySelectorAll('[data-saldo-oculta]');
        els.forEach(function (el) { el.setAttribute('data-original', el.textContent.trim()); });
        function aplicar(oculto) {
            els.forEach(function (el) { el.textContent = oculto ? '••••••' : el.getAttribute('data-original'); });
            btn.firstElementChild.className = oculto ? 'ph ph-eye-slash' : 'ph ph-eye';
            btn.setAttribute('aria-pressed', oculto ? 'true' : 'false');
        }
        var oculto = false;
        try { oculto = localStorage.getItem('gf_saldo_oculto') === '1'; } catch (e) {}
        aplicar(oculto);
        btn.addEventListener('click', function () {
            oculto = !oculto;
            try { localStorage.setItem('gf_saldo_oculto', oculto ? '1' : '0'); } catch (e) {}
            aplicar(oculto);
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', iniciar); else iniciar();
})();
</script>

<% if (_temPend) { %>
<div class="painel-grid__dir">
<!-- Pendencias vencidas ou que vencem hoje -->
<section class="card pendencias" aria-label="<%= t('painel.pendencias') %>">
    <div class="pendencias__topo">
        <span class="pendencias__titulo"><i class="ph ph-warning-circle" style="color: var(--pendente); font-size: 18px;"></i> <%= t('painel.vencidas_hoje', { n: pendenciasUrgentes.total }) %></span>
        <a href="/relatorios?aba=pendentes" class="muted" style="font-size: 13px; font-weight: 600;"><%= t('painel.ver_todas') %></a>
    </div>
    <div class="pendencias__lista">
        <% pendenciasUrgentes.itens.forEach(p => { const dias = parseInt(p.dias_atraso, 10) || 0; %>
            <div class="pendencias__item">
                <div class="pendencias__info">
                    <div class="pendencias__desc"><%= p.descricao %></div>
                    <div class="pendencias__meta"><%= p.conta_nome %> · <%= formatDate(p.data_competencia, 'DD/MM/YYYY') %> ·
                        <% if (dias > 0) { %><span class="atraso"><%= t(dias > 1 ? 'painel.dias_atraso' : 'painel.dia_atraso', { n: dias }) %></span><% } else { %><%= t('painel.vence_hoje') %><% } %>
                    </div>
                </div>
                <div class="pendencias__valor" style="color: <%= p.tipo === 'receita' ? 'var(--green)' : 'var(--red)' %>;"><%= p.tipo === 'receita' ? '+' : '-' %> <%= moeda(Math.abs(parseFloat(p.valor))) %></div>
                <form method="post" action="/lancamentos/<%= p.id %>/marcar-pago" data-ajax>
                    <%- csrfCampo %>
                    <input type="hidden" name="voltar" value="<%= currentUrl %>">
                    <input type="hidden" name="status" value="pago">
                    <button type="submit" class="btn-pagar"><i class="ph ph-check-circle"></i><span><%= p.tipo === 'receita' ? t('acao.receber') : t('acao.pagar') %></span></button>
                </form>
            </div>
        <% }) %>
    </div>
</section>
</div>
<% } %>
</div>

<div class="painel-resumo">
<!-- Comparativo: periodo anterior x atual (fixos/variaveis) -->
<%
const cmp = comparativo;
const rotAnt = periodo.customizado ? formatDate(cmp.periodoAnt.inicio, 'DD/MM') + ' - ' + formatDate(cmp.periodoAnt.fim, 'DD/MM') : nomesMeses[periodo.mes_anterior];
const rotAtual = periodo.customizado ? formatDate(periodo.inicio, 'DD/MM') + ' - ' + formatDate(periodo.fim, 'DD/MM') : nomesMeses[periodo.mes];
// bomSobe: true quando aumentar e bom (receitas e saldo); false para despesas
const linhasCmp = [
    { k: 'receita_fixa', bomSobe: true }, { k: 'receita_variavel', bomSobe: true },
    { k: 'despesa_fixa', bomSobe: false }, { k: 'despesa_variavel', bomSobe: false },
    { k: 'saldo_total', bomSobe: true, total: true }
];
%>
<details class="card comp-card recolhivel">
    <summary class="recolhivel__titulo"><span><%= t('painel.comp.titulo') %></span><small><%= t('painel.abrir') %></small></summary>
    <div class="comp-grid comp-grid--cab">
        <span></span>
        <span class="comp-col"><%= rotAnt %></span>
        <span class="comp-col"><%= rotAtual %></span>
        <span class="comp-col comp-col--var"><%= t('painel.comp.variacao') %></span>
    </div>
    <% linhasCmp.forEach(l => {
        const ant = cmp.anterior[l.k], atu = cmp.atual[l.k];
        const dif = atu - ant;
        const sem = Math.abs(dif) < 0.005;
        const sobe = dif > 0;
        const bom = sobe === l.bomSobe;
        const pct = ant !== 0 ? Math.abs(dif) / Math.abs(ant) * 100 : null;
        const cor = sem ? 'var(--muted)' : (bom ? 'var(--green)' : 'var(--red)');
    %>
    <div class="comp-grid comp-linha<%= l.total ? ' comp-linha--total' : '' %>">
        <span class="comp-rotulo"><%= t('painel.comp.' + l.k) %></span>
        <span class="comp-col" data-saldo-oculta><%= moeda(ant) %></span>
        <span class="comp-col comp-col--atual" data-saldo-oculta><%= moeda(atu) %></span>
        <span class="comp-col comp-col--var" style="color: <%= cor %>;">
            <% if (sem) { %>
                <i class="ph ph-minus"></i> <span><%= t('painel.comp.sem_variacao') %></span>
            <% } else { %>
                <i class="ph <%= sobe ? 'ph-arrow-up' : 'ph-arrow-down' %>"></i>
                <span><span data-saldo-oculta><%= sobe ? '+' : '-' %><%= moeda(Math.abs(dif)) %></span><small> <%= pct !== null ? '(' + (sobe ? '+' : '-') + pct.toFixed(1).replace('.', ',') + '%)' : '(' + t('painel.comp.novo') + ')' %></small></span>
            <% } %>
        </span>
    </div>
    <% }) %>
</details>

<% if (despesasPorCategoria && despesasPorCategoria.length > 0) { %>
<details class="card grafico-card recolhivel" id="det-despesas-painel" style="margin-bottom: 16px;">
    <summary class="recolhivel__titulo"><span><span class="grafico-card__marca" style="background: var(--red);"></span><%= t('relatorios.grafico_despesas_titulo') %></span><small><%= t('painel.abrir') %></small></summary>
    <div class="grafico-card__corpo grafico-card__corpo--rosca">
        <div class="grafico-card__canvas-wrap"><canvas id="chartDespesasPainel"></canvas></div>
        <ul class="gf-leg" id="legDespesasPainel"></ul>
    </div>
</details>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
<script src="/assets/js/charts.js?v=<%= assetVersion %>"></script>
<script>
(function () {
    var dados = <%- jsonScript(despesasPorCategoria) %>;
    var det = document.getElementById('det-despesas-painel');
    var feito = false;
    function desenhar() {
        if (feito || !det.open || !window.Chart || !window.GFCharts) return;
        feito = true;
        GFCharts.rosca('chartDespesasPainel', 'legDespesasPainel', dados, { rotulo: (window.GF_T || {}).despesas || 'Despesas' });
    }
    det.addEventListener('toggle', function () { if (window.Chart && window.GFCharts) desenhar(); else window.addEventListener('load', desenhar); });
})();
</script>
<% } %>

</div>

<%- include('../partials/lista_lancamentos') %>

<!-- Modal Filtro Avançado por Categoria/Subcategoria -->
<div class="modal-backdrop" id="modal-filtro-avancado">
    <div class="modal card">
        <div class="modal__header">
            <h3><%= t('painel.filtrar_titulo') %></h3>
            <button type="button" class="modal__close" data-modal-close>&times;</button>
        </div>
        <form method="get" action="/" class="form">
            <input type="hidden" name="tipo" value="<%= filtros.tipo %>">
            <input type="hidden" name="agrupar" value="<%= agrupamento %>">
            <input type="hidden" name="ordenar" value="<%= ordenacao %>">

            <div class="form-group">
                <label><%= t('painel.buscar_desc_label') %></label>
                <input class="input" type="text" name="busca" value="<%= filtros.busca %>" placeholder="<%= t('painel.filtro.buscar_placeholder') %>">
            </div>

            <div class="form-group">
                <label><%= t('comum.categoria') %></label>
                <select class="input" name="categoria_id" id="filtro-categoria-select">
                    <option value=""><%= t('painel.todas_categorias') %></option>
                    <% categoriasArvore.forEach(c => { %>
                        <option value="<%= c.id %>" <%= filtros.categoria_id == c.id ? 'selected' : '' %>><%= c.nome %></option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label><%= t('comum.subcategoria') %></label>
                <select class="input" name="subcategoria_id" id="filtro-subcategoria-select">
                    <option value=""><%= t('painel.todas_subcategorias') %></option>
                    <% categoriasArvore.forEach(c => { %>
                        <% (c.subcategorias || []).forEach(sub => { %>
                            <option value="<%= sub.id %>" <%= filtros.subcategoria_id == sub.id ? 'selected' : '' %>><%= c.nome %> / <%= sub.nome %></option>
                        <% }) %>
                    <% }) %>
                </select>
            </div>

            <div class="modal__actions">
                <button type="button" class="btn btn-outline" data-modal-close><%= t('modal.cancelar') %></button>
                <button type="submit" class="btn btn-primary"><%= t('painel.aplicar_filtros') %></button>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/modais_excluir_serie', { lancamentos }) %>

<%- include('../partials/modais_lancamento', { dataHoje, voltar: currentUrl }) %>
<% } %>
