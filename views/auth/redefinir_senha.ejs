<div class="auth-card card">
    <h1><i class="ph ph-lock-key"></i> Redefinir Senha</h1>
    <p class="muted">Digite sua nova senha de acesso abaixo.</p>

    <form method="post" action="/redefinir-senha/<%= token %>" class="form">
        <%- csrfCampo %>

        <div class="form-group">
            <label for="nova_senha">Nova Senha</label>
            <input class="input" type="password" id="nova_senha" name="nova_senha" minlength="6" required autofocus>
        </div>

        <div class="form-group">
            <label for="confirmar_nova_senha">Confirmar Nova Senha</label>
            <input class="input" type="password" id="confirmar_nova_senha" name="confirmar_nova_senha" minlength="6" required>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Salvar Nova Senha</button>
    </form>
</div>
