<%- include('_idioma') %>
<div class="auth-marca">
    <span class="auth-marca__logo"><i class="ph-fill ph-currency-circle-dollar"></i></span>
    <strong class="auth-marca__nome">MyFinance</strong>
    <span class="auth-marca__promessa"><%= t('auth.promessa') %></span>
</div>
<div class="auth-card card">
    <h1><%= t('auth.titulo_cadastro') %></h1>
    <p class="muted"><%= t('auth.cadastro.subtitulo') %></p>

    <form method="post" action="/cadastro" class="form" id="form-cadastro">
        <%- csrfCampo %>

        <div class="form-group">
            <label for="nome"><%= t('auth.nome') %></label>
            <input class="input" type="text" id="nome" name="nome" autocomplete="name" maxlength="120" required autofocus>
        </div>

        <div class="form-group">
            <label for="email"><%= t('auth.email') %></label>
            <input class="input" type="email" id="email" name="email" autocomplete="email" inputmode="email" maxlength="190" required>
        </div>

        <div class="form-group">
            <label for="idioma"><%= t('auth.idioma') %></label>
            <select class="input" id="idioma" name="idioma">
                <% Object.entries(idiomas).forEach(([codigo, rotulo]) => { %>
                    <option value="<%= codigo %>" <%= lang === codigo ? 'selected' : '' %>><%= rotulo %></option>
                <% }) %>
            </select>
            <small class="form-help"><%= t('auth.idioma_ajuda') %></small>
        </div>

        <div class="form-group">
            <label for="senha"><%= t('auth.senha') %></label>
            <input class="input" type="password" id="senha" name="senha" autocomplete="new-password" required minlength="6">
        </div>

        <div class="form-group">
            <label for="confirmar_senha"><%= t('auth.confirmar_senha') %></label>
            <input class="input" type="password" id="confirmar_senha" name="confirmar_senha" autocomplete="new-password" required minlength="6">
        </div>

        <%# Codigo de desconto (indicacao): "Aplicar" confere na hora; ao criar a conta ele fica guardado e ja vem preenchido na compra. %>
        <div class="form-group">
            <label for="codigo_desconto"><%= t('auth.codigo_desconto') %></label>
            <div class="pedido-codigo">
                <input class="input" type="text" id="codigo_desconto" name="codigo_desconto" autocomplete="off" maxlength="20" style="text-transform: uppercase;" value="<%= typeof codigoDesconto !== 'undefined' ? codigoDesconto : '' %>">
                <button type="button" class="btn btn-outline" id="codigo-aplicar" data-conferindo="<%= t('assinatura.conferindo_codigo') %>"><%= t('assinatura.aplicar_codigo') %></button>
            </div>
            <small class="form-help"><%= t('auth.codigo_desconto_dica', { pct: typeof pctDesconto !== 'undefined' ? pctDesconto : 20 }) %></small>
            <div class="pedido-desconto" id="codigo-resultado" role="status" aria-live="polite" hidden></div>
        </div>

        <label class="checkbox-linha" style="font-weight: 400; font-size: 13px; align-items: flex-start; gap: 8px;">
            <input type="checkbox" name="aceitar_termos" value="1" required style="margin-top: 3px;">
            <span><%- t('auth.aceito_termos', { termos: '<a href="/termos" target="_blank">' + t('legal.termos_titulo') + '</a>', privacidade: '<a href="/privacidade" target="_blank">' + t('legal.privacidade_titulo') + '</a>' }) %></span>
        </label>

        <button type="submit" class="btn btn-primary btn-block"><%= t('auth.criar_conta') %></button>
        <p class="muted" style="text-align: center; font-size: 13px; margin: 10px 0 0;"><i class="ph ph-gift"></i>
            <% if (typeof planoTeste !== 'undefined' && planoTeste) { %><%= t('auth.plano_escolhido', { plano: t('plano.' + planoTeste + '.nome') }) %><% } else { %><%= t('auth.trial_aviso', { dias: negocio.TRIAL_DIAS }) %><% } %></p>
    </form>

    <% if (typeof googleAtivo !== 'undefined' && googleAtivo) { %>
<div style="margin: 20px 0; text-align: center; position: relative;">
        <hr style="border: 0; border-top: 1px solid var(--border); margin: 0;">
        <span style="position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: var(--card); padding: 0 10px; font-size: 13px; color: var(--muted);"><%= t('auth.ou') %></span>
    </div>

    <a href="/auth/google" class="btn btn-outline btn-block" style="display: flex; align-items: center; justify-content: center; gap: 10px; font-weight: 500; text-decoration: none;">
        <svg width="18" height="18" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <%= t('auth.google_cadastro') %>
    </a>
<% } %>

    <p class="auth-footer" style="margin-top: 20px;">
        <%= t('auth.ja_tem_conta') %> <a href="/login"><%= t('auth.titulo_entrar') %></a>
    </p>
</div>

<script>
document.getElementById('form-cadastro')?.addEventListener('submit', function(e) {
    var senha = document.getElementById('senha')?.value || '';
    var confirmar = document.getElementById('confirmar_senha')?.value || '';
    if (senha !== confirmar) {
        e.preventDefault();
        alert(<%- JSON.stringify(t('flash.senhas_diferentes')) %>);
    }
});

// Codigo de desconto: confere no servidor e mostra o desconto (e o preco do plano escolhido na landing, se houver).
(function () {
    var campo = document.getElementById('codigo_desconto');
    var botao = document.getElementById('codigo-aplicar');
    var caixa = document.getElementById('codigo-resultado');
    if (!campo || !botao || !caixa) return;
    function limpar() { caixa.hidden = true; caixa.textContent = ''; }
    function mostrar(ok, textos) {
        caixa.className = 'pedido-desconto ' + (ok ? 'pedido-desconto--ok' : 'pedido-desconto--erro');
        caixa.textContent = '';
        textos.forEach(function (texto, i) {
            var linha = document.createElement(ok && i === textos.length - 1 && textos.length > 1 ? 'strong' : 'div');
            linha.textContent = texto;
            caixa.appendChild(linha);
        });
        caixa.hidden = false;
    }
    function aplicar() {
        if (!campo.value.trim()) { limpar(); return; }
        var rotulo = botao.textContent;
        botao.disabled = true;
        botao.textContent = botao.getAttribute('data-conferindo');
        var dados = new URLSearchParams({ _csrf: campo.form.querySelector('[name="_csrf"]').value, codigo: campo.value });
        fetch('/cadastro/codigo', { method: 'POST', body: dados, credentials: 'same-origin', headers: { 'X-Requested-With': 'fetch' } })
            .then(function (r) { if (!r.ok) throw new Error('http ' + r.status); return r.json(); })
            .then(function (j) { mostrar(j.ok, j.ok ? j.linhas : [j.mensagem]); })
            .catch(function () { mostrar(false, [(window.GF_T || {}).erro_acao || '']); })
            .then(function () { botao.disabled = false; botao.textContent = rotulo; });
    }
    botao.addEventListener('click', aplicar);
    // Enter no campo confere o codigo em vez de enviar o cadastro; mudar o codigo apaga o resultado antigo.
    campo.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); aplicar(); } });
    campo.addEventListener('input', limpar);
    // Veio por link de indicacao (?codigo=) ou voltou para a tela: ja mostra o desconto.
    if (campo.value.trim()) aplicar();
})();
</script>
