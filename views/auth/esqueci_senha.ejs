<div class="auth-card card">
    <h1>🔑 Recuperar Senha</h1>
    <p class="muted">Digite seu e-mail cadastrado. Enviaremos um link mágico para você redefinir sua senha.</p>

    <form method="post" action="/esqueci-senha" class="form">
        <%- csrfCampo %>

        <div class="form-group">
            <label for="email">E-mail Cadastrado</label>
            <input class="input" type="email" id="email" name="email" placeholder="seu@email.com" required autofocus>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Enviar Magic Link de Recuperação</button>
    </form>

    <p class="auth-footer" style="text-align: center; margin-top: 16px;">
        <a href="/login">← Voltar para o Login</a>
    </p>
</div>
