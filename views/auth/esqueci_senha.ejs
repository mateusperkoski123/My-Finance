<div class="auth-card card">
    <h1><i class="ph ph-key"></i> <%= t('auth.recuperar_titulo') %></h1>
    <p class="muted"><%= t('auth.recuperar_texto') %></p>

    <form method="post" action="/esqueci-senha" class="form">
        <%- csrfCampo %>

        <div class="form-group">
            <label for="email"><%= t('auth.email_cadastrado') %></label>
            <input class="input" type="email" id="email" name="email" placeholder="seu@email.com" required autofocus>
        </div>

        <button type="submit" class="btn btn-primary btn-block"><%= t('auth.enviar_link') %></button>
    </form>

    <p class="auth-footer" style="text-align: center; margin-top: 16px;">
        <a href="/login"><%= t('auth.voltar_login') %></a>
    </p>
</div>
