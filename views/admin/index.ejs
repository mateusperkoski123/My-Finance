<%
const m = metricas;
const nomePlano = (c) => t('plano.' + c + '.nome');
const corStatus = { beta: 'badge-sucesso', trial: 'badge-sucesso', ativa: 'badge-sucesso', vencida: 'badge-pendente', cancelada: 'badge-pendente', sem: 'badge-neutro' };
%>
<div class="page-header">
    <h1><i class="ph ph-shield-star"></i> <%= t('admin.titulo') %></h1>
    <p class="muted"><%= t('admin.subtitulo') %></p>
    <a class="btn btn-outline btn-sm" href="/admin/ia"><i class="ph ph-chart-bar"></i> <%= t('admin.ia_consumo_link') %></a>
    <a class="btn btn-outline btn-sm" href="/admin/arquivados"><i class="ph ph-archive"></i> <%= t('admin.ver_arquivados') %> (<%= m.usuarios.arquivados %>)</a>
</div>

<div class="kpi-grid admin-kpis">
    <div class="card kpi-card"><span class="kpi-card__label"><%= t('admin.kpi_usuarios') %></span><strong class="kpi-card__valor"><%= m.usuarios.total %></strong>
        <span class="kpi-card__sub"><%= t('admin.kpi_novos', { d7: m.usuarios.novos_7d || 0, d30: m.usuarios.novos_30d || 0 }) %></span></div>
    <div class="card kpi-card"><span class="kpi-card__label"><%= t('admin.kpi_teste') %></span><strong class="kpi-card__valor"><%= (Number(m.assinaturas.beta) || 0) + (Number(m.assinaturas.trial) || 0) %></strong>
        <span class="kpi-card__sub"><%= t('admin.kpi_teste_det', { beta: m.assinaturas.beta || 0, trial: m.assinaturas.trial || 0 }) %></span></div>
    <div class="card kpi-card"><span class="kpi-card__label"><%= t('admin.kpi_pagantes') %></span><strong class="kpi-card__valor"><%= m.assinaturas.ativas || 0 %></strong>
        <span class="kpi-card__sub"><%= t('admin.kpi_pagantes_det', { vencidas: m.assinaturas.vencidas || 0, canceladas: m.assinaturas.canceladas || 0 }) %></span></div>
    <div class="card kpi-card"><span class="kpi-card__label"><%= t('admin.kpi_mrr') %></span><strong class="kpi-card__valor">Gs. <%= fmt(m.mrr) %></strong>
        <span class="kpi-card__sub"><%= t('admin.kpi_receita_mes', { valor: fmt(m.receitaMes) }) %></span></div>
</div>

<% if (Number(m.assinaturas.solicitacoes) > 0) { %>
    <div class="alert alert-aviso"><i class="ph ph-hourglass"></i> <%= t('admin.pedidos_pendentes', { n: m.assinaturas.solicitacoes }) %></div>
<% } %>

<section class="card" style="margin-top: 16px;">
    <form method="get" action="/admin" class="busca-linha" role="search" style="margin-bottom: 12px;">
        <input class="input" type="search" name="q" value="<%= busca %>" placeholder="<%= t('admin.buscar') %>">
        <select class="input" name="vence" aria-label="<%= t('admin.vence.rotulo') %>" title="<%= t('admin.vence.rotulo') %>" onchange="this.form.submit()" style="max-width: 250px;">
            <option value=""><%= t('admin.vence.todos') %></option>
            <% ['1', '3', '7', '15', 'vencido', 'sem'].forEach(v => { %><option value="<%= v %>" <%= vence === v ? 'selected' : '' %>><%= t('admin.vence.' + v) %></option><% }) %>
        </select>
        <button type="submit" class="btn btn-outline" aria-label="<%= t('categorias.buscar') %>"><i class="ph ph-magnifying-glass"></i></button>
    </form>

    <p class="muted" style="font-size: 12px; margin: 0 0 10px;"><i class="ph ph-info"></i> <%= t('admin.legenda_planos') %></p>
    <%- include('_massa', { voltar: 'admin', acoes: ['ia_on', 'ia_off', 'ia_nivel_1', 'ia_nivel_2', 'trial', 'suspender', 'reativar', 'arquivar'] }) %>

    <div class="tabela-container">
        <table class="tabela">
            <thead><tr>
                <th class="massa-col"><input type="checkbox" id="massa-todos" aria-label="<%= t('admin.massa.selecionar_todos') %>" title="<%= t('admin.massa.selecionar_todos') %>"></th>
                <th><%= t('admin.col_usuario') %></th><th><%= t('admin.col_plano') %></th><th><%= t('admin.col_vence') %></th>
                <th><%= t('admin.col_pedido') %></th><th><%= t('admin.col_acesso') %></th>
                <th><%= t('tabela.acoes') %></th>
            </tr></thead>
            <tbody>
            <% usuarios.forEach(u => {
                const venc = u.status_efetivo === 'trial' ? u.trial_fim : (u.status_efetivo === 'ativa' ? u.periodo_fim : null);
            %>
                <tr>
                    <td class="massa-col"><input type="checkbox" class="massa-sel" name="ids" value="<%= u.id %>" form="form-massa" <%= (u.role === 'admin' || u.id === usuarioLogado.id) ? 'disabled' : '' %> aria-label="<%= u.nome %>"></td>
                    <td>
                        <strong><%= u.nome %></strong>
                        <% if (u.role === 'admin') { %><span class="badge badge-neutro">admin</span><% } %>
                        <% if (u.ia_habilitada) { %><span class="badge badge-sucesso"><i class="ph ph-sparkle"></i> IA<%= u.ia_nivel === 2 ? ' 2' : '' %></span><% } %>
                        <% if (u.user_status !== 'ativo') { %><span class="badge badge-pendente"><%= t('admin.suspenso') %></span><% } %>
                        <div class="muted" style="font-size: 12px;"><%= u.email %> <% if (!u.email_verificado_em) { %>· <%= t('admin.sem_verificar') %><% } %></div>
                    </td>
                    <td>
                        <%= u.plano_codigo ? nomePlano(u.plano_codigo) : '-' %>
                        <div><span class="badge <%= corStatus[u.status_efetivo] || 'badge-neutro' %>"><%= t('assinatura.status.' + u.status_efetivo) %></span></div>
                    </td>
                    <td>
                        <% if (venc) { %>
                            <%= formatDate(venc, 'DD/MM/YYYY') %>
                            <% if (u.dias_restantes !== null && u.dias_restantes !== undefined) { %>
                                <div><span class="badge <%= u.dias_restantes <= 3 ? 'badge-alerta' : 'badge-neutro' %>"><%= t(u.dias_restantes === 1 ? 'admin.dia_restante' : 'admin.dias_restantes', { n: u.dias_restantes }) %></span></div>
                            <% } %>
                        <% } else if (u.status_efetivo === 'beta') { %><span class="muted" style="font-size: 12px;"><%= t('admin.sem_vencimento') %></span>
                        <% } else { %>-<% } %>
                    </td>
                    <td><%= u.solicitado_codigo ? nomePlano(u.solicitado_codigo) + ' (' + t('assinatura.ciclo_' + (u.ciclo_solicitado || 'mensal')) + ')' : '-' %></td>
                    <td class="muted" style="font-size: 12px; white-space: nowrap;"><%= u.ultimo_acesso ? formatDateTime(u.ultimo_acesso) : '-' %></td>
                    <td>
                        <details class="menu-acoes">
                            <summary aria-label="<%= t('acao.mais') %>"><i class="ph ph-dots-three-vertical"></i></summary>
                            <div class="menu-acoes__lista admin-acoes">
                                <form method="post" action="/admin/usuarios/<%= u.id %>/pagamento" class="admin-form">
                                    <%- csrfCampo %>
                                    <strong><%= t('admin.registrar_pagamento') %></strong>
                                    <select class="input" name="plano">
                                        <% planos.filter(p => p.codigo !== 'prueba').forEach(p => { %>
                                            <option value="<%= p.codigo %>" <%= u.solicitado_codigo === p.codigo ? 'selected' : '' %>><%= nomePlano(p.codigo) %></option>
                                        <% }) %>
                                    </select>
                                    <select class="input" name="ciclo">
                                        <option value="mensal" <%= u.ciclo_solicitado === 'mensal' ? 'selected' : '' %>><%= t('assinatura.ciclo_mensal') %></option>
                                        <option value="anual" <%= u.ciclo_solicitado === 'anual' ? 'selected' : '' %>><%= t('assinatura.ciclo_anual') %></option>
                                    </select>
                                    <input class="input" type="text" name="metodo" placeholder="<%= t('admin.metodo_ph') %>" value="transferencia">
                                    <input class="input" type="text" name="referencia" placeholder="<%= t('admin.referencia_ph') %>">
                                    <button type="submit" class="btn btn-primary btn-sm"><%= t('admin.ativar') %></button>
                                </form>
                                <form method="post" action="/admin/usuarios/<%= u.id %>/trial" class="admin-form">
                                    <%- csrfCampo %>
                                    <strong><%= t('admin.estender_teste') %></strong>
                                    <input class="input" type="number" name="dias" value="7" min="1" max="365">
                                    <button type="submit" class="btn btn-outline btn-sm"><%= t('admin.estender') %></button>
                                </form>
                                <form method="post" action="/admin/usuarios/<%= u.id %>/cancelar" data-confirm="<%= t('admin.confirmar_cancelar') %>" class="admin-form">
                                    <%- csrfCampo %>
                                    <button type="submit" class="perigo"><i class="ph ph-prohibit"></i> <%= t('admin.cancelar_assinatura') %></button>
                                </form>
                                <% if (u.id !== usuarioLogado.id) { %>
                                <form method="post" action="/admin/usuarios/<%= u.id %>/status" class="admin-form">
                                    <%- csrfCampo %>
                                    <input type="hidden" name="status" value="<%= u.user_status === 'ativo' ? 'suspenso' : 'ativo' %>">
                                    <button type="submit" class="<%= u.user_status === 'ativo' ? 'perigo' : '' %>"><i class="ph ph-user-<%= u.user_status === 'ativo' ? 'minus' : 'check' %>"></i> <%= t(u.user_status === 'ativo' ? 'admin.suspender' : 'admin.reativar') %></button>
                                </form>
                                <% if (u.role !== 'admin') { %>
                                <form method="post" action="/admin/usuarios/<%= u.id %>/ia" class="admin-form">
                                    <%- csrfCampo %>
                                    <input type="hidden" name="ia" value="<%= u.ia_habilitada ? '0' : '1' %>">
                                    <button type="submit"><i class="ph ph-sparkle"></i> <%= t(u.ia_habilitada ? 'admin.ia_desativar' : 'admin.ia_ativar') %></button>
                                </form>
                                <% if (u.ia_habilitada) { %>
                                <form method="post" action="/admin/usuarios/<%= u.id %>/ia-nivel" class="admin-form">
                                    <%- csrfCampo %>
                                    <input type="hidden" name="nivel" value="<%= u.ia_nivel === 2 ? '1' : '2' %>">
                                    <button type="submit"><i class="ph ph-sliders-horizontal"></i> <%= t(u.ia_nivel === 2 ? 'admin.ia_nivel_p1' : 'admin.ia_nivel_p2') %></button>
                                </form>
                                <% } %>
                                <form method="post" action="/admin/usuarios/<%= u.id %>/arquivar" data-confirm="<%= t('admin.confirmar_arquivar') %>" class="admin-form">
                                    <%- csrfCampo %>
                                    <button type="submit" class="perigo"><i class="ph ph-archive"></i> <%= t('admin.arquivar') %></button>
                                </form>
                                <% } %>
                                <% } %>
                            </div>
                        </details>
                    </td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
</section>
