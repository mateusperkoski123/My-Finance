<%
const _T = {
    novo: t('ia.novo_chat'), pensando: t('ia.pensando'), confirmar: t('ia.confirmar'), cancelar: t('ia.cancelar'),
    registrado: t('ia.registrado'), cancelado: t('ia.cancelado'), excluirConfirm: t('ia.confirmar_excluir'),
    despesa: t('ia.cartao_titulo_despesa'), receita: t('ia.cartao_titulo_receita'),
    conta: t('ia.cartao_conta'), categoria: t('ia.cartao_categoria'), data: t('ia.cartao_data'),
    pago: t('ia.cartao_pago'),
    plano: t('ia.plano_titulo'), confirmarTudo: t('ia.confirmar_tudo'),
    opLancDespesa: t('ia.op_lanc_despesa'), opLancReceita: t('ia.op_lanc_receita'),
    opStatusPago: t('ia.op_status_pago'), opStatusPendente: t('ia.op_status_pendente'), opEditar: t('ia.op_editar'),
    opCatCriar: t('ia.op_cat_criar'), opSubCriar: t('ia.op_sub_criar'), opCatRenomear: t('ia.op_cat_renomear'), opSubRenomear: t('ia.op_sub_renomear'),
    opTransf: t('ia.op_transf'), opTransfAgendada: t('ia.op_transf_agendada'),
    cDescricao: t('ia.campo_descricao'), cValor: t('ia.campo_valor'), cData: t('ia.campo_data'), cCategoria: t('ia.campo_categoria'), cConta: t('ia.campo_conta'),
    escApenas: t('ia.escopo_apenas_esta'), escProximas: t('ia.escopo_esta_e_proximas'), escToda: t('ia.escopo_toda_serie'),
    repFixa: t('ia.rep_fixa'), repRepetir: t('ia.rep_repetir', { n: '__N__' }), paraConta: t('ia.para_conta', { a: '__A__', b: '__B__' }), emPai: t('ia.em_pai', { pai: '__P__' }),
    anexarFoto: t('ia.anexar_foto'), tirarFoto: t('ia.tirar_foto'), gravarAudio: t('ia.gravar_audio'), pararGravacao: t('ia.parar_gravacao'),
    remover: t('ia.remover_anexo'), gravando: t('ia.gravando'), erroMic: t('ia.erro_mic'), erroMicNao: t('ia.erro_mic_nao_suportado'),
    limiteAudio: t('ia.limite_audio', { n: '__N__' }), erroFotoPreparar: t('ia.erro_foto_preparar'), erroFotoMax: t('ia.erro_foto_max', { n: '__N__' }),
    transcricao: t('ia.transcricao_rotulo'),
    reverter: t('ia.reverter'), revertido: t('ia.revertido'),
    resOk: t('ia.res_ok'), resParcial: t('ia.res_parcial'), pendente: t('ia.cartao_pendente'), erro: t('ia.erro_generico'), semConversas: t('ia.sem_conversas')
};
const _sugestoes = [t('ia.sugestao_pagar'), t('ia.sugestao_receber'), t('ia.sugestao_resumo'), t('ia.sugestao_saldos')];
%>
<div class="ia-app">
    <aside class="ia-lateral card" id="ia-lateral">
        <button type="button" class="btn btn-outline ia-novo" id="ia-novo"><i class="ph ph-plus"></i> <%= t('ia.novo_chat') %></button>
        <div class="ia-recentes-titulo"><%= t('ia.recentes') %></div>
        <div class="ia-lista" id="ia-lista">
            <% conversas.forEach(c => { %>
                <div class="ia-conversa" data-id="<%= c.id %>">
                    <button type="button" class="ia-conversa__abrir" data-abrir="<%= c.id %>"><%= c.titulo || t('ia.novo_chat') %></button>
                    <button type="button" class="ia-conversa__excluir" data-excluir="<%= c.id %>" title="<%= t('ia.excluir_conversa') %>" aria-label="<%= t('ia.excluir_conversa') %>"><i class="ph ph-trash"></i></button>
                </div>
            <% }) %>
            <% if (!conversas.length) { %><p class="muted ia-vazio" id="ia-vazio"><%= t('ia.sem_conversas') %></p><% } %>
        </div>
    </aside>

    <section class="ia-chat card">
        <% if (!configurada) { %><div class="alert alert-aviso" style="margin: 0 0 12px;"><i class="ph ph-warning"></i> <%= t('ia.nao_configurada_aviso') %></div><% } %>
        <div class="ia-mensagens" id="ia-mensagens" aria-live="polite">
            <div class="ia-boasvindas" id="ia-boasvindas">
                <i class="ph-fill ph-sparkle" style="font-size: 30px; color: var(--primary);"></i>
                <p><%= t('ia.boas_vindas') %></p>
                <div class="ia-sugestoes">
                    <% _sugestoes.forEach(s => { %><button type="button" class="ia-sugestao" data-sugestao="<%= s %>"><%= s %></button><% }) %>
                </div>
            </div>
        </div>

        <form class="ia-form" id="ia-form" autocomplete="off">
            <div class="ia-anexos" id="ia-anexos" hidden></div>
            <textarea id="ia-texto" rows="2" maxlength="600" placeholder="<%= t('ia.placeholder') %>" aria-label="<%= t('ia.placeholder') %>"></textarea>
            <div class="ia-form__rodape">
                <div class="ia-ferramentas">
                    <%# A camera direta so aparece em celular/tablet; no computador fica anexar foto e gravar audio. %>
                    <button type="button" class="ia-ico" id="ia-btn-camera" hidden title="<%= t('ia.tirar_foto') %>" aria-label="<%= t('ia.tirar_foto') %>"><i class="ph ph-camera"></i></button>
                    <button type="button" class="ia-ico" id="ia-btn-foto" title="<%= t('ia.anexar_foto') %>" aria-label="<%= t('ia.anexar_foto') %>"><i class="ph ph-image"></i></button>
                    <button type="button" class="ia-ico" id="ia-btn-audio" title="<%= t('ia.gravar_audio') %>" aria-label="<%= t('ia.gravar_audio') %>"><i class="ph ph-microphone"></i><span class="ia-ico__tempo" id="ia-tempo-audio"></span></button>
                    <span class="muted" id="ia-contador">0/600</span>
                </div>
                <button type="submit" class="btn btn-primary" id="ia-enviar" aria-label="<%= t('ia.enviar') %>"><i class="ph ph-paper-plane-tilt"></i></button>
            </div>
        </form>
        <input type="file" id="ia-in-camera" accept="image/*" capture="environment" hidden>
        <input type="file" id="ia-in-galeria" accept="image/*" multiple hidden>
        <p class="muted ia-aviso"><%= t('ia.aviso') %>
            <% if (restantes !== null) { %> · <%= t('ia.restantes', { n: restantes }) %><% } %></p>
    </section>
</div>

<script>
window.IA_T = <%- JSON.stringify(_T).replace(/</g, '\\u003c') %>;
window.IA_CFG = { moeda: <%- JSON.stringify(currency || 'PYG') %> };
</script>
<script src="/assets/js/ia.js?v=<%= Date.now() %>"></script>
