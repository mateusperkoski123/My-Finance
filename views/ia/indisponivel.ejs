<% if (typeof semPlano !== 'undefined' && semPlano) { %>
    <%# O plano atual nao inclui o Chat IA: apresenta o recurso e o plano que o inclui. %>
    <%- include('../partials/recurso_bloqueado', { recurso: 'ia', plano: 'premium', icone: 'ph-sparkle' }) %>
<% } else { %>
<div class="auth-card card" style="max-width: 480px; margin: 40px auto; text-align: center;">
    <i class="ph-fill ph-sparkle" style="font-size: 36px; color: var(--primary);"></i>
    <h1 style="font-size: 20px;"><%= t('ia.indisponivel_titulo') %></h1>
    <p class="muted"><%= t('ia.indisponivel_texto') %></p>
    <a class="btn btn-outline" href="/">&larr; <%= t('ia.voltar') %></a>
</div>
<% } %>
