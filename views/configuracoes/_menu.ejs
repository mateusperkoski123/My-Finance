<%# Sem teste em andamento e sem plano contratado (acessoBloqueado) so ficam abertas a Assinatura, a Conta e a saida. %>
<nav class="card settings-menu">
    <h2 class="settings-menu__titulo"><%= t('config.titulo') %></h2>
    <div class="settings-menu__lista">
        <% if (!acessoBloqueado) { %>
        <a href="/configuracoes" class="settings-menu__item <%= menuAtivo === 'preferencia' ? 'is-active' : '' %>">
            <i class="ph ph-gear"></i> <%= t('config.menu.preferencia') %>
        </a>
        <a href="/configuracoes/perfil" class="settings-menu__item <%= menuAtivo === 'perfil' ? 'is-active' : '' %>">
            <i class="ph ph-user"></i> <%= t('config.menu.perfil') %>
        </a>
        <a href="/configuracoes/dados" class="settings-menu__item <%= menuAtivo === 'dados' ? 'is-active' : '' %>">
            <i class="ph ph-floppy-disk"></i> <%= t('config.menu.dados') %>
            <% if (!pode('rec_backup')) { %><%- include('../partials/selo_plano', { plano: 'pro' }) %><% } %>
        </a>
        <% } %>
        <a href="/assinatura" class="settings-menu__item <%= menuAtivo === 'assinatura' ? 'is-active' : '' %>">
            <i class="ph ph-crown-simple"></i> <%= t('config.menu.assinatura') %>
        </a>
        <% if (!acessoBloqueado) { %>
        <a href="/configuracoes/lembretes" class="settings-menu__item <%= menuAtivo === 'lembretes' ? 'is-active' : '' %>">
            <i class="ph ph-bell-ringing"></i> <%= t('config.menu.lembretes') %>
        </a>
        <a href="/guia" class="settings-menu__item">
            <i class="ph ph-book-open"></i> <%= t('guia.titulo') %>
        </a>
        <a href="/configuracoes/dispositivos" class="settings-menu__item <%= menuAtivo === 'dispositivos' ? 'is-active' : '' %>">
            <i class="ph ph-device-mobile"></i> <%= t('config.menu.dispositivos') %>
        </a>
        <% } %>
        <a href="/configuracoes/conta" class="settings-menu__item <%= menuAtivo === 'conta' ? 'is-active' : '' %>">
            <i class="ph ph-identification-card"></i> <%= t('config.menu.conta') %>
        </a>
    </div>
    <form method="post" action="/logout" class="settings-menu__sair">
        <%- csrfCampo %>
        <button type="submit"><i class="ph ph-sign-out"></i> <%= t('nav.sair') %></button>
    </form>
</nav>
